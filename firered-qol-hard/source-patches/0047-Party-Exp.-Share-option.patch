@@ -30,6 +30,33 @@ ViridianCity_PokemonCenter_1F_EventScript_Youngster::
 ViridianCity_PokemonCenter_1F_EventScript_LevelCap::
 	lock
 	faceplayer
+	message Hack_Text_SettingsWhich
+	waitmessage
+	multichoice 18, 6, MULTICHOICE_HACK_SETTINGS, FALSE
+	switch VAR_RESULT
+	case 0, ViridianCity_PokemonCenter_1F_EventScript_LevelCapMenu
+	case 1, ViridianCity_PokemonCenter_1F_EventScript_ExpShare
+	goto ViridianCity_PokemonCenter_1F_EventScript_LevelCapDone
+	end
+
+ViridianCity_PokemonCenter_1F_EventScript_ExpShare::
+	goto_if_set FLAG_HACK_PARTY_EXP_SHARE, ViridianCity_PokemonCenter_1F_EventScript_ExpShareIsOn
+	msgbox Hack_Text_ExpShareOffer, MSGBOX_YESNO
+	goto_if_eq VAR_RESULT, NO, ViridianCity_PokemonCenter_1F_EventScript_LevelCapDone
+	setflag FLAG_HACK_PARTY_EXP_SHARE
+	msgbox Hack_Text_ExpShareNowOn
+	release
+	end
+
+ViridianCity_PokemonCenter_1F_EventScript_ExpShareIsOn::
+	msgbox Hack_Text_ExpShareIsOn, MSGBOX_YESNO
+	goto_if_eq VAR_RESULT, NO, ViridianCity_PokemonCenter_1F_EventScript_LevelCapDone
+	clearflag FLAG_HACK_PARTY_EXP_SHARE
+	msgbox Hack_Text_ExpShareNowOff
+	release
+	end
+
+ViridianCity_PokemonCenter_1F_EventScript_LevelCapMenu::
 	goto_if_set FLAG_SYS_GAME_CLEAR, ViridianCity_PokemonCenter_1F_EventScript_LevelCapChampion
 	goto_if_set FLAG_HACK_LEVEL_CAP, ViridianCity_PokemonCenter_1F_EventScript_LevelCapIsOn
 	msgbox Hack_Text_LevelCapOffer, MSGBOX_YESNO
