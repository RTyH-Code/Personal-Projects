+def revision1(text):
+    """Keep the Rev 1 (v1.1) side of `#if REVISION == 0` blocks."""
+    out, stack = [], []
+    for line in text.split("\n"):
+        st = line.strip()
+        if re.match(r"#if REVISION == 0\b", st):
+            stack.append(False)
+            continue
+        if st == "#else" and stack:
+            stack[-1] = not stack[-1]
+            continue
+        if st == "#endif" and stack:
+            stack.pop()
+            continue
+        if all(stack):
+            out.append(line)
+    return "\n".join(out)
+
+
