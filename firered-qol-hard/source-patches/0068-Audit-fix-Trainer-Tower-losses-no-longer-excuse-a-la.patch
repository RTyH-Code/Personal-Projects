@@ -79,7 +79,11 @@ void Hack_NuzlockeBattleEnd(void)
     u8 i;
     u16 hp = 1;
 
-    sExhibitionLoss = Hack_ExhibitionBattle() && gBattleOutcome != B_OUTCOME_WON;
+    // Only a loss that whites out counts (peak trainers). A Trainer Tower loss
+    // sends you back to the lobby instead, so it must not linger and excuse a
+    // later field-poison white-out.
+    sExhibitionLoss = Hack_ExhibitionBattle() && gBattleOutcome != B_OUTCOME_WON
+                   && !(gBattleTypeFlags & BATTLE_TYPE_TRAINER_TOWER);
     if (!Hack_ExhibitionBattle())
     {
