+
+// Options > Battle speed. FAST (the default) drains HP and fills Exp. bars
+// faster and halves the pauses after battle messages.
+bool8 Hack_FastBattles(void)
+{
+    return !FlagGet(FLAG_HACK_NORMAL_BATTLE_SPEED) && !(gBattleTypeFlags & BATTLE_TYPE_LINK);
+}
+
+// ---------------------------------------------------------------------------
+// Start menu > NUZLOCKE: each used area, what was caught there and its status.
+
+enum { NZ_PARTY, NZ_PC, NZ_LOST, NZ_MISSED };
+
+#define NZ_MAX_ROWS   128
+#define NZ_PAGE_ROWS  7
+
+struct NuzlockeRow
+{
+    u8 sec;
+    u8 status;
+    u16 species;
+};
+
+EWRAM_DATA static struct NuzlockeRow sNzRows[NZ_MAX_ROWS] = {0};
+EWRAM_DATA static u8 sNzCount = 0;
+
+static const u8 sText_NzTitle[]  = _("NUZLOCKE RUN");
+static const u8 sText_NzParty[]  = _("PARTY");
+static const u8 sText_NzPC[]     = _("PC");
+static const u8 sText_NzLost[]   = _("FAINTED");
+static const u8 sText_NzMissed[] = _("MISSED");
+static const u8 sText_NzNone[]   = _("No encounters yet.");
+static const u8 sText_NzTally[]  = _("{STR_VAR_1} alive · {STR_VAR_2} fainted");
+static const u8 sText_NzUp[]     = _("{UP_ARROW}");
+static const u8 sText_NzDown[]   = _("{DOWN_ARROW}");
+static const u8 *const sNzStatus[] = {sText_NzParty, sText_NzPC, sText_NzLost, sText_NzMissed};
+
+static const struct WindowTemplate sNzWindow = {
+    .bg = 0, .tilemapLeft = 2, .tilemapTop = 1, .width = 26, .height = 16, .paletteNum = 15, .baseBlock = 0x008,
+};
+
+static u32 PlayerOtId(void)
+{
+    return gSaveBlock2Ptr->playerTrainerId[0] | (gSaveBlock2Ptr->playerTrainerId[1] << 8)
+         | (gSaveBlock2Ptr->playerTrainerId[2] << 16) | (gSaveBlock2Ptr->playerTrainerId[3] << 24);
+}
+
+static void NzConsider(struct BoxPokemon *boxMon, u8 status)
+{
+    u8 i, sec;
+
+    if (!GetBoxMonData(boxMon, MON_DATA_SANITY_HAS_SPECIES) || GetBoxMonData(boxMon, MON_DATA_IS_EGG))
+        return;
+    if (GetBoxMonData(boxMon, MON_DATA_OT_ID) != PlayerOtId())
+        return;
+    sec = GetBoxMonData(boxMon, MON_DATA_MET_LOCATION);
+    if (GetBoxMonData(boxMon, MON_DATA_UNUSED_RIBBONS) & DEAD_BIT)
+        status = NZ_LOST;
+    for (i = 0; i < sNzCount; i++)
+    {
+        if (sNzRows[i].sec == sec && sNzRows[i].status == NZ_MISSED)
+        {
+            sNzRows[i].status = status;
+            sNzRows[i].species = GetBoxMonData(boxMon, MON_DATA_SPECIES);
+            return;
+        }
+    }
+}
+
+static void NzBuildRows(void)
+{
+    u8 i, j;
+
+    sNzCount = 0;
+    for (i = 0; i < sizeof(gSaveBlock1Ptr->hackNuzlockeAreas) * 8 && KANTO_MAPSEC_START + i < MAPSEC_NONE; i++)
+    {
+        if (gSaveBlock1Ptr->hackNuzlockeAreas[i / 8] & (1 << (i % 8)))
+        {
+            sNzRows[sNzCount].sec = KANTO_MAPSEC_START + i;
+            sNzRows[sNzCount].status = NZ_MISSED;
+            sNzRows[sNzCount].species = SPECIES_NONE;
+            sNzCount++;
+        }
+    }
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        u8 status = NZ_PARTY;
+        if (GetMonData(&gPlayerParty[i], MON_DATA_SPECIES) && GetMonData(&gPlayerParty[i], MON_DATA_HP) == 0)
+            status = NZ_LOST;
+        NzConsider(&gPlayerParty[i].box, status);
+    }
+    for (i = 0; i < TOTAL_BOXES_COUNT; i++)
+        for (j = 0; j < IN_BOX_COUNT; j++)
+            NzConsider(GetBoxedMonPtr(i, j), NZ_PC);
+}
+
+#define tTop data[0]
+#define tWin data[1]
+
+static void NzDraw(u8 taskId)
+{
+    s16 *data = gTasks[taskId].data;
+    u8 i, alive = 0, lost = 0, y;
+    u8 buf[32];
+
+    FillWindowPixelBuffer(tWin, PIXEL_FILL(1));
+    for (i = 0; i < sNzCount; i++)
+    {
+        if (sNzRows[i].status == NZ_PARTY || sNzRows[i].status == NZ_PC)
+            alive++;
+        else if (sNzRows[i].status == NZ_LOST)
+            lost++;
+    }
+    AddTextPrinterParameterized(tWin, FONT_NORMAL, sText_NzTitle, 4, 1, TEXT_SKIP_DRAW, NULL);
+    ConvertIntToDecimalStringN(gStringVar1, alive, STR_CONV_MODE_LEFT_ALIGN, 3);
+    ConvertIntToDecimalStringN(gStringVar2, lost, STR_CONV_MODE_LEFT_ALIGN, 3);
+    StringExpandPlaceholders(gStringVar4, sText_NzTally);
+    AddTextPrinterParameterized(tWin, FONT_SMALL, gStringVar4, 204 - GetStringWidth(FONT_SMALL, gStringVar4, 0), 3, TEXT_SKIP_DRAW, NULL);
+    if (sNzCount == 0)
+        AddTextPrinterParameterized(tWin, FONT_NORMAL, sText_NzNone, 4, 20, TEXT_SKIP_DRAW, NULL);
+    for (i = 0; i < NZ_PAGE_ROWS && tTop + i < sNzCount; i++)
+    {
+        const struct NuzlockeRow *row = &sNzRows[tTop + i];
+        y = 20 + i * 15;
+        GetMapNameGeneric(buf, row->sec);
+        AddTextPrinterParameterized(tWin, FONT_NORMAL, buf, 4, y, TEXT_SKIP_DRAW, NULL);
+        if (row->species)
+            AddTextPrinterParameterized(tWin, FONT_NORMAL, gSpeciesNames[row->species], 104, y, TEXT_SKIP_DRAW, NULL);
+        AddTextPrinterParameterized(tWin, FONT_SMALL, sNzStatus[row->status], 168, y + 2, TEXT_SKIP_DRAW, NULL);
+    }
+    if (tTop > 0)
+        AddTextPrinterParameterized(tWin, FONT_SMALL, sText_NzUp, 196, 14, TEXT_SKIP_DRAW, NULL);
+    if (tTop + NZ_PAGE_ROWS < sNzCount)
+        AddTextPrinterParameterized(tWin, FONT_SMALL, sText_NzDown, 196, 118, TEXT_SKIP_DRAW, NULL);
+    CopyWindowToVram(tWin, COPYWIN_FULL);
+}
+
+static void Task_NuzlockeTracker(u8 taskId)
+{
+    s16 *data = gTasks[taskId].data;
+
+    if (JOY_REPT(DPAD_UP) && tTop > 0)
+    {
+        PlaySE(SE_SELECT);
+        tTop--;
+        NzDraw(taskId);
+    }
+    else if (JOY_REPT(DPAD_DOWN) && tTop + NZ_PAGE_ROWS < sNzCount)
+    {
+        PlaySE(SE_SELECT);
+        tTop++;
+        NzDraw(taskId);
+    }
+    else if (JOY_NEW(A_BUTTON | B_BUTTON))
+    {
+        PlaySE(SE_SELECT);
+        ClearStdWindowAndFrame(tWin, TRUE);
+        RemoveWindow(tWin);
+        DestroyTask(taskId);
+        ScriptContext_Enable();
+    }
+}
+
+void Hack_NuzlockeTracker(void)
+{
+    u8 taskId = CreateTask(Task_NuzlockeTracker, 80);
+    s16 *data = gTasks[taskId].data;
+
+    NzBuildRows();
+    tTop = 0;
+    tWin = AddWindow(&sNzWindow);
+    DrawStdWindowFrame(tWin, FALSE);
+    NzDraw(taskId);
+}
