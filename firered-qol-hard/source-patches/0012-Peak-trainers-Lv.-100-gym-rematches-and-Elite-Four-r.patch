+        ".partyFlags = F_TRAINER_PARTY_CUSTOM_MOVESET | F_TRAINER_PARTY_HELD_ITEM | F_TRAINER_PARTY_PEAK\n"
+        "#define ITEM_CUSTOM_MOVES(party)")
+    sub("include/constants/flags.h", "#define FLAG_HACK_LEGENDS_RELEASED",
