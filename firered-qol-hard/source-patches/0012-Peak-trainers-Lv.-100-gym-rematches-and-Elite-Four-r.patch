+// FireRed QoL+Hard: peak trainers' Pokemon have max IVs, a nature that boosts
+// the side (physical/special) their moves use, and 252/252 EVs.
+static void CreatePeakTrainerMon(struct Pokemon *mon, u16 species, u8 level, const u16 *moves)
+{
+    s32 physical = 0, special = 0;
+    bool8 usePhysical, speedNature, speedEvs;
+    u8 i, nature;
+    u8 full = MAX_PER_STAT_EVS < 252 ? MAX_PER_STAT_EVS : 252;
+    u8 rest = 6;
+
+    for (i = 0; i < MAX_MON_MOVES; i++)
+    {
+        if (gBattleMoves[moves[i]].power == 0)
+            continue;
+        if (gBattleMoves[moves[i]].split == SPLIT_PHYSICAL)
+            physical++;
+        else if (gBattleMoves[moves[i]].split == SPLIT_SPECIAL)
+            special++;
+    }
+    if (physical != special)
+        usePhysical = (physical > special);
+    else
+        usePhysical = (gSpeciesInfo[species].baseAttack >= gSpeciesInfo[species].baseSpAttack);
+    speedNature = (gSpeciesInfo[species].baseSpeed >= 80);
+    speedEvs = (gSpeciesInfo[species].baseSpeed >= 50);
+
+    if (usePhysical)
+        nature = speedNature ? NATURE_JOLLY : NATURE_ADAMANT;
+    else
+        nature = speedNature ? NATURE_TIMID : NATURE_MODEST;
+
+    CreateMonWithNature(mon, species, level, MAX_PER_STAT_IVS, nature);
+    SetMonData(mon, usePhysical ? MON_DATA_ATK_EV : MON_DATA_SPATK_EV, &full);
+    if (speedEvs)
+    {
+        SetMonData(mon, MON_DATA_SPEED_EV, &full);
+        SetMonData(mon, MON_DATA_HP_EV, &rest);
+    }
+    else
+    {
+        SetMonData(mon, MON_DATA_HP_EV, &full);
+        SetMonData(mon, usePhysical ? MON_DATA_DEF_EV : MON_DATA_SPDEF_EV, &rest);
+    }
+    CalculateMonStats(mon);
+}
