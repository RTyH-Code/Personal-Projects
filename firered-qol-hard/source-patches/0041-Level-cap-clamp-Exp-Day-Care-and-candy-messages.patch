diff --git a/src/pokemon.c b/src/pokemon.c
index 2356dff..fd3848c 100644
--- a/src/pokemon.c
+++ b/src/pokemon.c
@@ -7230,6 +7230,24 @@ u8 Hack_GetLevelCap(void)
 }
 
 // For the toggle NPC: VAR_RESULT = cap, STR_VAR_1 = cap as text.
+// Clamp an Exp gain so it can't carry a Pokemon past the level cap.
+// A Pokemon already over the cap (traded, caught, or deposited before
+// the cap applied) keeps its Exp but gains no more.
+u32 Hack_CapExpGain(u16 species, u32 exp, u32 gain)
+{
+    u8 cap = Hack_GetLevelCap();
+    u32 capExp;
+
+    if (cap >= MAX_LEVEL)
+        return gain;
+    capExp = gExperienceTables[gSpeciesInfo[species].growthRate][cap];
+    if (exp >= capExp)
+        return 0;
+    if (gain > capExp - exp)
+        return capExp - exp;
+    return gain;
+}
+
 void Hack_BufferLevelCap(void)
 {
     gSpecialVar_Result = Hack_GetLevelCap();
