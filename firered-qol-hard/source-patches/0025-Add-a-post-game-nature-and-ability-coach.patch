diff --git a/data/maps/IndigoPlateau_PokemonCenter_1F/scripts.inc b/data/maps/IndigoPlateau_PokemonCenter_1F/scripts.inc
index 15cb0cc..890e856 100644
--- a/data/maps/IndigoPlateau_PokemonCenter_1F/scripts.inc
+++ b/data/maps/IndigoPlateau_PokemonCenter_1F/scripts.inc
@@ -99,3 +99,100 @@ IndigoPlateau_PokemonCenter_1F_EventScript_PeakOfficialDone::
 	msgbox Hack_Text_PeakOfficialDone
 	release
 	end
+
+@ FireRed QoL+Hard: changes a Pokémon's nature or ability (after becoming Champion)
+IndigoPlateau_PokemonCenter_1F_EventScript_NatureCoach::
+	lock
+	faceplayer
+	goto_if_unset FLAG_SYS_GAME_CLEAR, IndigoPlateau_PokemonCenter_1F_EventScript_CoachNotChampion
+	msgbox Hack_Text_CoachIntro
+IndigoPlateau_PokemonCenter_1F_EventScript_CoachMenu::
+	message Hack_Text_CoachWhichService
+	waitmessage
+	multichoice 19, 6, MULTICHOICE_HACK_NATURE_ABILITY, FALSE
+	switch VAR_RESULT
+	case 0, IndigoPlateau_PokemonCenter_1F_EventScript_CoachNature
+	case 1, IndigoPlateau_PokemonCenter_1F_EventScript_CoachAbility
+	goto IndigoPlateau_PokemonCenter_1F_EventScript_CoachDone
+	end
+
+@ VAR_0x8007: 0 = chosen, 1 = cancelled, 2 = egg
+IndigoPlateau_PokemonCenter_1F_EventScript_CoachChooseMon::
+	setvar VAR_0x8007, 1
+	special ChoosePartyMon
+	waitstate
+	goto_if_ge VAR_0x8004, PARTY_SIZE, IndigoPlateau_PokemonCenter_1F_EventScript_CoachChosen
+	setvar VAR_0x8007, 2
+	special IsSelectedMonEgg
+	goto_if_eq VAR_RESULT, TRUE, IndigoPlateau_PokemonCenter_1F_EventScript_CoachChosen
+	setvar VAR_0x8007, 0
+	special Hack_BufferNatureAndAbility
+IndigoPlateau_PokemonCenter_1F_EventScript_CoachChosen::
+	return
+
+IndigoPlateau_PokemonCenter_1F_EventScript_CoachEgg::
+	msgbox Hack_Text_CoachEgg
+	goto IndigoPlateau_PokemonCenter_1F_EventScript_CoachMenu
+	end
+
+IndigoPlateau_PokemonCenter_1F_EventScript_CoachNature::
+	msgbox Hack_Text_CoachWhichMon
+	call IndigoPlateau_PokemonCenter_1F_EventScript_CoachChooseMon
+	goto_if_eq VAR_0x8007, 1, IndigoPlateau_PokemonCenter_1F_EventScript_CoachMenu
+	goto_if_eq VAR_0x8007, 2, IndigoPlateau_PokemonCenter_1F_EventScript_CoachEgg
+	message Hack_Text_CoachRaise
+	waitmessage
+	multichoice 20, 0, MULTICHOICE_HACK_RAISE_STAT, FALSE
+	goto_if_eq VAR_RESULT, SCR_MENU_CANCEL, IndigoPlateau_PokemonCenter_1F_EventScript_CoachMenu
+	copyvar VAR_0x8005, VAR_RESULT
+	setvar VAR_0x8006, 5
+	goto_if_eq VAR_0x8005, 5, IndigoPlateau_PokemonCenter_1F_EventScript_CoachApplyNature
+	message Hack_Text_CoachLower
+	waitmessage
+	multichoice 20, 0, MULTICHOICE_HACK_LOWER_STAT, FALSE
+	goto_if_eq VAR_RESULT, SCR_MENU_CANCEL, IndigoPlateau_PokemonCenter_1F_EventScript_CoachMenu
+	copyvar VAR_0x8006, VAR_RESULT
+IndigoPlateau_PokemonCenter_1F_EventScript_CoachApplyNature::
+	special Hack_SetNature
+	goto_if_eq VAR_RESULT, FALSE, IndigoPlateau_PokemonCenter_1F_EventScript_CoachSameNature
+	playfanfare MUS_LEVEL_UP
+	waitfanfare
+	msgbox Hack_Text_CoachNatureDone
+	goto IndigoPlateau_PokemonCenter_1F_EventScript_CoachDone
+	end
+
+IndigoPlateau_PokemonCenter_1F_EventScript_CoachSameNature::
+	msgbox Hack_Text_CoachSameNature
+	goto IndigoPlateau_PokemonCenter_1F_EventScript_CoachMenu
+	end
+
+IndigoPlateau_PokemonCenter_1F_EventScript_CoachAbility::
+	msgbox Hack_Text_CoachWhichMon
+	call IndigoPlateau_PokemonCenter_1F_EventScript_CoachChooseMon
+	goto_if_eq VAR_0x8007, 1, IndigoPlateau_PokemonCenter_1F_EventScript_CoachMenu
+	goto_if_eq VAR_0x8007, 2, IndigoPlateau_PokemonCenter_1F_EventScript_CoachEgg
+	special Hack_CanSwapAbility
+	goto_if_eq VAR_RESULT, FALSE, IndigoPlateau_PokemonCenter_1F_EventScript_CoachOneAbility
+	msgbox Hack_Text_CoachSwapAbility, MSGBOX_YESNO
+	goto_if_eq VAR_RESULT, NO, IndigoPlateau_PokemonCenter_1F_EventScript_CoachMenu
+	special Hack_SwapAbility
+	playfanfare MUS_LEVEL_UP
+	waitfanfare
+	msgbox Hack_Text_CoachAbilityDone
+	goto IndigoPlateau_PokemonCenter_1F_EventScript_CoachDone
+	end
+
+IndigoPlateau_PokemonCenter_1F_EventScript_CoachOneAbility::
+	msgbox Hack_Text_CoachOneAbility
+	goto IndigoPlateau_PokemonCenter_1F_EventScript_CoachMenu
+	end
+
+IndigoPlateau_PokemonCenter_1F_EventScript_CoachNotChampion::
+	msgbox Hack_Text_CoachNotChampion
+	release
+	end
+
+IndigoPlateau_PokemonCenter_1F_EventScript_CoachDone::
+	msgbox Hack_Text_CoachBye
+	release
+	end
