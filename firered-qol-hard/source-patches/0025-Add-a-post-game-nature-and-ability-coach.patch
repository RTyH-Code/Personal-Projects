+// ---------------------------------------------------------------------------
+// Nature and ability changer (post-game NPC, Indigo Plateau Pokémon Center).
+// The party slot is in VAR_0x8004.
+// ---------------------------------------------------------------------------
+// Nature = raised * 5 + lowered, with stats in the order Atk, Def, Spe, SpA, SpD.
+#define HACK_NATURE_STAT_NONE 5
+
+static void Hack_SetBoxMonPersonality(struct BoxPokemon *boxMon, u32 personality)
+{
+    union PokemonSubstruct subs[4];
+    u32 old = boxMon->personality;
+    u8 i;
+
+    DecryptBoxMon(boxMon);
+    for (i = 0; i < 4; i++)
+        subs[i] = *GetSubstruct(boxMon, old, i);
+    boxMon->personality = personality;
+    for (i = 0; i < 4; i++)
+        *GetSubstruct(boxMon, personality, i) = subs[i];
+    boxMon->checksum = CalculateBoxMonChecksum(boxMon);
+    EncryptBoxMon(boxMon);
+}
+
+// A personality with the wanted nature that keeps everything else the
+// personality decides: gender, shininess (pHi ^ pLo is unchanged), Unown's
+// letter and Wurmple's evolution.
+static u32 Hack_PersonalityWithNature(u16 species, u32 old, u8 nature)
+{
+    u16 shinyBits = (old >> 16) ^ (old & 0xFFFF);
+    u16 start = Random();
+    u8 gender = GetGenderFromSpeciesAndPersonality(species, old);
+    u32 n, p;
+    u16 lo;
+
+    for (n = 0; n < 0x10000; n++)
+    {
+        lo = start + n;
+        p = ((u32)(shinyBits ^ lo) << 16) | lo;
+        if (p % NUM_NATURES != nature)
+            continue;
+        if (GetGenderFromSpeciesAndPersonality(species, p) != gender)
+            continue;
+        if (species == SPECIES_UNOWN && GetUnownLetterByPersonality(p) != GetUnownLetterByPersonality(old))
+            continue;
+        if (species == SPECIES_WURMPLE && ((p >> 16) % 10 <= 4) != ((old >> 16) % 10 <= 4))
+            continue;
+        return p;
+    }
+    return old;
+}
+
+static void Hack_BufferAbilityName(u8 *dest, u16 species, u8 abilityNum)
+{
+    StringCopy(dest, gAbilityNames[GetAbilityBySpecies(species, abilityNum)]);
+}
+
+// STR_VAR_1 = nickname, STR_VAR_2 = nature, STR_VAR_3 = ability.
+void Hack_BufferNatureAndAbility(void)
+{
+    struct Pokemon *mon = &gPlayerParty[gSpecialVar_0x8004];
+    u16 species = GetMonData(mon, MON_DATA_SPECIES, NULL);
+
+    GetMonData(mon, MON_DATA_NICKNAME, gStringVar1);
+    StringGet_Nickname(gStringVar1);
+    StringCopy(gStringVar2, gNatureNamePointers[GetNature(mon)]);
+    Hack_BufferAbilityName(gStringVar3, species, GetMonData(mon, MON_DATA_ABILITY_NUM, NULL));
+}
+
+// VAR_0x8005 = stat to raise, VAR_0x8006 = stat to lower (5 = none).
+// VAR_RESULT = FALSE if it already has that nature. STR_VAR_2 = new nature.
+void Hack_SetNature(void)
+{
+    struct Pokemon *mon = &gPlayerParty[gSpecialVar_0x8004];
+    u16 species = GetMonData(mon, MON_DATA_SPECIES, NULL);
+    u32 personality = GetMonData(mon, MON_DATA_PERSONALITY, NULL);
+    u8 nature;
+
+    if (gSpecialVar_0x8005 >= HACK_NATURE_STAT_NONE || gSpecialVar_0x8006 >= HACK_NATURE_STAT_NONE
+     || gSpecialVar_0x8005 == gSpecialVar_0x8006)
+    {
+        // Neutral: keep the current nature if it's already neutral.
+        nature = GetNature(mon);
+        if (nature % 6 != 0)
+            nature = NATURE_SERIOUS;
+    }
+    else
+    {
+        nature = gSpecialVar_0x8005 * 5 + gSpecialVar_0x8006;
+    }
+    StringCopy(gStringVar2, gNatureNamePointers[nature]);
+    if (nature == GetNature(mon))
+    {
+        gSpecialVar_Result = FALSE;
+        return;
+    }
+    Hack_SetBoxMonPersonality(&mon->box, Hack_PersonalityWithNature(species, personality, nature));
+    CalculateMonStats(mon);
+    gSpecialVar_Result = (GetNature(mon) == nature);
+}
+
+// VAR_RESULT = TRUE if the species has a second, different ability.
+// STR_VAR_3 = the ability it would switch to.
+void Hack_CanSwapAbility(void)
+{
+    struct Pokemon *mon = &gPlayerParty[gSpecialVar_0x8004];
+    u16 species = GetMonData(mon, MON_DATA_SPECIES, NULL);
+    u8 num = GetMonData(mon, MON_DATA_ABILITY_NUM, NULL);
+
+    gSpecialVar_Result = gSpeciesInfo[species].abilities[1] != ABILITY_NONE
+                      && gSpeciesInfo[species].abilities[1] != gSpeciesInfo[species].abilities[0];
+    Hack_BufferAbilityName(gStringVar3, species, num ^ 1);
+}
+
+void Hack_SwapAbility(void)
+{
+    struct Pokemon *mon = &gPlayerParty[gSpecialVar_0x8004];
+    u8 num = GetMonData(mon, MON_DATA_ABILITY_NUM, NULL) ^ 1;
+
+    SetMonData(mon, MON_DATA_ABILITY_NUM, &num);
+}
