+// FireRed QoL+Hard: a prize for every full clear (not just the first), drawn
+// from the challenge's own prize, PP Up / PP Max, and items that sell well.
+static u16 Hack_TowerPrize(u16 challengePrize)
+{
+    u16 roll = Random() % 100;
+
+    if (roll < 25)
+        return challengePrize;
+    if (roll < 45)
+        return ITEM_PP_UP;
+    if (roll < 55)
+        return ITEM_PP_MAX;
+    if (roll < 75)
+        return ITEM_NUGGET;
+    if (roll < 90)
+        return ITEM_BIG_PEARL;
+    return ITEM_STAR_PIECE;
+}
+
 static void GiveChallengePrize(void)
 {
-    u16 itemId = sPrizeList[sTrainerTowerState->data.floors->prize];
+    u16 itemId = Hack_TowerPrize(sPrizeList[sTrainerTowerState->data.floors->prize]);
 
     if (TRAINER_TOWER.receivedPrize)
     {
@@ -988,7 +1067,7 @@ static void HasSpokenToOwner(void)
 static void BuildEnemyParty(void)
 {
     u16 trainerIdx = VarGet(VAR_TEMP_1);
-    s32 level = GetPartyMaxLevel();
+    s32 level = TOWER_LEVEL; // FireRed QoL+Hard: was GetPartyMaxLevel()
     u8 floorIdx = TRAINER_TOWER.floorsCleared;
     s32 i;
     u8 monIdx;
