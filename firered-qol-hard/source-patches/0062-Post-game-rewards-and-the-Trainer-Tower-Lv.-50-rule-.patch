+// FireRed QoL+Hard: Trainer Tower battles follow the Lv. 50 rule, like
+// official tournaments. Opponents are Lv. 50, and your Pokemon above Lv. 50
+// battle at Lv. 50 (stats recalculated); afterwards they go back to their real
+// level, keeping the battle's HP (as a share of max HP), PP, status and item.
+// Only each Pokemon's Exp. is saved (EWRAM is nearly full).
+#define TOWER_LEVEL 50
+static EWRAM_DATA u32 sTowerExpBackup[PARTY_SIZE] = {0};
+static EWRAM_DATA u32 sTowerPersonality[PARTY_SIZE] = {0};
+
+static void Hack_TowerScaleParty(void)
+{
+    s32 i;
+    u32 exp;
+
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        struct Pokemon *mon = &gPlayerParty[i];
+        sTowerPersonality[i] = 0;
+        sTowerExpBackup[i] = 0;
+        if (GetMonData(mon, MON_DATA_SPECIES) == SPECIES_NONE || GetMonData(mon, MON_DATA_IS_EGG)
+         || GetMonData(mon, MON_DATA_LEVEL) <= TOWER_LEVEL)
+            continue;
+        sTowerPersonality[i] = GetMonData(mon, MON_DATA_PERSONALITY);
+        sTowerExpBackup[i] = GetMonData(mon, MON_DATA_EXP);
+        exp = gExperienceTables[gSpeciesInfo[GetMonData(mon, MON_DATA_SPECIES)].growthRate][TOWER_LEVEL];
+        SetMonData(mon, MON_DATA_EXP, &exp);
+        CalculateMonStats(mon);
+    }
+}
+
+static void Hack_TowerRestoreParty(void)
+{
+    s32 i;
+
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        struct Pokemon *mon = &gPlayerParty[i];
+        u32 hp, maxHP;
+
+        if (sTowerExpBackup[i] == 0 || GetMonData(mon, MON_DATA_PERSONALITY) != sTowerPersonality[i])
+            continue;
+        hp = GetMonData(mon, MON_DATA_HP);
+        maxHP = GetMonData(mon, MON_DATA_MAX_HP);
+        SetMonData(mon, MON_DATA_EXP, &sTowerExpBackup[i]);
+        CalculateMonStats(mon);
+        if (hp != 0 && maxHP != 0)
+        {
+            hp = hp * GetMonData(mon, MON_DATA_MAX_HP) / maxHP;
+            if (hp == 0)
+                hp = 1;
+        }
+        SetMonData(mon, MON_DATA_HP, &hp);
+        sTowerExpBackup[i] = 0;
+    }
+}
+
 static void CB2_EndTrainerTowerBattle(void)
 {
+    Hack_TowerRestoreParty();
     SetMainCallback2(CB2_ReturnToFieldContinueScriptPlayMapMusic);
 }
 
