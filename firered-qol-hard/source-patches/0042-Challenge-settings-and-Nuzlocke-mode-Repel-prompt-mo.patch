diff --git a/src/hack_challenge.c b/src/hack_challenge.c
new file mode 100644
index 0000000..e7ff163
--- /dev/null
+++ b/src/hack_challenge.c
@@ -0,0 +1,275 @@
+// FireRed QoL+Hard: challenge settings (Nuzlocke mode and optional rules).
+#include "global.h"
+#include "battle.h"
+#include "event_data.h"
+#include "item.h"
+#include "main.h"
+#include "menu.h"
+#include "new_menu_helpers.h"
+#include "pokedex.h"
+#include "pokemon.h"
+#include "script.h"
+#include "sound.h"
+#include "string_util.h"
+#include "task.h"
+#include "text.h"
+#include "window.h"
+#include "hack_challenge.h"
+#include "constants/flags.h"
+#include "constants/region_map_sections.h"
+#include "constants/songs.h"
+
+#define DEAD_BIT 1 // stored in MON_DATA_UNUSED_RIBBONS
+
+extern const struct Evolution gEvolutionTable[][EVOS_PER_MON];
+
+EWRAM_DATA static bool8 sCatchable = TRUE;
+EWRAM_DATA bool8 gHackRandomEncounter = FALSE;
+
+bool8 Hack_NuzlockeActive(void)
+{
+    // The rules start once Oak hands over the Pokédex and Poké Balls.
+    return FlagGet(FLAG_HACK_NUZLOCKE) && FlagGet(FLAG_SYS_POKEDEX_GET);
+}
+
+static bool8 IsPlayerPartyMon(struct Pokemon *mon)
+{
+    return mon >= &gPlayerParty[0] && mon < &gPlayerParty[PARTY_SIZE];
+}
+
+bool8 Hack_NuzlockeBoxMonDead(struct BoxPokemon *boxMon)
+{
+    return Hack_NuzlockeActive() && (GetBoxMonData(boxMon, MON_DATA_UNUSED_RIBBONS) & DEAD_BIT);
+}
+
+// A Pokémon that has fainted can't be healed or revived by anything.
+bool8 Hack_NuzlockeMonDead(struct Pokemon *mon)
+{
+    if (!Hack_NuzlockeActive() || !IsPlayerPartyMon(mon))
+        return FALSE;
+    if (GetMonData(mon, MON_DATA_SPECIES) == SPECIES_NONE || GetMonData(mon, MON_DATA_IS_EGG))
+        return FALSE;
+    return (GetMonData(mon, MON_DATA_UNUSED_RIBBONS) & DEAD_BIT) || GetMonData(mon, MON_DATA_HP) == 0;
+}
+
+void Hack_NuzlockeMarkFainted(void)
+{
+    u8 i, bits;
+
+    if (!Hack_NuzlockeActive())
+        return;
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        struct Pokemon *mon = &gPlayerParty[i];
+        if (GetMonData(mon, MON_DATA_SPECIES) == SPECIES_NONE || GetMonData(mon, MON_DATA_IS_EGG))
+            continue;
+        if (GetMonData(mon, MON_DATA_HP) == 0)
+        {
+            bits = GetMonData(mon, MON_DATA_UNUSED_RIBBONS) | DEAD_BIT;
+            SetMonData(mon, MON_DATA_UNUSED_RIBBONS, &bits);
+        }
+    }
+}
+
+// Whiting out ends a Nuzlocke run: the rules are lifted so the game carries on normally.
+void Hack_NuzlockeWhiteOut(void)
+{
+    if (Hack_NuzlockeActive())
+    {
+        FlagClear(FLAG_HACK_NUZLOCKE);
+        FlagSet(FLAG_HACK_NUZLOCKE_OVER);
+    }
+}
+
+static bool8 FamilyCaught(u16 species)
+{
+    u16 stack[16], cur, i, j;
+    u8 depth, n = 0;
+    bool8 found;
+
+    // Walk back to the first stage.
+    for (depth = 0; depth < 4; depth++)
+    {
+        found = FALSE;
+        for (i = 1; i < NUM_SPECIES && !found; i++)
+        {
+            for (j = 0; j < EVOS_PER_MON; j++)
+            {
+                if (gEvolutionTable[i][j].method && gEvolutionTable[i][j].targetSpecies == species)
+                {
+                    species = i;
+                    found = TRUE;
+                    break;
+                }
+            }
+        }
+        if (!found)
+            break;
+    }
+    // Then check it and everything it evolves into.
+    stack[n++] = species;
+    while (n)
+    {
+        cur = stack[--n];
+        if (GetSetPokedexFlag(SpeciesToNationalPokedexNum(cur), FLAG_GET_CAUGHT))
+            return TRUE;
+        for (j = 0; j < EVOS_PER_MON; j++)
+        {
+            if (gEvolutionTable[cur][j].method && gEvolutionTable[cur][j].targetSpecies && n < ARRAY_COUNT(stack))
+                stack[n++] = gEvolutionTable[cur][j].targetSpecies;
+        }
+    }
+    return FALSE;
+}
+
+// Called as a battle starts: decides whether this wild Pokémon can be caught.
+void Hack_NuzlockeOnBattleStart(void)
+{
+    u8 sec;
+    bool8 random = gHackRandomEncounter;
+
+    gHackRandomEncounter = FALSE;
+    sCatchable = TRUE;
+    if (!Hack_NuzlockeActive() || !random
+     || (gBattleTypeFlags & (BATTLE_TYPE_TRAINER | BATTLE_TYPE_LINK | BATTLE_TYPE_POKEDUDE | BATTLE_TYPE_OLD_MAN_TUTORIAL | BATTLE_TYPE_GHOST)))
+        return; // one-time encounters (Snorlax, legendaries, ...) are always catchable
+    if (IsMonShiny(&gEnemyParty[0]))
+        return; // shiny clause
+    if (FamilyCaught(GetMonData(&gEnemyParty[0], MON_DATA_SPECIES)))
+    {
+        sCatchable = FALSE; // dupes clause: doesn't use up the area
+        return;
+    }
+    if (gMapHeader.regionMapSectionId < KANTO_MAPSEC_START)
+        return;
+    sec = gMapHeader.regionMapSectionId - KANTO_MAPSEC_START;
+    if (sec >= sizeof(gSaveBlock1Ptr->hackNuzlockeAreas) * 8)
+        return;
+    if (gSaveBlock1Ptr->hackNuzlockeAreas[sec / 8] & (1 << (sec % 8)))
+        sCatchable = FALSE;
+    else
+        gSaveBlock1Ptr->hackNuzlockeAreas[sec / 8] |= 1 << (sec % 8);
+}
+
+bool8 Hack_NuzlockeCanCatch(void)
+{
+    return !Hack_NuzlockeActive() || sCatchable;
+}
+
+bool8 Hack_NoBattleItems(void)
+{
+    return FlagGet(FLAG_HACK_NO_BATTLE_ITEMS) && !(gBattleTypeFlags & (BATTLE_TYPE_POKEDUDE | BATTLE_TYPE_OLD_MAN_TUTORIAL));
+}
+
+// ---------------------------------------------------------------------------
+// Challenge settings menu, shown the first time you wake up in your room.
+
+#define ROW_DONE 4
+
+static const u8 sText_Nuzlocke[]  = _("NUZLOCKE MODE");
+static const u8 sText_LevelCaps[] = _("LEVEL CAPS");
+static const u8 sText_NoItems[]   = _("NO ITEMS IN BATTLE");
+static const u8 sText_SetOnly[]   = _("SET BATTLE STYLE");
+static const u8 sText_Done[]      = _("START ADVENTURE");
+static const u8 sText_On[]        = _("ON");
+static const u8 sText_Off[]       = _("OFF");
+static const u8 sText_Cursor[]    = _("▶");
+
+static const u8 sDesc_Nuzlocke[]  = _("Only the first POKéMON in each area\ncan be caught. Fainted ones are lost.");
+static const u8 sDesc_LevelCaps[] = _("Your POKéMON can't out-level the next\nGYM LEADER's strongest POKéMON.");
+static const u8 sDesc_NoItems[]   = _("No items from the BAG in battle.\nPOKé BALLS can still be thrown.");
+static const u8 sDesc_SetOnly[]   = _("No free switch after you knock out\na foe. Locks the battle style option.");
+static const u8 sDesc_Done[]      = _("Start with these rules. Only LEVEL\nCAPS can be changed later on.");
+
+static const u8 *const sRowNames[] = {sText_Nuzlocke, sText_LevelCaps, sText_NoItems, sText_SetOnly, sText_Done};
+static const u8 *const sRowDescs[] = {sDesc_Nuzlocke, sDesc_LevelCaps, sDesc_NoItems, sDesc_SetOnly, sDesc_Done};
+static const u16 sRowFlags[] = {FLAG_HACK_NUZLOCKE, FLAG_HACK_LEVEL_CAP, FLAG_HACK_NO_BATTLE_ITEMS, FLAG_HACK_SET_ONLY};
+
+static const struct WindowTemplate sMenuWindow = {
+    .bg = 0, .tilemapLeft = 2, .tilemapTop = 1, .width = 26, .height = 10, .paletteNum = 15, .baseBlock = 0x008,
+};
+static const struct WindowTemplate sDescWindow = {
+    .bg = 0, .tilemapLeft = 2, .tilemapTop = 15, .width = 26, .height = 4, .paletteNum = 15, .baseBlock = 0x198,
+};
+
+#define tCursor  data[0]
+#define tMenuWin data[1]
+#define tDescWin data[2]
+
+static void DrawChallengeMenu(u8 taskId)
+{
+    s16 *data = gTasks[taskId].data;
+    u8 i;
+
+    FillWindowPixelBuffer(tMenuWin, PIXEL_FILL(1));
+    for (i = 0; i <= ROW_DONE; i++)
+    {
+        if (i == tCursor)
+            AddTextPrinterParameterized(tMenuWin, FONT_NORMAL, sText_Cursor, 4, i * 16 + 1, TEXT_SKIP_DRAW, NULL);
+        AddTextPrinterParameterized(tMenuWin, FONT_NORMAL, sRowNames[i], 16, i * 16 + 1, TEXT_SKIP_DRAW, NULL);
+        if (i < ROW_DONE)
+            AddTextPrinterParameterized(tMenuWin, FONT_NORMAL, FlagGet(sRowFlags[i]) ? sText_On : sText_Off, 168, i * 16 + 1, TEXT_SKIP_DRAW, NULL);
+    }
+    CopyWindowToVram(tMenuWin, COPYWIN_FULL);
+    FillWindowPixelBuffer(tDescWin, PIXEL_FILL(1));
+    AddTextPrinterParameterized(tDescWin, FONT_NORMAL, sRowDescs[tCursor], 0, 1, TEXT_SKIP_DRAW, NULL);
+    CopyWindowToVram(tDescWin, COPYWIN_FULL);
+}
+
+static void Task_ChallengeMenu(u8 taskId)
+{
+    s16 *data = gTasks[taskId].data;
+
+    if (JOY_NEW(DPAD_UP))
+    {
+        PlaySE(SE_SELECT);
+        tCursor = tCursor == 0 ? ROW_DONE : tCursor - 1;
+        DrawChallengeMenu(taskId);
+    }
+    else if (JOY_NEW(DPAD_DOWN))
+    {
+        PlaySE(SE_SELECT);
+        tCursor = tCursor == ROW_DONE ? 0 : tCursor + 1;
+        DrawChallengeMenu(taskId);
+    }
+    else if (JOY_NEW(B_BUTTON) && tCursor != ROW_DONE)
+    {
+        PlaySE(SE_SELECT);
+        tCursor = ROW_DONE;
+        DrawChallengeMenu(taskId);
+    }
+    else if (tCursor < ROW_DONE && JOY_NEW(A_BUTTON | DPAD_LEFT | DPAD_RIGHT))
+    {
+        PlaySE(SE_SELECT);
+        if (FlagGet(sRowFlags[tCursor]))
+            FlagClear(sRowFlags[tCursor]);
+        else
+            FlagSet(sRowFlags[tCursor]);
+        DrawChallengeMenu(taskId);
+    }
+    else if (tCursor == ROW_DONE && JOY_NEW(A_BUTTON))
+    {
+        PlaySE(SE_SELECT);
+        ClearStdWindowAndFrame(tMenuWin, TRUE);
+        ClearStdWindowAndFrame(tDescWin, TRUE);
+        RemoveWindow(tMenuWin);
+        RemoveWindow(tDescWin);
+        if (FlagGet(FLAG_HACK_SET_ONLY))
+            gSaveBlock2Ptr->optionsBattleStyle = OPTIONS_BATTLE_STYLE_SET;
+        DestroyTask(taskId);
+        ScriptContext_Enable();
+    }
+}
+
+void Hack_ChallengeMenu(void)
+{
+    u8 taskId = CreateTask(Task_ChallengeMenu, 80);
+    s16 *data = gTasks[taskId].data;
+
+    tCursor = 0;
+    tMenuWin = AddWindow(&sMenuWindow);
+    tDescWin = AddWindow(&sDescWindow);
+    DrawStdWindowFrame(tMenuWin, FALSE);
+    DrawStdWindowFrame(tDescWin, FALSE);
+    DrawChallengeMenu(taskId);
+}
