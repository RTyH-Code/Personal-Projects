@@ -254,3 +255,12 @@ PokemonLeague_ChampionsRoom_EventScript_HackPeakCharmander::
 	cleartrainerflag TRAINER_PEAK_CHAMPION_CHARMANDER
 	trainerbattle_no_intro TRAINER_PEAK_CHAMPION_CHARMANDER, PokemonLeague_ChampionsRoom_Text_Defeat
 	return
+
+@ FireRed QoL+Hard: beating the round 2 (or peak) Champion unlocks the true endgame
+PokemonLeague_ChampionsRoom_EventScript_HackGiveSpecialCandy::
+	goto_if_set FLAG_HACK_TRUE_ENDGAME, EventScript_Return
+	msgbox Hack_Text_SpecialCandyGift
+	giveitem ITEM_SPECIAL_CANDY
+	setflag FLAG_HACK_TRUE_ENDGAME
+	msgbox Hack_Text_SpecialCandyExplain
+	return
