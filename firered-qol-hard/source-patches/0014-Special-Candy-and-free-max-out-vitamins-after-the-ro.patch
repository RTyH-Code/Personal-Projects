diff --git a/src/item.c b/src/item.c
index 0587adf..a3d888a 100644
--- a/src/item.c
+++ b/src/item.c
@@ -620,6 +620,19 @@ u16 ItemId_GetId(u16 itemId)
 
 u16 ItemId_GetPrice(u16 itemId)
 {
+    // FireRed QoL+Hard: vitamins are free once you reach the true endgame
+    switch (itemId)
+    {
+    case ITEM_HP_UP:
+    case ITEM_PROTEIN:
+    case ITEM_IRON:
+    case ITEM_CARBOS:
+    case ITEM_CALCIUM:
+    case ITEM_ZINC:
+        if (Hack_IsTrueEndgame())
+            return 0;
+        break;
+    }
     return gItems[SanitizeItemId(itemId)].price;
 }
 
