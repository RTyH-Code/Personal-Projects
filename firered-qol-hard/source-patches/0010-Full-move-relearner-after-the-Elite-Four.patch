+// ---------------------------------------------------------------------------
+// Full move relearner (after the Elite Four): level-up moves at any level,
+// egg moves of the family's base form, TMs/HMs and move tutors.
+// ---------------------------------------------------------------------------
+extern const u16 gEggMoves[];
+#define HACK_EGG_MOVES_SPECIES_OFFSET 20000
+#define HACK_EGG_MOVES_TERMINATOR 0xFFFF
+
+static u16 GetFamilyBaseSpecies(u16 species)
+{
+    u16 s;
+    u8 i, depth;
+    bool8 found = TRUE;
+
+    for (depth = 0; depth < 3 && found; depth++)
+    {
+        found = FALSE;
+        for (s = 1; s < NUM_SPECIES && !found; s++)
+        {
+            for (i = 0; i < EVOS_PER_MON; i++)
+            {
+                if (gEvolutionTable[s][i].method != 0 && gEvolutionTable[s][i].targetSpecies == species)
+                {
+                    species = s;
+                    found = TRUE;
+                    break;
+                }
+            }
+        }
+    }
+    return species;
+}
+
+static u8 AddRelearnerMove(u16 *moves, u8 count, const u16 *known, u16 move)
+{
+    u8 i;
+
+    if (move == MOVE_NONE || count >= MAX_RELEARNER_MOVES)
+        return count;
+    for (i = 0; i < MAX_MON_MOVES; i++)
+        if (known[i] == move)
+            return count;
+    for (i = 0; i < count; i++)
+        if (moves[i] == move)
+            return count;
+    moves[count] = move;
+    return count + 1;
+}
+
+static u8 GetFullRelearnerMoves(struct Pokemon *mon, u16 *moves)
+{
+    u16 known[MAX_MON_MOVES];
+    u16 species = GetMonData(mon, MON_DATA_SPECIES, NULL);
+    u16 base, i, j;
+    u8 count = 0;
+
+    for (i = 0; i < MAX_MON_MOVES; i++)
+        known[i] = GetMonData(mon, MON_DATA_MOVE1 + i, NULL);
+
+    for (i = 0; i < MAX_LEVEL_UP_MOVES && gLevelUpLearnsets[species][i] != LEVEL_UP_END; i++)
+        count = AddRelearnerMove(moves, count, known, gLevelUpLearnsets[species][i] & LEVEL_UP_MOVE_ID);
+
+    base = GetFamilyBaseSpecies(species);
+    for (i = 0; gEggMoves[i] != HACK_EGG_MOVES_TERMINATOR; i++)
+    {
+        if (gEggMoves[i] == base + HACK_EGG_MOVES_SPECIES_OFFSET)
+        {
+            for (j = i + 1; gEggMoves[j] != HACK_EGG_MOVES_TERMINATOR && gEggMoves[j] < HACK_EGG_MOVES_SPECIES_OFFSET; j++)
+                count = AddRelearnerMove(moves, count, known, gEggMoves[j]);
+            break;
+        }
+    }
+
+    for (i = 0; i < NUM_TECHNICAL_MACHINES + NUM_HIDDEN_MACHINES; i++)
+        if (CanMonLearnTMHM(mon, i))
+            count = AddRelearnerMove(moves, count, known, ItemIdToBattleMoveId(ITEM_TM01 + i));
+
+    for (i = 0; i <= TUTOR_MOVE_HYDRO_CANNON; i++)
+        if (Hack_CanLearnTutorMove(species, i))
+            count = AddRelearnerMove(moves, count, known, Hack_GetTutorMove(i));
+
+    return count;
+}
+
 u8 GetMoveRelearnerMoves(struct Pokemon *mon, u16 *moves)
 {
     u16 learnedMoves[MAX_MON_MOVES];
@@ -5749,6 +5834,9 @@ u8 GetMoveRelearnerMoves(struct Pokemon *mon, u16 *moves)
     u8 level = GetMonData(mon, MON_DATA_LEVEL, NULL);
