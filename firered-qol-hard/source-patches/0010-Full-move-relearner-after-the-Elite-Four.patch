+@ After the Elite Four: free, and every move the Pokemon can learn
+TwoIsland_House_EventScript_ChampionTutor::
+	msgbox TwoIsland_House_Text_ChampionTutorOffer, MSGBOX_YESNO
+	goto_if_eq VAR_RESULT, NO, TwoIsland_House_EventScript_ChampionTutorEnd
+TwoIsland_House_EventScript_ChampionTutorChooseMon::
+	msgbox TwoIsland_House_Text_TutorWhichMon
+	special ChooseMonForMoveRelearner
+	waitstate
+	goto_if_ge VAR_0x8004, PARTY_SIZE, TwoIsland_House_EventScript_ChampionTutorEnd
+	special IsSelectedMonEgg
+	goto_if_eq VAR_RESULT, TRUE, TwoIsland_House_EventScript_ChampionTutorEgg
+	goto_if_eq VAR_0x8005, 0, TwoIsland_House_EventScript_ChampionTutorNoMoves
+	msgbox TwoIsland_House_Text_TeachWhichMove
+	special TeachMoveRelearnerMove
+	waitstate
+	goto TwoIsland_House_EventScript_ChampionTutorChooseMon
+	end
+
+TwoIsland_House_EventScript_ChampionTutorEgg::
+	msgbox TwoIsland_House_Text_CantTeachAnEgg
+	goto TwoIsland_House_EventScript_ChampionTutorChooseMon
+	end
+
+TwoIsland_House_EventScript_ChampionTutorNoMoves::
+	msgbox TwoIsland_House_Text_NoMoveICanTeachThatMon
+	goto TwoIsland_House_EventScript_ChampionTutorChooseMon
+	end
+
+TwoIsland_House_EventScript_ChampionTutorEnd::
+	msgbox TwoIsland_House_Text_ChampionTutorBye
+	release
+	end
