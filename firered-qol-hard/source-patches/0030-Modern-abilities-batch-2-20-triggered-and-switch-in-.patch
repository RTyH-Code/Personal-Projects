+// ---------------------------------------------------------------------------
+// FireRed QoL+Hard: modern abilities, batch 2 (triggered and switch-in effects)
+// ---------------------------------------------------------------------------
+u8 gHackMoveEndStep;
+static EWRAM_DATA u8 sHackStatDropped = 0; // battlers whose stats a foe lowered (Defiant / Competitive)
+
+void Hack_NoteStatDropped(u8 battler)
+{
+    sHackStatDropped |= gBitTable[battler];
+}
+
+void Hack_ClearStatDropped(u8 battler)
+{
+    sHackStatDropped &= ~gBitTable[battler];
+}
+
+bool8 Hack_IsWindMove(u16 move)
+{
+    switch (move)
+    {
+    case MOVE_GUST: case MOVE_TWISTER: case MOVE_AIR_CUTTER: case MOVE_ICY_WIND: case MOVE_HEAT_WAVE:
+    case MOVE_BLIZZARD: case MOVE_RAZOR_WIND: case MOVE_SILVER_WIND: case MOVE_FAIRY_WIND: case MOVE_WHIRLWIND:
+        return TRUE;
+    }
+    return FALSE;
+}
+
+bool8 Hack_FoeHasUnnerve(u8 battler)
+{
+    u8 i;
+
+    for (i = 0; i < gBattlersCount; i++)
+        if (GetBattlerSide(i) != GetBattlerSide(battler) && gBattleMons[i].hp != 0 && gBattleMons[i].ability == ABILITY_UNNERVE)
+            return TRUE;
+    return FALSE;
+}
+
+// Changes a stat because of the battler's ability and prepares the text and
+// animation for BattleScript_HackAbilityStat*. Returns FALSE if nothing changed.
+bool8 Hack_AbilityStatChange(u8 battler, u8 stat, s8 amount)
+{
+    s8 stage = gBattleMons[battler].statStages[stat];
+    s8 newStage;
+    u8 anim;
+
+    if (gBattleMons[battler].ability == ABILITY_CONTRARY)
+        amount = -amount;
+    if (gBattleMons[battler].ability == ABILITY_SIMPLE)
+        amount *= 2;
+    newStage = stage + amount;
+    if (newStage > MAX_STAT_STAGE)
+        newStage = MAX_STAT_STAGE;
+    if (newStage < MIN_STAT_STAGE)
+        newStage = MIN_STAT_STAGE;
+    if (newStage == stage)
+        return FALSE;
+    gBattleMons[battler].statStages[stat] = newStage;
+    if (newStage - stage >= 2)
+        anim = STAT_ANIM_PLUS2;
+    else if (newStage > stage)
+        anim = STAT_ANIM_PLUS1;
+    else if (stage - newStage >= 2)
+        anim = STAT_ANIM_MINUS2;
+    else
+        anim = STAT_ANIM_MINUS1;
+    gBattleScripting.animArg1 = stat + anim - 1;
+    gBattleScripting.animArg2 = 0;
+    gBattleScripting.battler = battler;
+    gBattleCommunication[MULTISTRING_CHOOSER] = (newStage < stage);
+    PREPARE_STAT_BUFFER(gBattleTextBuff1, stat);
+    gLastUsedAbility = gBattleMons[battler].ability;
+    RecordAbilityBattle(battler, gLastUsedAbility);
+    return TRUE;
+}
+
+static bool8 Hack_TryDefiant(u8 battler)
+{
+    if (gBattleMons[battler].hp == 0)
+        return FALSE;
+    if (gBattleMons[battler].ability == ABILITY_DEFIANT)
+        return Hack_AbilityStatChange(battler, STAT_ATK, 2);
+    if (gBattleMons[battler].ability == ABILITY_COMPETITIVE)
+        return Hack_AbilityStatChange(battler, STAT_SPATK, 2);
+    return FALSE;
+}
+
+// MOVEEND_HACK_ABILITIES: Moxie, Poison Touch, then Defiant / Competitive.
+bool8 Hack_MoveEndAbilities(void)
+{
+    u8 i;
+
+    switch (gHackMoveEndStep)
+    {
+    case 0:
+        gHackMoveEndStep = 1;
+        if (gBattleMons[gBattlerAttacker].ability == ABILITY_MOXIE && gBattleMons[gBattlerAttacker].hp != 0
+         && gBattlerAttacker != gBattlerTarget && gBattleMons[gBattlerTarget].hp == 0 && TARGET_TURN_DAMAGED
+         && Hack_AbilityStatChange(gBattlerAttacker, STAT_ATK, 1))
+        {
+            BattleScriptPushCursor();
+            gBattlescriptCurrInstr = BattleScript_HackAbilityStatRet;
+            return TRUE;
+        }
+        // fall through
+    case 1:
+        gHackMoveEndStep = 2;
+        if (gBattleMons[gBattlerAttacker].ability == ABILITY_POISON_TOUCH && gBattleMons[gBattlerAttacker].hp != 0
+         && gBattlerAttacker != gBattlerTarget && gBattleMons[gBattlerTarget].hp != 0 && TARGET_TURN_DAMAGED
+         && !(gMoveResultFlags & MOVE_RESULT_NO_EFFECT) && (gBattleMoves[gCurrentMove].flags & FLAG_MAKES_CONTACT)
+         && !(gBattleMons[gBattlerTarget].status2 & STATUS2_SUBSTITUTE) && gBattleMons[gBattlerTarget].status1 == 0
+         && (Random() % 10) < 3)
+        {
+            gBattleCommunication[MOVE_EFFECT_BYTE] = MOVE_EFFECT_POISON;
+            BattleScriptPushCursor();
+            gBattlescriptCurrInstr = BattleScript_ApplySecondaryEffect;
+            return TRUE;
+        }
+        // fall through
+    case 2:
+        for (i = 0; i < gBattlersCount; i++)
+        {
+            if (!(sHackStatDropped & gBitTable[i]))
+                continue;
+            sHackStatDropped &= ~gBitTable[i];
+            if (Hack_TryDefiant(i))
+            {
+                BattleScriptPushCursor();
+                gBattlescriptCurrInstr = BattleScript_HackAbilityStatRet;
+                return TRUE;
+            }
+        }
+        break;
+    }
+    return FALSE;
+}
+
+// callnative after Intimidate lowers gBattlerTarget's Attack.
+void Hack_BS_TryDefiant(void)
+{
+    Hack_ClearStatDropped(gBattlerTarget);
+    if (Hack_TryDefiant(gBattlerTarget))
+    {
+        BattleScriptPush(gBattlescriptCurrInstr + 5);
+        gBattlescriptCurrInstr = BattleScript_HackAbilityStatRet;
+    }
+    else
+    {
+        gBattlescriptCurrInstr += 5;
+    }
+}
+
+// callnative: second half of Weak Armor (Speed +2 after Defense -1).
+void Hack_BS_WeakArmorSpeed(void)
+{
+    if (Hack_AbilityStatChange(gBattlerTarget, STAT_SPEED, 2))
+    {
+        BattleScriptPush(gBattlescriptCurrInstr + 5);
+        gBattlescriptCurrInstr = BattleScript_HackAbilityStatRet;
+    }
+    else
+    {
+        gBattlescriptCurrInstr += 5;
+    }
+}
+
+// Target-side abilities after being hit (ABILITYEFFECT_ON_DAMAGE).
+u8 Hack_OnDamageAbility(u8 battler, u8 ability, u16 move, u8 moveType)
+{
+    u8 i;
+
+    if ((gMoveResultFlags & MOVE_RESULT_NO_EFFECT) || !TARGET_TURN_DAMAGED || gBattlerAttacker == battler)
+        return 0;
+    if (ability == ABILITY_AFTERMATH)
+    {
+        if (gBattleMons[battler].hp == 0 && gBattleMons[gBattlerAttacker].hp != 0
+         && (gBattleMoves[move].flags & FLAG_MAKES_CONTACT) && gBattleMons[gBattlerAttacker].ability != ABILITY_MAGIC_GUARD
+         && !ABILITY_ON_FIELD(ABILITY_DAMP))
+        {
+            gBattleMoveDamage = gBattleMons[gBattlerAttacker].maxHP / 4;
+            if (gBattleMoveDamage == 0)
+                gBattleMoveDamage = 1;
+            BattleScriptPushCursor();
+            gBattlescriptCurrInstr = BattleScript_RoughSkinActivates;
+            return 1;
+        }
+        return 0;
+    }
+    if (gBattleMons[battler].hp == 0)
+        return 0;
+    switch (ability)
+    {
+    case ABILITY_JUSTIFIED:
+        if (moveType == TYPE_DARK && Hack_AbilityStatChange(battler, STAT_ATK, 1))
+            break;
+        return 0;
+    case ABILITY_RATTLED:
+        if ((moveType == TYPE_BUG || moveType == TYPE_GHOST || moveType == TYPE_DARK) && Hack_AbilityStatChange(battler, STAT_SPEED, 1))
+            break;
+        return 0;
+    case ABILITY_ANGER_POINT:
+        if (gCritMultiplier == 2 && Hack_AbilityStatChange(battler, STAT_ATK, MAX_STAT_STAGE))
+            break;
+        return 0;
+    case ABILITY_WEAK_ARMOR:
+        if (!IS_MOVE_PHYSICAL(move))
+            return 0;
+        if (Hack_AbilityStatChange(battler, STAT_DEF, -1))
+        {
+            BattleScriptPushCursor();
+            gBattlescriptCurrInstr = BattleScript_HackWeakArmor;
+            return 1;
+        }
+        if (Hack_AbilityStatChange(battler, STAT_SPEED, 2))
+            break;
+        return 0;
+    case ABILITY_CURSED_BODY:
+        if (gBattleMons[gBattlerAttacker].hp == 0 || move == MOVE_STRUGGLE || gDisableStructs[gBattlerAttacker].disabledMove != MOVE_NONE
+         || (Random() % 10) >= 3)
+            return 0;
+        for (i = 0; i < MAX_MON_MOVES; i++)
+            if (gBattleMons[gBattlerAttacker].moves[i] == move)
+                break;
+        if (i == MAX_MON_MOVES)
+            return 0;
+        gDisableStructs[gBattlerAttacker].disabledMove = move;
+        gDisableStructs[gBattlerAttacker].disableTimer = gDisableStructs[gBattlerAttacker].disableTimerStartValue = 4;
+        PREPARE_MOVE_BUFFER(gBattleTextBuff1, move);
+        BattleScriptPushCursor();
+        gBattlescriptCurrInstr = BattleScript_HackCursedBody;
+        return 1;
+    default:
+        return 0;
+    }
+    BattleScriptPushCursor();
+    gBattlescriptCurrInstr = BattleScript_HackAbilityStatRet;
+    return 1;
+}
+
+// Download, Frisk, Unnerve (once per switch-in).
+u8 Hack_SwitchInAbility(u8 battler, u8 ability)
+{
+    u8 i;
+    u32 def = 0, spDef = 0;
+
+    switch (ability)
+    {
+    case ABILITY_DOWNLOAD:
+        for (i = 0; i < gBattlersCount; i++)
+        {
+            if (GetBattlerSide(i) != GetBattlerSide(battler) && gBattleMons[i].hp != 0)
+            {
+                def += gBattleMons[i].defense;
+                spDef += gBattleMons[i].spDefense;
+            }
+        }
+        if (def + spDef == 0 || !Hack_AbilityStatChange(battler, (def < spDef) ? STAT_ATK : STAT_SPATK, 1))
+            return 0;
+        BattleScriptPushCursorAndCallback(BattleScript_HackAbilityStatEnd3);
+        return 1;
+    case ABILITY_FRISK:
+        for (i = 0; i < gBattlersCount; i++)
+        {
+            if (GetBattlerSide(i) != GetBattlerSide(battler) && gBattleMons[i].hp != 0 && gBattleMons[i].item != ITEM_NONE)
+            {
+                gLastUsedItem = gBattleMons[i].item;
+                gBattleScripting.battler = battler;
+                BattleScriptPushCursorAndCallback(BattleScript_HackFrisk);
+                return 1;
+            }
+        }
+        return 0;
+    case ABILITY_UNNERVE:
+        gBattleScripting.battler = battler;
+        BattleScriptPushCursorAndCallback(BattleScript_HackUnnerve);
+        return 1;
+    }
+    return 0;
+}
+
+// Moody and Healer at the end of the turn.
+u8 Hack_EndTurnAbility(u8 battler, u8 ability)
+{
+    u8 i, up, down, count, choices[NUM_BATTLE_STATS];
+    u8 partner;
+
+    if (ability == ABILITY_MOODY)
+    {
+        count = 0;
+        for (i = STAT_ATK; i <= STAT_SPDEF; i++)
+            if (gBattleMons[battler].statStages[i] < MAX_STAT_STAGE)
+                choices[count++] = i;
+        if (count == 0)
+            return 0;
+        up = choices[Random() % count];
+        count = 0;
+        for (i = STAT_ATK; i <= STAT_SPDEF; i++)
+            if (i != up && gBattleMons[battler].statStages[i] > MIN_STAT_STAGE)
+                choices[count++] = i;
+        if (count == 0)
+        {
+            Hack_AbilityStatChange(battler, up, 2);
+            BattleScriptPushCursorAndCallback(BattleScript_HackAbilityStatEnd3);
+            return 1;
+        }
+        down = choices[Random() % count];
+        gBattleMons[battler].statStages[up] += 2;
+        if (gBattleMons[battler].statStages[up] > MAX_STAT_STAGE)
+            gBattleMons[battler].statStages[up] = MAX_STAT_STAGE;
+        gBattleMons[battler].statStages[down]--;
+        PREPARE_STAT_BUFFER(gBattleTextBuff1, up);
+        PREPARE_STAT_BUFFER(gBattleTextBuff2, down);
+        gBattleScripting.animArg1 = up + STAT_ANIM_PLUS2 - 1;
+        gBattleScripting.animArg2 = 0;
+        gBattleScripting.battler = battler;
+        BattleScriptPushCursorAndCallback(BattleScript_HackMoody);
+        return 1;
+    }
+    // Healer: 30% chance to cure the ally's status in a double battle
+    if (!(gBattleTypeFlags & BATTLE_TYPE_DOUBLE))
+        return 0;
+    partner = BATTLE_PARTNER(battler);
+    if (partner >= gBattlersCount || gBattleMons[partner].hp == 0 || !(gBattleMons[partner].status1 & STATUS1_ANY) || (Random() % 10) >= 3)
+        return 0;
+    if (gBattleMons[partner].status1 & (STATUS1_POISON | STATUS1_TOXIC_POISON))
+        StringCopy(gBattleTextBuff1, gStatusConditionString_PoisonJpn);
+    if (gBattleMons[partner].status1 & STATUS1_SLEEP)
+        StringCopy(gBattleTextBuff1, gStatusConditionString_SleepJpn);
+    if (gBattleMons[partner].status1 & STATUS1_PARALYSIS)
+        StringCopy(gBattleTextBuff1, gStatusConditionString_ParalysisJpn);
+    if (gBattleMons[partner].status1 & STATUS1_BURN)
+        StringCopy(gBattleTextBuff1, gStatusConditionString_BurnJpn);
+    if (gBattleMons[partner].status1 & STATUS1_FREEZE)
+        StringCopy(gBattleTextBuff1, gStatusConditionString_IceJpn);
+    gBattleMons[partner].status1 = 0;
+    gBattleMons[partner].status2 &= ~STATUS2_NIGHTMARE;
+    gBattleScripting.battler = gActiveBattler = partner;
+    BattleScriptPushCursorAndCallback(BattleScript_HackHealer);
+    BtlController_EmitSetMonData(BUFFER_A, REQUEST_STATUS_BATTLE, 0, 4, &gBattleMons[partner].status1);
+    MarkBattlerForControllerExec(gActiveBattler);
+    return 1;
+}
