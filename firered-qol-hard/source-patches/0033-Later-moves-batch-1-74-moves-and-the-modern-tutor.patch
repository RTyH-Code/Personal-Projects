diff --git a/src/data/pokemon/hack_tutor_learnsets.h b/src/data/pokemon/hack_tutor_learnsets.h
new file mode 100644
index 0000000..3a22b30
--- /dev/null
+++ b/src/data/pokemon/hack_tutor_learnsets.h
@@ -0,0 +1,393 @@
+// FireRed QoL+Hard: moves the modern tutor can teach (generated by tools/hack/moves.py).
+// One bit per move from MOVE_FAIRY_WIND on: set when the Pokemon could learn that
+// move by TM or tutor in Gen 4-9.
+
+#define HACK_TUTOR_FIRST_MOVE MOVE_FAIRY_WIND
+#define HACK_TUTOR_MOVE_COUNT (MOVES_COUNT - MOVE_FAIRY_WIND)
+#define HACK_TUTOR_BYTES 10
