--- a/src/party_menu.c
+++ b/src/party_menu.c
@@ -1931,6 +1931,59 @@ static bool8 CanLearnTutorMove(u16 species, u8 tutor)
     }
 }
 
+static const u8 sText_DeoxysChangedForme[] = _("{STR_VAR_1} changed to\nits {STR_VAR_2} FORME!{PAUSE_UNTIL_PRESS}");
+static const u8 sText_FormeNormal[] = _("NORMAL");
+static const u8 sText_FormeAttack[] = _("ATTACK");
+static const u8 sText_FormeDefense[] = _("DEFENSE");
+static const u8 sText_FormeSpeed[] = _("SPEED");
+
+// Meteorite: cycles Deoxys through Normal -> Attack -> Defense -> Speed
+void ItemUseCB_FormChange(u8 taskId, TaskFunc func)
+{
+    struct Pokemon *mon = &gPlayerParty[gPartyMenu.slotId];
+    u16 species = GetMonData(mon, MON_DATA_SPECIES);
+    u16 next;
+    const u8 *formeName;
+
+    switch (species)
+    {
+    case SPECIES_DEOXYS:
+        next = SPECIES_DEOXYS_ATTACK;
+        formeName = sText_FormeAttack;
+        break;
+    case SPECIES_DEOXYS_ATTACK:
+        next = SPECIES_DEOXYS_DEFENSE;
+        formeName = sText_FormeDefense;
+        break;
+    case SPECIES_DEOXYS_DEFENSE:
+        next = SPECIES_DEOXYS_SPEED;
+        formeName = sText_FormeSpeed;
+        break;
+    case SPECIES_DEOXYS_SPEED:
+        next = SPECIES_DEOXYS;
+        formeName = sText_FormeNormal;
+        break;
+    default:
+        gPartyMenuUseExitCallback = FALSE;
+        PlaySE(SE_SELECT);
+        DisplayPartyMenuMessage(gText_WontHaveEffect, TRUE);
+        ScheduleBgCopyTilemapToVram(2);
+        gTasks[taskId].func = func;
+        return;
+    }
+
+    gPartyMenuUseExitCallback = FALSE;
+    PlaySE(SE_USE_ITEM);
+    SetMonData(mon, MON_DATA_SPECIES, &next);
+    CalculateMonStats(mon);
+    GetMonNickname(mon, gStringVar1);
+    StringCopy(gStringVar2, formeName);
+    StringExpandPlaceholders(gStringVar4, sText_DeoxysChangedForme);
+    DisplayPartyMenuMessage(gStringVar4, TRUE);
+    ScheduleBgCopyTilemapToVram(2);
+    gTasks[taskId].func = func;
+}
+
 u16 Hack_GetTutorMove(u8 tutor)
 {
     return GetTutorMove(tutor);
