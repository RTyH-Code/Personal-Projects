+static const u8 sText_IvEv_Help2[] = _("{A_BUTTON}Save (pool must be 0)  {B_BUTTON}Cancel");
+
 static const u8 sLevelNickTextColors[][3] =
 {
     {0, 14, 10},
@@ -1163,6 +1171,14 @@ static void Task_InputHandler_Info(u8 taskId)
             }
         }
 
