+
+@ FireRed QoL+Hard: a bigger reward for each peak (round 3) Champion win
+Hack_EventScript_PeakLeagueReward::
+	msgbox Hack_Text_PeakLeagueReward
+	random 100
+	goto_if_lt VAR_RESULT, 20, Hack_EventScript_PeakLeagueMasterBall
+	goto_if_lt VAR_RESULT, 50, Hack_EventScript_PeakLeaguePPMax
+	goto_if_lt VAR_RESULT, 75, Hack_EventScript_PeakLeagueStarPiece
+	giveitem ITEM_NUGGET, 5
+	return
+
+Hack_EventScript_PeakLeagueMasterBall::
+	giveitem ITEM_MASTER_BALL
+	return
+
+Hack_EventScript_PeakLeaguePPMax::
+	giveitem ITEM_PP_MAX, 3
+	return
+
+Hack_EventScript_PeakLeagueStarPiece::
+	giveitem ITEM_STAR_PIECE, 3
+	return
+
+Hack_Text_PeakLeagueReward::
+	.string "The LEAGUE has a prize for anyone\n"
+	.string "who beats us at our very best.$"
+
+@ FireRed QoL+Hard: a bonus prize for a new Trainer Tower record
+Hack_EventScript_TowerRecordBonus::
+	msgbox Hack_Text_TowerRecordBonus
+	random 100
+	goto_if_lt VAR_RESULT, 10, Hack_EventScript_TowerRecordMasterBall
+	goto_if_lt VAR_RESULT, 30, Hack_EventScript_TowerRecordRareCandy
+	goto_if_lt VAR_RESULT, 60, Hack_EventScript_TowerRecordStarPiece
+	giveitem ITEM_PP_MAX
+	return
+
+Hack_EventScript_TowerRecordMasterBall::
+	giveitem ITEM_MASTER_BALL
+	return
+
+Hack_EventScript_TowerRecordRareCandy::
+	giveitem ITEM_RARE_CANDY, 3
+	return
+
+Hack_EventScript_TowerRecordStarPiece::
+	giveitem ITEM_STAR_PIECE, 2
+	return
+
+Hack_Text_TowerRecordBonus::
+	.string "A new record deserves something\n"
+	.string "extra. Take this, too!$"
+
+@ FireRed QoL+Hard: the Trainer Tower lobby trader swaps valuables for
+@ items you can't buy
+Hack_EventScript_Trader::
+	lock
+	faceplayer
+	msgbox Hack_Text_TraderIntro
+Hack_EventScript_TraderMenu::
+	message Hack_Text_TraderWhich
+	waitmessage
+	multichoice 17, 0, MULTICHOICE_HACK_TRADER, FALSE
+	switch VAR_RESULT
+	case 0, Hack_EventScript_TradeMasterBall
+	case 1, Hack_EventScript_TradePPMax
+	case 2, Hack_EventScript_TradeRareCandy
+	msgbox Hack_Text_TraderBye
+	release
+	end
+
+Hack_EventScript_TradeMasterBall::
+	checkitem ITEM_STAR_PIECE, 3
+	goto_if_eq VAR_RESULT, FALSE, Hack_EventScript_TraderNotEnough
+	checkitemspace ITEM_MASTER_BALL
+	goto_if_eq VAR_RESULT, FALSE, Hack_EventScript_TraderBagFull
+	removeitem ITEM_STAR_PIECE, 3
+	giveitem ITEM_MASTER_BALL
+	goto Hack_EventScript_TraderMenu
+
+Hack_EventScript_TradePPMax::
+	checkitem ITEM_BIG_PEARL, 2
+	goto_if_eq VAR_RESULT, FALSE, Hack_EventScript_TraderNotEnough
+	checkitemspace ITEM_PP_MAX
+	goto_if_eq VAR_RESULT, FALSE, Hack_EventScript_TraderBagFull
+	removeitem ITEM_BIG_PEARL, 2
+	giveitem ITEM_PP_MAX
+	goto Hack_EventScript_TraderMenu
+
+Hack_EventScript_TradeRareCandy::
+	checkitem ITEM_NUGGET, 1
+	goto_if_eq VAR_RESULT, FALSE, Hack_EventScript_TraderNotEnough
+	checkitemspace ITEM_RARE_CANDY, 2
+	goto_if_eq VAR_RESULT, FALSE, Hack_EventScript_TraderBagFull
+	removeitem ITEM_NUGGET, 1
+	giveitem ITEM_RARE_CANDY, 2
+	goto Hack_EventScript_TraderMenu
+
+Hack_EventScript_TraderNotEnough::
+	msgbox Hack_Text_TraderNotEnough
+	goto Hack_EventScript_TraderMenu
+
+Hack_EventScript_TraderBagFull::
+	msgbox Text_BagIsFull
+	goto Hack_EventScript_TraderMenu
+
+Hack_Text_TraderIntro::
+	.string "Climbing those stairs is tougher\n"
+	.string "than any battle!\p"
+	.string "But I collect treasures. I'll swap\n"
+	.string "things you can't buy for them.\p"
+	.string "3 STAR PIECES: a MASTER BALL.\n"
+	.string "2 BIG PEARLS: a PP MAX.\l"
+	.string "1 NUGGET: 2 RARE CANDIES.$"
+
+Hack_Text_TraderWhich::
+	.string "What would you like?$"
+
+Hack_Text_TraderNotEnough::
+	.string "You don't have enough for that\n"
+	.string "one, I'm afraid.$"
+
+Hack_Text_TraderBye::
+	.string "Come back with more treasures!$"
