     return Hack_NuzlockeActive() && (GetBoxMonData(boxMon, MON_DATA_UNUSED_RIBBONS) & DEAD_BIT);
 }
 
-// A Pokémon that has fainted can't be healed or revived by anything.
+// Exhibition battles don't count for the Nuzlocke rules: the Trainer Tower
+// and the Lv. 100 peak trainers (gym rematches and Elite Four round 3).
+bool8 Hack_ExhibitionBattle(void)
+{
+    if (gBattleTypeFlags & BATTLE_TYPE_TRAINER_TOWER)
+        return TRUE;
+    if ((gBattleTypeFlags & BATTLE_TYPE_TRAINER) && gTrainerBattleOpponent_A < MAX_TRAINERS_COUNT
+     && (gTrainers[gTrainerBattleOpponent_A].partyFlags & F_TRAINER_PARTY_PEAK))
+        return TRUE;
+    return FALSE;
+}
+
+// A Pokémon that has fainted can't be healed or revived by anything. In battle
+// it counts as soon as it faints; it's marked for good when the battle ends.
 bool8 Hack_NuzlockeMonDead(struct Pokemon *mon)
 {
     if (!Hack_NuzlockeActive() || !IsPlayerPartyMon(mon))
         return FALSE;
     if (GetMonData(mon, MON_DATA_SPECIES) == SPECIES_NONE || GetMonData(mon, MON_DATA_IS_EGG))
         return FALSE;
-    return (GetMonData(mon, MON_DATA_UNUSED_RIBBONS) & DEAD_BIT) || GetMonData(mon, MON_DATA_HP) == 0;
+    if (GetMonData(mon, MON_DATA_UNUSED_RIBBONS) & DEAD_BIT)
+        return TRUE;
+    return gMain.inBattle && !Hack_ExhibitionBattle() && GetMonData(mon, MON_DATA_HP) == 0;
+}
+
+// Called when a battle ends.
+void Hack_NuzlockeBattleEnd(void)
+{
+    u8 i;
+    u16 hp = 1;
+
+    sExhibitionLoss = Hack_ExhibitionBattle() && gBattleOutcome != B_OUTCOME_WON;
+    if (!Hack_ExhibitionBattle())
+    {
+        Hack_NuzlockeMarkFainted();
+        return;
+    }
+    // Exhibition battle: Pokemon that fainted are left with 1 HP, not lost.
+    if (!Hack_NuzlockeActive())
+        return;
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        struct Pokemon *mon = &gPlayerParty[i];
+        if (GetMonData(mon, MON_DATA_SPECIES) != SPECIES_NONE && !GetMonData(mon, MON_DATA_IS_EGG)
+         && GetMonData(mon, MON_DATA_HP) == 0)
+            SetMonData(mon, MON_DATA_HP, &hp);
+    }
 }
 
