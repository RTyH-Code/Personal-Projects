+        if (Hack_TurnOrderPos(battlerIdAtk) > Hack_TurnOrderPos(battlerIdDef))
+            power = power * 13 / 10;
+        break;
+    case ABILITY_NORMALIZE:
+        power = power * 12 / 10;
+        break;
+    case ABILITY_RIVALRY:
+        g1 = GetGenderFromSpeciesAndPersonality(attacker->species, attacker->personality);
+        g2 = GetGenderFromSpeciesAndPersonality(defender->species, defender->personality);
+        if (g1 != MON_GENDERLESS && g2 != MON_GENDERLESS)
+            power = (g1 == g2) ? power * 125 / 100 : power * 75 / 100;
+        break;
+    }
+    if (defender->ability == ABILITY_DRY_SKIN && type == TYPE_FIRE)
+        power = power * 125 / 100;
+    return power;
+}
