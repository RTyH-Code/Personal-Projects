diff --git a/src/pokemon.c b/src/pokemon.c
index db18f03..79ca9eb 100644
--- a/src/pokemon.c
+++ b/src/pokemon.c
@@ -2391,8 +2391,105 @@ static void DeleteFirstMoveAndGiveMoveToBoxMon(struct BoxPokemon *boxMon, u16 mo
     (!(gBattleTypeFlags & (BATTLE_TYPE_LINK | BATTLE_TYPE_EREADER_TRAINER)) && FlagGet(flag) && GetBattlerSide(battler) == B_SIDE_PLAYER)
 
 
+
+// ---------------------------------------------------------------------------
+// FireRed QoL+Hard: modern ability helpers used by the damage formula
+// ---------------------------------------------------------------------------
+static bool8 Hack_IsPunchMove(u16 move)
+{
+    switch (move)
+    {
+    case MOVE_MEGA_PUNCH: case MOVE_FIRE_PUNCH: case MOVE_ICE_PUNCH: case MOVE_THUNDER_PUNCH:
+    case MOVE_COMET_PUNCH: case MOVE_DIZZY_PUNCH: case MOVE_DYNAMIC_PUNCH: case MOVE_FOCUS_PUNCH:
+    case MOVE_MACH_PUNCH: case MOVE_METEOR_MASH: case MOVE_SKY_UPPERCUT: case MOVE_SHADOW_PUNCH:
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static bool8 Hack_IsRecoilMove(u16 move)
+{
+    switch (gBattleMoves[move].effect)
+    {
+    case EFFECT_RECOIL: case EFFECT_DOUBLE_EDGE: case EFFECT_RECOIL_IF_MISS:
+        return TRUE;
+    }
+    return FALSE;
+}
+
+// Moves with a real secondary effect: Sheer Force boosts them and removes the effect.
+bool8 Hack_SheerForceBoosts(u16 move)
+{
+    if (gBattleMoves[move].power == 0 || gBattleMoves[move].secondaryEffectChance == 0)
+        return FALSE;
+    switch (gBattleMoves[move].effect)
+    {
+    case EFFECT_KNOCK_OFF: case EFFECT_OVERHEAT: case EFFECT_PAY_DAY: case EFFECT_RAMPAGE:
+    case EFFECT_THIEF: case EFFECT_TRAP: case EFFECT_UPROAR:
+        return FALSE;
+    }
+    return TRUE;
+}
+
+static u8 Hack_TurnOrderPos(u8 battler)
+{
+    u8 i;
+
+    for (i = 0; i < gBattlersCount; i++)
+        if (gBattlerByTurnOrder[i] == battler)
