diff --git a/src/roamer.c b/src/roamer.c
index b3f2623..200449c 100644
--- a/src/roamer.c
+++ b/src/roamer.c
@@ -227,6 +227,9 @@ void CreateRoamerMonInstance(void)
 
 bool8 TryStartRoamerEncounter(void)
 {
+    // FireRed QoL+Hard: Raikou, Entei and Suicune are static encounters instead
+    if (TRUE)
+        return FALSE;
     if (IsRoamerAt(gSaveBlock1Ptr->location.mapGroup, gSaveBlock1Ptr->location.mapNum) == TRUE && (Random() % 4) == 0)
