+// The AI doesn't know the later moves' conditions: tell it when one would do nothing
+bool8 Hack_AIMoveIsPointless(u16 move)
+{
+    u8 side = GetBattlerSide(gBattlerAttacker);
+    u8 foe = side ^ BIT_SIDE;
+    u8 i;
+    bool8 any = FALSE;
+
+    switch (move)
+    {
+    case MOVE_STEALTH_ROCK:
+        return gHackField.stealthRock[foe];
+    case MOVE_STICKY_WEB:
+        return gHackField.stickyWeb[foe];
+    case MOVE_TOXIC_SPIKES:
+        return gHackField.toxicSpikes[foe] >= 2;
+    case MOVE_TAILWIND:
+        return Hack_TailwindActive(side);
+    case MOVE_TRICK_ROOM:
+        return Hack_TrickRoomActive();
+    case MOVE_POLTERGEIST:
+        return gBattleMons[gBattlerTarget].item == ITEM_NONE;
+    case MOVE_DEFOG:
+        return !Hack_SideHasHazards(side) && !(gSideStatuses[side] & SIDE_STATUS_SPIKES)
+            && !(gSideStatuses[foe] & (SIDE_STATUS_REFLECT | SIDE_STATUS_LIGHTSCREEN));
+    }
+    if (gBattleMoves[move].effect != EFFECT_HACK_STAT_SET)
+        return FALSE;
+    // set-up moves: pointless once every stat they raise is already at +2 or more
+    for (i = 0; i < ARRAY_COUNT(sHackMoveStatChanges); i++)
+    {
+        if (sHackMoveStatChanges[i].move != move || sHackMoveStatChanges[i].amount < 0)
+            continue;
+        any = TRUE;
+        if (gBattleMons[gBattlerAttacker].statStages[sHackMoveStatChanges[i].stat] < DEFAULT_STAT_STAGE + 2)
+            return FALSE;
+    }
+    return any;
+}
