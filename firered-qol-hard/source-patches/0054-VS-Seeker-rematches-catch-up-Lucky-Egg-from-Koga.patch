+// VS Seeker rematch teams catch up: until you have all eight badges, a
+// rematch Pokemon below 5 levels under the next Gym Leader's strongest is
+// raised to that level, and evolves if its new level allows.
+static u8 Hack_RematchFloor(void)
+{
+    u8 i, lvl, ace = 0xFF;
+
+    if (!Hack_IsRematchBattle())
+        return 0;
+    for (i = 0; i < ARRAY_COUNT(sHackCapLeaders); i++)
+    {
+        if (!FlagGet(FLAG_BADGE01_GET + i))
+        {
+            lvl = Hack_TrainerMaxLevel(sHackCapLeaders[i]);
+            if (lvl < ace)
+                ace = lvl;
+        }
+    }
+    return (ace == 0xFF || ace <= 5) ? 0 : ace - 5;
+}
+
+u8 Hack_RematchLevel(u8 level)
+{
+    u8 floor = Hack_RematchFloor();
+    return level < floor ? floor : level;
+}
+
+u16 Hack_RematchSpecies(u16 species, u8 level)
+{
+    u8 i, step;
+    bool8 evolved;
+
+    level = Hack_RematchLevel(level);
+    if (!Hack_IsRematchBattle())
+        return species;
+    for (step = 0; step < 3; step++)
+    {
+        evolved = FALSE;
+        for (i = 0; i < EVOS_PER_MON; i++)
+        {
+            const struct Evolution *evo = &gEvolutionTable[species][i];
+            if ((evo->method == EVO_LEVEL || evo->method == EVO_LEVEL_ATK_GT_DEF || evo->method == EVO_LEVEL_ATK_EQ_DEF
+              || evo->method == EVO_LEVEL_ATK_LT_DEF || evo->method == EVO_LEVEL_SILCOON || evo->method == EVO_LEVEL_CASCOON
+              || evo->method == EVO_LEVEL_NINJASK) && evo->param <= level)
+            {
+                species = evo->targetSpecies;
+                evolved = TRUE;
+                break;
+            }
+        }
+        if (!evolved)
+            break;
+    }
+    return species;
+}
