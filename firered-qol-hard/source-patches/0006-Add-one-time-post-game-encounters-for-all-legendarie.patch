diff --git a/data/scripts/hack_legendaries.inc b/data/scripts/hack_legendaries.inc
new file mode 100644
index 0000000..59f9b66
--- /dev/null
+++ b/data/scripts/hack_legendaries.inc
@@ -0,0 +1,381 @@
+@ FireRed QoL+Hard: legendary encounters (generated by tools/hack/legendaries.py)
+
+EventScript_HackReleaseLegends::
+	setflag FLAG_ENABLE_SHIP_NAVEL_ROCK
+	setflag FLAG_ENABLE_SHIP_BIRTH_ISLAND
+	goto_if_set FLAG_HACK_LEGENDS_RELEASED, EventScript_Return
+	setflag FLAG_HACK_LEGENDS_RELEASED
+	additem ITEM_MYSTIC_TICKET
+	additem ITEM_AURORA_TICKET
+	clearflag FLAG_HACK_CAUGHT_MEW
+	clearflag FLAG_HACK_CAUGHT_CELEBI
+	clearflag FLAG_HACK_CAUGHT_RAIKOU
+	clearflag FLAG_HACK_CAUGHT_ENTEI
+	clearflag FLAG_HACK_CAUGHT_SUICUNE
+	return
+
+EventScript_HackHideLegends::
+	setflag FLAG_HACK_CAUGHT_MEW
+	setflag FLAG_HACK_CAUGHT_CELEBI
+	setflag FLAG_HACK_CAUGHT_RAIKOU
+	setflag FLAG_HACK_CAUGHT_ENTEI
+	setflag FLAG_HACK_CAUGHT_SUICUNE
+	return
+
+Hack_EventScript_Legend_Mew::
+	goto_if_questlog EventScript_ReleaseEnd
+	lock
+	faceplayer
+	special QuestLog_CutRecording
+	setwildbattle SPECIES_MEW, 30
+	waitse
+	playmoncry SPECIES_MEW, CRY_MODE_ENCOUNTER
+	message Text_Gyaoo
+	waitmessage
+	waitmoncry
+	delay 10
+	playbgm MUS_ENCOUNTER_GYM_LEADER, 0
+	waitbuttonpress
+	setflag FLAG_SYS_SPECIAL_WILD_BATTLE
+	special StartLegendaryBattle
+	waitstate
+	clearflag FLAG_SYS_SPECIAL_WILD_BATTLE
+	specialvar VAR_RESULT, GetBattleOutcome
+	goto_if_ne VAR_RESULT, B_OUTCOME_CAUGHT, EventScript_ReleaseEnd
+	setflag FLAG_HACK_CAUGHT_MEW
+	removeobject VAR_LAST_TALKED
+	release
+	end
+
