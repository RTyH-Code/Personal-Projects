From 336678d0b3b6b731b0b0d25a7c71baf5e4c8990d Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 31 Oct 2026 23:43:47 +0000
Subject: [PATCH 7/8] IV/EV editor: A switches IV/EV column, START saves

L/R open FireRed's help system, so EVs are moved with Left/Right on the
EV column instead. Help text no longer overlaps the ABILITY label.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JQmLEZftLdDmGYX3wiQ71G
---
 src/pokemon_summary_screen.c | 33 ++++++++++++++++++++-------------
 1 file changed, 20 insertions(+), 13 deletions(-)

diff --git a/src/pokemon_summary_screen.c b/src/pokemon_summary_screen.c
index 24733b2..ac592df 100644
--- a/src/pokemon_summary_screen.c
+++ b/src/pokemon_summary_screen.c
@@ -910,9 +910,10 @@ static const struct WindowTemplate sWindowTemplates_Dummy[] =
 
 static const u8 sText_IvEv_ControlsPageEdit[] = _("{DPAD_LEFTRIGHT}PAGE {START_BUTTON}IV/EV");
 static const u8 sText_IvEv_Pool[] = _("EV POOL");
-static const u8 sText_IvEv_Columns[] = _("IV    EV");
-static const u8 sText_IvEv_Help1[] = _("{DPAD_UPDOWN}Stat  {DPAD_LEFTRIGHT}IV 0-31  {L_BUTTON}{R_BUTTON}Move 4 EVs");
-static const u8 sText_IvEv_Help2[] = _("{A_BUTTON}Save (pool must be 0)  {B_BUTTON}Cancel");
+static const u8 sText_IvEv_EditingIv[] = _("EDITING IV");
+static const u8 sText_IvEv_EditingEv[] = _("EDITING EV");
+static const u8 sText_IvEv_Help1[] = _("{A_BUTTON}IV/EV {START_BUTTON}Save");
+static const u8 sText_IvEv_Help2[] = _("{DPAD_UPDOWN}Stat {DPAD_LEFTRIGHT}Change  {B_BUTTON}Cancel");
 
 static const u8 sLevelNickTextColors[][3] =
 {
@@ -5261,6 +5262,7 @@ static EWRAM_DATA struct {
     u8 ev[IVEV_NUM_STATS];
     u16 pool;
     u8 cursor;
+    u8 column; // 0 = IV, 1 = EV
 } sIvEvEdit = {0};
 
 static void Task_InputHandler_IvEvEdit(u8 taskId);
@@ -5292,21 +5294,21 @@ static void IvEvEdit_Draw(void)
     FillWindowPixelBuffer(pane, 0);
     for (i = 0; i < IVEV_NUM_STATS; i++)
     {
-        const u8 *colors = (i == sIvEvEdit.cursor) ? sLevelNickTextColors[3] : sLevelNickTextColors[0];
+        bool8 row = (i == sIvEvEdit.cursor);
         ConvertIntToDecimalStringN(str, sIvEvEdit.iv[i], STR_CONV_MODE_LEFT_ALIGN, 2);
-        IvEvEdit_PrintRightAligned(pane, str, 36, sIvEvRowY[i], colors);
+        IvEvEdit_PrintRightAligned(pane, str, 36, sIvEvRowY[i], sLevelNickTextColors[(row && sIvEvEdit.column == 0) ? 3 : 0]);
         ConvertIntToDecimalStringN(str, sIvEvEdit.ev[i], STR_CONV_MODE_LEFT_ALIGN, 3);
-        IvEvEdit_PrintRightAligned(pane, str, 74, sIvEvRowY[i], colors);
+        IvEvEdit_PrintRightAligned(pane, str, 74, sIvEvRowY[i], sLevelNickTextColors[(row && sIvEvEdit.column == 1) ? 3 : 0]);
     }
     ConvertIntToDecimalStringN(str, sIvEvEdit.pool, STR_CONV_MODE_LEFT_ALIGN, 3);
     IvEvEdit_PrintRightAligned(pane, str, 74, 87, sLevelNickTextColors[sIvEvEdit.pool ? 3 : 0]);
 
     FillWindowPixelBuffer(memo, 0);
     AddTextPrinterParameterized3(memo, FONT_NORMAL, 26, 7, sLevelNickTextColors[0], TEXT_SKIP_DRAW, sText_IvEv_Pool);
-    AddTextPrinterParameterized3(memo, FONT_NORMAL, 26, 20, sLevelNickTextColors[0], TEXT_SKIP_DRAW, sText_IvEv_Columns);
+    AddTextPrinterParameterized3(memo, FONT_NORMAL, 26, 20, sLevelNickTextColors[0], TEXT_SKIP_DRAW, sIvEvEdit.column ? sText_IvEv_EditingEv : sText_IvEv_EditingIv);
 
     FillWindowPixelBuffer(help, 0);
-    AddTextPrinterParameterized3(help, FONT_NORMAL, 2, 1, sLevelNickTextColors[0], TEXT_SKIP_DRAW, sText_IvEv_Help1);
+    AddTextPrinterParameterized3(help, FONT_NORMAL, 66, 1, sLevelNickTextColors[0], TEXT_SKIP_DRAW, sText_IvEv_Help1);
     AddTextPrinterParameterized3(help, FONT_NORMAL, 2, 15, sLevelNickTextColors[0], TEXT_SKIP_DRAW, sText_IvEv_Help2);
 
     CopyWindowToVram(pane, COPYWIN_FULL);
@@ -5325,6 +5327,7 @@ static void IvEvEdit_Start(u8 taskId)
     }
     sIvEvEdit.pool = 0;
     sIvEvEdit.cursor = 0;
+    sIvEvEdit.column = 0;
     PlaySE(SE_SELECT);
     IvEvEdit_Draw();
     gTasks[taskId].func = Task_InputHandler_IvEvEdit;
@@ -5385,15 +5388,19 @@ static void Task_InputHandler_IvEvEdit(u8 taskId)
     {
         sIvEvEdit.cursor = (sIvEvEdit.cursor + 1) % IVEV_NUM_STATS;
     }
-    else if (JOY_REPT(DPAD_LEFT))
+    else if (JOY_NEW(A_BUTTON))
+    {
+        sIvEvEdit.column ^= 1;
+    }
+    else if (JOY_REPT(DPAD_LEFT) && sIvEvEdit.column == 0)
     {
         *iv = (*iv == 0) ? MAX_PER_STAT_IVS : *iv - 1;
     }
-    else if (JOY_REPT(DPAD_RIGHT))
+    else if (JOY_REPT(DPAD_RIGHT) && sIvEvEdit.column == 0)
     {
         *iv = (*iv >= MAX_PER_STAT_IVS) ? 0 : *iv + 1;
     }
-    else if (JOY_REPT(L_BUTTON))
+    else if (JOY_REPT(DPAD_LEFT))
     {
         // Take EVs out of this stat into the pool
         amount = (*ev < IVEV_EV_STEP) ? *ev : IVEV_EV_STEP;
@@ -5405,7 +5412,7 @@ static void Task_InputHandler_IvEvEdit(u8 taskId)
         *ev -= amount;
         sIvEvEdit.pool += amount;
     }
-    else if (JOY_REPT(R_BUTTON))
+    else if (JOY_REPT(DPAD_RIGHT))
     {
         // Put EVs from the pool into this stat
         amount = (sIvEvEdit.pool < IVEV_EV_STEP) ? sIvEvEdit.pool : IVEV_EV_STEP;
@@ -5419,7 +5426,7 @@ static void Task_InputHandler_IvEvEdit(u8 taskId)
         *ev += amount;
         sIvEvEdit.pool -= amount;
     }
-    else if (JOY_NEW(A_BUTTON))
+    else if (JOY_NEW(START_BUTTON))
     {
         if (sIvEvEdit.pool != 0)
         {
-- 
