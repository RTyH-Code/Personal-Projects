+import sys
+R=''
+def sub(path, old, new, count=1):
+    p=R+path; s=open(p).read()
+    n=s.count(old)
+    if n!=count: sys.exit(f"{path}: expected {count} got {n}: {old[:80]!r}")
+    open(p,'w').write(s.replace(old,new))
