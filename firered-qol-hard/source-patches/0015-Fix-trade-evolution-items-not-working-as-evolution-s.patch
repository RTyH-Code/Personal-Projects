From 7d863d285bca61c3b95972603e531c5db00eb9b5 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 1 Nov 2026 00:41:41 +0000
Subject: [PATCH 15/37] Fix trade-evolution items not working as evolution
 stones

King's Rock, Metal Coat, Dragon Scale, Up-Grade and Deep Sea Tooth/Scale
were outside the Pokemon-item range and had no item effect, so using them
said it wouldn't have any effect. They now share the evolution stone effect.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JQmLEZftLdDmGYX3wiQ71G
---
 include/constants/items.h       | 5 ++++-
 src/data/pokemon/item_effects.h | 7 +++++++
 2 files changed, 11 insertions(+), 1 deletion(-)

diff --git a/include/constants/items.h b/include/constants/items.h
index e74c35c..76ab491 100644
--- a/include/constants/items.h
+++ b/include/constants/items.h
@@ -460,6 +460,9 @@
 #define SUPER_ROD 2
 
 // Check if the item is one that can be used on a Pokemon.
-#define IS_POKEMON_ITEM(item) ((item) >= ITEM_POTION && (item) <= MAX_BERRY_INDEX)
+// FireRed QoL+Hard: trade-evolution items are used like evolution stones
+#define IS_TRADE_EVO_ITEM(item) ((item) == ITEM_KINGS_ROCK || (item) == ITEM_DEEP_SEA_TOOTH || (item) == ITEM_DEEP_SEA_SCALE \
+                              || (item) == ITEM_METAL_COAT || (item) == ITEM_DRAGON_SCALE || (item) == ITEM_UP_GRADE)
+#define IS_POKEMON_ITEM(item) (((item) >= ITEM_POTION && (item) <= MAX_BERRY_INDEX) || IS_TRADE_EVO_ITEM(item))
 
 #endif  // GUARD_CONSTANTS_ITEMS_H
diff --git a/src/data/pokemon/item_effects.h b/src/data/pokemon/item_effects.h
index db57298..a74beb2 100644
--- a/src/data/pokemon/item_effects.h
+++ b/src/data/pokemon/item_effects.h
@@ -401,4 +401,11 @@ const u8 *const gItemEffectTable[] =
     [ITEM_LUM_BERRY - ITEM_POTION]     = sItemEffect_LumBerry,
     [ITEM_SITRUS_BERRY - ITEM_POTION]  = sItemEffect_SitrusBerry,
     [LAST_BERRY_INDEX - ITEM_POTION]   = NULL,
+    // FireRed QoL+Hard: trade-evolution items work like evolution stones
+    [ITEM_KINGS_ROCK - ITEM_POTION]     = sItemEffect_FireStone, // same effect as every stone
+    [ITEM_DEEP_SEA_TOOTH - ITEM_POTION] = sItemEffect_FireStone, // same effect as every stone
+    [ITEM_DEEP_SEA_SCALE - ITEM_POTION] = sItemEffect_FireStone, // same effect as every stone
+    [ITEM_METAL_COAT - ITEM_POTION]     = sItemEffect_FireStone, // same effect as every stone
+    [ITEM_DRAGON_SCALE - ITEM_POTION]   = sItemEffect_FireStone, // same effect as every stone
+    [ITEM_UP_GRADE - ITEM_POTION]       = sItemEffect_FireStone, // same effect as every stone
 };
