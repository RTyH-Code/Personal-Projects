+@ FireRed QoL+Hard: offer to revive each fossil the player carries, one at a time
+CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_HackAskHelix::
+	checkitem ITEM_HELIX_FOSSIL
+	goto_if_eq VAR_RESULT, FALSE, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_HackAskDome
+	bufferspeciesname STR_VAR_1, SPECIES_OMANYTE
+	bufferitemname STR_VAR_2, ITEM_HELIX_FOSSIL
+	msgbox CinnabarIsland_PokemonLab_ExperimentRoom_Text_ThatFossilIsOfMonMakeItLiveAgain, MSGBOX_YESNO
+	goto_if_eq VAR_RESULT, NO, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_HackAskDome
+	msgbox CinnabarIsland_PokemonLab_ExperimentRoom_Text_HandedFossilToWeirdDoctor
+	textcolor NPC_TEXT_COLOR_MALE
+	removeitem ITEM_HELIX_FOSSIL
+	msgbox CinnabarIsland_PokemonLab_ExperimentRoom_Text_TakesTimeGoForWalk
+	setvar VAR_MAP_SCENE_CINNABAR_ISLAND_POKEMON_LAB_EXPERIMENT_ROOM_REVIVE_STATE, 1
+	setvar VAR_MAP_SCENE_CINNABAR_ISLAND_POKEMON_LAB_EXPERIMENT_ROOM_WHICH_FOSSIL, HELIX_FOSSIL
+	release
+	end
+
+CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_HackAskDome::
+	checkitem ITEM_DOME_FOSSIL
+	goto_if_eq VAR_RESULT, FALSE, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_HackAskAmber
+	bufferspeciesname STR_VAR_1, SPECIES_KABUTO
+	bufferitemname STR_VAR_2, ITEM_DOME_FOSSIL
+	msgbox CinnabarIsland_PokemonLab_ExperimentRoom_Text_ThatFossilIsOfMonMakeItLiveAgain, MSGBOX_YESNO
+	goto_if_eq VAR_RESULT, NO, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_HackAskAmber
+	msgbox CinnabarIsland_PokemonLab_ExperimentRoom_Text_HandedFossilToWeirdDoctor
+	textcolor NPC_TEXT_COLOR_MALE
+	removeitem ITEM_DOME_FOSSIL
+	msgbox CinnabarIsland_PokemonLab_ExperimentRoom_Text_TakesTimeGoForWalk
+	setvar VAR_MAP_SCENE_CINNABAR_ISLAND_POKEMON_LAB_EXPERIMENT_ROOM_REVIVE_STATE, 1
+	setvar VAR_MAP_SCENE_CINNABAR_ISLAND_POKEMON_LAB_EXPERIMENT_ROOM_WHICH_FOSSIL, DOME_FOSSIL
+	release
+	end
+
+CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_HackAskAmber::
+	checkitem ITEM_OLD_AMBER
+	goto_if_eq VAR_RESULT, FALSE, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_HackAskRoot
+	bufferspeciesname STR_VAR_1, SPECIES_AERODACTYL
+	bufferitemname STR_VAR_2, ITEM_OLD_AMBER
+	msgbox CinnabarIsland_PokemonLab_ExperimentRoom_Text_ThatFossilIsOfMonMakeItLiveAgain, MSGBOX_YESNO
+	goto_if_eq VAR_RESULT, NO, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_HackAskRoot
+	msgbox CinnabarIsland_PokemonLab_ExperimentRoom_Text_HandedFossilToWeirdDoctor
+	textcolor NPC_TEXT_COLOR_MALE
+	removeitem ITEM_OLD_AMBER
+	msgbox CinnabarIsland_PokemonLab_ExperimentRoom_Text_TakesTimeGoForWalk
+	setvar VAR_MAP_SCENE_CINNABAR_ISLAND_POKEMON_LAB_EXPERIMENT_ROOM_REVIVE_STATE, 1
+	setvar VAR_MAP_SCENE_CINNABAR_ISLAND_POKEMON_LAB_EXPERIMENT_ROOM_WHICH_FOSSIL, OLD_AMBER
+	release
+	end
+
+CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_HackAskRoot::
+	checkitem ITEM_ROOT_FOSSIL
+	goto_if_eq VAR_RESULT, FALSE, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_HackAskClaw
+	bufferspeciesname STR_VAR_1, SPECIES_LILEEP
+	bufferitemname STR_VAR_2, ITEM_ROOT_FOSSIL
+	msgbox CinnabarIsland_PokemonLab_ExperimentRoom_Text_ThatFossilIsOfMonMakeItLiveAgain, MSGBOX_YESNO
+	goto_if_eq VAR_RESULT, NO, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_HackAskClaw
+	msgbox CinnabarIsland_PokemonLab_ExperimentRoom_Text_HandedFossilToWeirdDoctor
+	textcolor NPC_TEXT_COLOR_MALE
+	removeitem ITEM_ROOT_FOSSIL
+	msgbox CinnabarIsland_PokemonLab_ExperimentRoom_Text_TakesTimeGoForWalk
+	setvar VAR_MAP_SCENE_CINNABAR_ISLAND_POKEMON_LAB_EXPERIMENT_ROOM_REVIVE_STATE, 1
+	setvar VAR_MAP_SCENE_CINNABAR_ISLAND_POKEMON_LAB_EXPERIMENT_ROOM_WHICH_FOSSIL, ROOT_FOSSIL
+	release
+	end
+
+CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_HackAskClaw::
+	checkitem ITEM_CLAW_FOSSIL
+	goto_if_eq VAR_RESULT, FALSE, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_HackNoFossil
+	bufferspeciesname STR_VAR_1, SPECIES_ANORITH
+	bufferitemname STR_VAR_2, ITEM_CLAW_FOSSIL
+	msgbox CinnabarIsland_PokemonLab_ExperimentRoom_Text_ThatFossilIsOfMonMakeItLiveAgain, MSGBOX_YESNO
+	goto_if_eq VAR_RESULT, NO, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_HackNoFossil
+	msgbox CinnabarIsland_PokemonLab_ExperimentRoom_Text_HandedFossilToWeirdDoctor
+	textcolor NPC_TEXT_COLOR_MALE
+	removeitem ITEM_CLAW_FOSSIL
+	msgbox CinnabarIsland_PokemonLab_ExperimentRoom_Text_TakesTimeGoForWalk
+	setvar VAR_MAP_SCENE_CINNABAR_ISLAND_POKEMON_LAB_EXPERIMENT_ROOM_REVIVE_STATE, 1
+	setvar VAR_MAP_SCENE_CINNABAR_ISLAND_POKEMON_LAB_EXPERIMENT_ROOM_WHICH_FOSSIL, CLAW_FOSSIL
+	release
+	end
+
+CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_HackNoFossil::
+	msgbox CinnabarIsland_PokemonLab_ExperimentRoom_Text_HaveYouAFossilForMe
+	goto CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_DontShowFossil
+	end
+
+CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_GiveLileep::
+	setvar VAR_TEMP_1, SPECIES_LILEEP
+	bufferspeciesname STR_VAR_1, SPECIES_LILEEP
+	msgbox CinnabarIsland_PokemonLab_ExperimentRoom_Text_FossilMonBackToLife
+	givemon SPECIES_LILEEP, 5
+	goto_if_eq VAR_RESULT, 2, EventScript_NoMoreRoomForPokemon
+	goto_if_eq VAR_RESULT, 0, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_NicknameMonParty
+	goto_if_eq VAR_RESULT, 1, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_NicknameMonPC
+	end
+
+CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_GiveAnorith::
+	setvar VAR_TEMP_1, SPECIES_ANORITH
+	bufferspeciesname STR_VAR_1, SPECIES_ANORITH
+	msgbox CinnabarIsland_PokemonLab_ExperimentRoom_Text_FossilMonBackToLife
+	givemon SPECIES_ANORITH, 5
+	goto_if_eq VAR_RESULT, 2, EventScript_NoMoreRoomForPokemon
+	goto_if_eq VAR_RESULT, 0, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_NicknameMonParty
+	goto_if_eq VAR_RESULT, 1, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_NicknameMonPC
+	end
