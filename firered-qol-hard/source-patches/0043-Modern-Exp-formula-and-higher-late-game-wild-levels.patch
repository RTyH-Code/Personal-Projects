 // For the toggle NPC: VAR_RESULT = cap, STR_VAR_1 = cap as text.
+static u32 Hack_Isqrt(u64 n)
+{
+    u64 x, y;
+
+    if (n < 2)
+        return n;
+    x = n;
+    y = (x + 1) / 2;
+    while (y < x)
+    {
+        x = y;
+        y = (x + n / x) / 2;
+    }
+    return x;
+}
+
+// Modern (Gen 5+) Exp scaling: exp * ((2L + 10) / (L + Lp + 10))^2.5 + 1, where
+// L is the fainted foe's level and Lp the level of the Pokemon gaining Exp.
+// Beating a stronger foe gives more, a weaker one less.
+u32 Hack_ScaleExp(u32 exp, u8 foeLevel, u8 monLevel)
+{
+    u64 ratio, square, root;
+    u32 num = 2 * foeLevel + 10, den = foeLevel + monLevel + 10;
+
+    if (exp == 0)
+        return 0;
+    ratio = ((u64)num << 16) / den;  // 16.16 fixed point
+    square = (ratio * ratio) >> 16;
+    root = Hack_Isqrt(ratio << 16);
+    return (u32)(((u64)exp * ((square * root) >> 16)) >> 16) + 1;
+}
+
