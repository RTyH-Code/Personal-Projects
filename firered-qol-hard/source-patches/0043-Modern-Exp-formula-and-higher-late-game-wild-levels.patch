index 598a0f8..ff1f621 100644
--- a/src/battle_script_commands.c
+++ b/src/battle_script_commands.c
@@ -3302,7 +3302,7 @@ static void Cmd_getexp(void)
                     viaExpShare++;
             }
 
-            calculatedExp = gSpeciesInfo[gBattleMons[gBattlerFainted].species].expYield * gBattleMons[gBattlerFainted].level / 7;
+            calculatedExp = gSpeciesInfo[gBattleMons[gBattlerFainted].species].expYield * gBattleMons[gBattlerFainted].level / 5; // FireRed QoL+Hard: modern base (scaled per Pokemon below)
 
             if (viaExpShare) // at least one mon is getting exp via exp share
             {
@@ -3368,6 +3368,8 @@ static void Cmd_getexp(void)
 
                     if (holdEffect == HOLD_EFFECT_EXP_SHARE)
                         gBattleMoveDamage += gExpShareExp;
+                    gBattleMoveDamage = Hack_ScaleExp(gBattleMoveDamage, gBattleMons[gBattlerFainted].level,
+                                                      GetMonData(&gPlayerParty[gBattleStruct->expGetterMonId], MON_DATA_LEVEL));
                     if (holdEffect == HOLD_EFFECT_LUCKY_EGG)
                         gBattleMoveDamage = (gBattleMoveDamage * 150) / 100;
                     if (gBattleTypeFlags & BATTLE_TYPE_TRAINER)
