+// ---------------------------------------------------------------------------
+// FireRed QoL+Hard: HM field moves work without a Pokemon knowing them, as
+// long as you have the HM and the badge that allows it.
+// Index = FIELD_MOVE_* (Flash..Waterfall), which also matches the badge order.
+// ---------------------------------------------------------------------------
+static const u16 sHackHmItems[FIELD_MOVE_WATERFALL + 1] =
+{
+    [FIELD_MOVE_FLASH]      = ITEM_HM05,
+    [FIELD_MOVE_CUT]        = ITEM_HM01,
+    [FIELD_MOVE_FLY]        = ITEM_HM02,
+    [FIELD_MOVE_STRENGTH]   = ITEM_HM04,
+    [FIELD_MOVE_SURF]       = ITEM_HM03,
+    [FIELD_MOVE_ROCK_SMASH] = ITEM_HM06,
+    [FIELD_MOVE_WATERFALL]  = ITEM_HM07,
+};
+
+static s8 Hack_HmFieldMoveIndex(u16 move)
+{
+    u8 i;
+
+    for (i = 0; i <= FIELD_MOVE_WATERFALL; i++)
+        if (sFieldMoves[i] == move)
+            return i;
+    return -1;
+}
+
+bool8 Hack_HasHmFieldMove(u16 move)
+{
+    s8 idx = Hack_HmFieldMoveIndex(move);
+
+    if (idx < 0)
+        return FALSE;
+    return FlagGet(FLAG_BADGE01_GET + idx) && CheckBagHasItem(sHackHmItems[idx], 1);
+}
+
+// The party slot shown using the move: one that could learn it, else the
+// first Pokemon that isn't an Egg. PARTY_SIZE if there is none.
+u8 Hack_HmFieldMoveMon(u16 move)
+{
+    s8 idx = Hack_HmFieldMoveIndex(move);
+    u8 i, first = PARTY_SIZE;
+
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        if (GetMonData(&gPlayerParty[i], MON_DATA_SPECIES) == SPECIES_NONE)
+            break;
+        if (GetMonData(&gPlayerParty[i], MON_DATA_IS_EGG))
+            continue;
+        if (first == PARTY_SIZE)
+            first = i;
+        if (idx >= 0 && CanMonLearnTMHM(&gPlayerParty[i], sHackHmItems[idx] - ITEM_TM01))
+            return i;
+    }
+    return first;
+}
