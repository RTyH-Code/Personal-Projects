+// ---------------------------------------------------------------------------
+// Optional level caps (toggled by an NPC in the Viridian City Pokemon Center).
+// The cap is the highest level on the next Gym Leader's team you haven't
+// beaten; with all 8 badges it's the Elite Four / Champion's. No cap once
+// you're Champion. Capped Pokemon get no Exp. and Rare Candies don't work.
+// ---------------------------------------------------------------------------
+static const u16 sHackCapLeaders[] = {
+    TRAINER_LEADER_BROCK, TRAINER_LEADER_MISTY, TRAINER_LEADER_LT_SURGE, TRAINER_LEADER_ERIKA,
+    TRAINER_LEADER_KOGA, TRAINER_LEADER_SABRINA, TRAINER_LEADER_BLAINE, TRAINER_LEADER_GIOVANNI,
+};
+static const u16 sHackCapLeague[] = {
+    TRAINER_ELITE_FOUR_LORELEI, TRAINER_ELITE_FOUR_BRUNO, TRAINER_ELITE_FOUR_AGATHA, TRAINER_ELITE_FOUR_LANCE,
+    TRAINER_CHAMPION_FIRST_SQUIRTLE, TRAINER_CHAMPION_FIRST_BULBASAUR, TRAINER_CHAMPION_FIRST_CHARMANDER,
+};
+
+static u8 Hack_TrainerMaxLevel(u16 trainerNum)
+{
+    const struct Trainer *t = &gTrainers[trainerNum];
+    u8 i, lvl, max = 0;
+
+    for (i = 0; i < t->partySize; i++)
+    {
+        switch (t->partyFlags & (F_TRAINER_PARTY_CUSTOM_MOVESET | F_TRAINER_PARTY_HELD_ITEM))
+        {
+        case 0:
+            lvl = t->party.NoItemDefaultMoves[i].lvl;
+            break;
+        case F_TRAINER_PARTY_CUSTOM_MOVESET:
+            lvl = t->party.NoItemCustomMoves[i].lvl;
+            break;
+        case F_TRAINER_PARTY_HELD_ITEM:
+            lvl = t->party.ItemDefaultMoves[i].lvl;
+            break;
+        default:
+            lvl = t->party.ItemCustomMoves[i].lvl;
+            break;
+        }
+        if (lvl > max)
+            max = lvl;
+    }
+    return max;
+}
+
+u8 Hack_GetLevelCap(void)
+{
+    u8 i, cap = MAX_LEVEL, lvl;
+
+    if (!FlagGet(FLAG_HACK_LEVEL_CAP) || FlagGet(FLAG_SYS_GAME_CLEAR))
+        return MAX_LEVEL;
+    for (i = 0; i < ARRAY_COUNT(sHackCapLeaders); i++)
+    {
+        if (!FlagGet(FLAG_BADGE01_GET + i))
+        {
+            lvl = Hack_TrainerMaxLevel(sHackCapLeaders[i]);
+            if (lvl < cap)
+                cap = lvl;
+        }
+    }
+    if (cap == MAX_LEVEL)
+    {
+        cap = 0;
+        for (i = 0; i < ARRAY_COUNT(sHackCapLeague); i++)
+        {
+            lvl = Hack_TrainerMaxLevel(sHackCapLeague[i]);
+            if (lvl > cap)
+                cap = lvl;
+        }
+    }
+    return cap;
+}
+
+// For the toggle NPC: VAR_RESULT = cap, STR_VAR_1 = cap as text.
+void Hack_BufferLevelCap(void)
+{
+    gSpecialVar_Result = Hack_GetLevelCap();
+    ConvertIntToDecimalStringN(gStringVar1, gSpecialVar_Result, STR_CONV_MODE_LEFT_ALIGN, 3);
+}
