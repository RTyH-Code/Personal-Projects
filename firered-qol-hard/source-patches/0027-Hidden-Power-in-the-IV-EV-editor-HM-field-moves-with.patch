+// Hidden Power's type and power from the IVs being edited (same formula as
+// Cmd_hiddenpowercalc). Index order: HP, Atk, Def, SpAtk, SpDef, Speed.
+static void IvEvEdit_BufferHiddenPower(u8 *dest)
+{
+    const u8 *iv = sIvEvEdit.iv;
+    s32 typeBits = (iv[0] & 1) | ((iv[1] & 1) << 1) | ((iv[2] & 1) << 2)
+                 | ((iv[5] & 1) << 3) | ((iv[3] & 1) << 4) | ((iv[4] & 1) << 5);
+    s32 powerBits = ((iv[0] >> 1) & 1) | (((iv[1] >> 1) & 1) << 1) | (((iv[2] >> 1) & 1) << 2)
+                  | (((iv[5] >> 1) & 1) << 3) | (((iv[3] >> 1) & 1) << 4) | (((iv[4] >> 1) & 1) << 5);
+    u8 type = ((NUMBER_OF_MON_TYPES - 3) * typeBits) / 63 + 1;
+    u8 *end;
+
+    if (type >= TYPE_MYSTERY)
+        type++;
+    end = StringCopy(dest, sText_IvEv_HiddenPower);
+    end = StringCopy(end, gTypeNames[type]);
+    *end++ = CHAR_SPACE;
+    ConvertIntToDecimalStringN(end, (40 * powerBits) / 63 + 30, STR_CONV_MODE_LEFT_ALIGN, 2);
+}
