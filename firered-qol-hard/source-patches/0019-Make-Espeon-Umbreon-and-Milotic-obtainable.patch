From 0ebdcb4aa5f8f71e7ded68346a286b041c3386f9 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 1 Nov 2026 14:48:42 +0000
Subject: [PATCH 19/31] Make Espeon, Umbreon and Milotic obtainable

FireRed has no clock or Pokeblocks, so day/night friendship and beauty
evolutions never trigger. Sun Stone -> Espeon, Moon Stone -> Umbreon and
Deep Sea Scale -> Milotic instead. The obtainability check now ignores
evolution methods FireRed can't trigger.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JQmLEZftLdDmGYX3wiQ71G
---
 HACK_NOTES.md                                   |   3 +++
 src/data/pokemon/evolution.h                    |   6 +++---
 .../hack/__pycache__/encounters.cpython-313.pyc | Bin 0 -> 13503 bytes
 tools/hack/encounters.py                        |   4 +++-
 4 files changed, 9 insertions(+), 4 deletions(-)
 create mode 100644 tools/hack/__pycache__/encounters.cpython-313.pyc

diff --git a/HACK_NOTES.md b/HACK_NOTES.md
index eace547..e106791 100644
--- a/HACK_NOTES.md
+++ b/HACK_NOTES.md
@@ -12,6 +12,9 @@ A quality-of-life, modernization and difficulty hack built on the pret/pokefirer
   - Use King's Rock on Poliwhirl or Slowpoke, Metal Coat on Onix or Scyther,
     Dragon Scale on Seadra, Up-Grade on Porygon, and Deep Sea Tooth or
     Deep Sea Scale on Clamperl, the same way you use an evolution stone.
+- Evolutions FireRed can't trigger (it has no clock and no Pokéblocks):
+  - Use a Sun Stone on Eevee for Espeon, or a Moon Stone for Umbreon.
+  - Use a Deep Sea Scale on Feebas for Milotic.
 - Celadon Department Store 4F sells every evolution item: all stones,
   including the Moon and Sun Stones, plus the trade items above.
 - Pokémon from Johto and Hoenn can evolve before you have the National Dex.
diff --git a/src/data/pokemon/evolution.h b/src/data/pokemon/evolution.h
index 1c038e9..bdef29c 100644
--- a/src/data/pokemon/evolution.h
+++ b/src/data/pokemon/evolution.h
@@ -76,8 +76,8 @@ const struct Evolution gEvolutionTable[NUM_SPECIES][EVOS_PER_MON] =
     [SPECIES_EEVEE]      = {{EVO_ITEM, ITEM_THUNDER_STONE, SPECIES_JOLTEON},
                             {EVO_ITEM, ITEM_WATER_STONE, SPECIES_VAPOREON},
                             {EVO_ITEM, ITEM_FIRE_STONE, SPECIES_FLAREON},
-                            {EVO_FRIENDSHIP_DAY, 0, SPECIES_ESPEON},
-                            {EVO_FRIENDSHIP_NIGHT, 0, SPECIES_UMBREON}},
+                            {EVO_ITEM, ITEM_SUN_STONE, SPECIES_ESPEON},
+                            {EVO_ITEM, ITEM_MOON_STONE, SPECIES_UMBREON}},
     [SPECIES_PORYGON]    = {{EVO_ITEM, ITEM_UP_GRADE, SPECIES_PORYGON2}},
     [SPECIES_OMANYTE]    = {{EVO_LEVEL, 40, SPECIES_OMASTAR}},
     [SPECIES_KABUTO]     = {{EVO_LEVEL, 40, SPECIES_KABUTOPS}},
@@ -149,7 +149,7 @@ const struct Evolution gEvolutionTable[NUM_SPECIES][EVOS_PER_MON] =
     [SPECIES_BALTOY]     = {{EVO_LEVEL, 36, SPECIES_CLAYDOL}},
     [SPECIES_BARBOACH]   = {{EVO_LEVEL, 30, SPECIES_WHISCASH}},
     [SPECIES_CORPHISH]   = {{EVO_LEVEL, 30, SPECIES_CRAWDAUNT}},
-    [SPECIES_FEEBAS]     = {{EVO_BEAUTY, 170, SPECIES_MILOTIC}},
+    [SPECIES_FEEBAS]     = {{EVO_ITEM, ITEM_DEEP_SEA_SCALE, SPECIES_MILOTIC}},
     [SPECIES_CARVANHA]   = {{EVO_LEVEL, 30, SPECIES_SHARPEDO}},
     [SPECIES_TRAPINCH]   = {{EVO_LEVEL, 35, SPECIES_VIBRAVA}},
     [SPECIES_VIBRAVA]    = {{EVO_LEVEL, 45, SPECIES_FLYGON}},
