+// ---------------------------------------------------------------------------
+// FireRed QoL+Hard: modern abilities, batch 3
+// ---------------------------------------------------------------------------
+void Hack_NoteItemLost(u8 battler)
+{
+    gDisableStructs[battler].unk17 |= 2; // Unburden
+}
+
+static u8 Hack_FoeAcross(u8 battler)
+{
+    u8 foe = GetBattlerAtPosition(BATTLE_OPPOSITE(GetBattlerPosition(battler)));
+
+    if (foe >= gBattlersCount || gBattleMons[foe].hp == 0)
+        foe = GetBattlerAtPosition(BATTLE_PARTNER(BATTLE_OPPOSITE(GetBattlerPosition(battler))));
+    if (foe >= gBattlersCount || gBattleMons[foe].hp == 0)
+        return MAX_BATTLERS_COUNT;
+    return foe;
+}
+
+static u8 Hack_ForewarnPower(u16 move)
+{
+    switch (gBattleMoves[move].effect)
+    {
+    case EFFECT_OHKO:
+        return 150;
+    case EFFECT_COUNTER: case EFFECT_MIRROR_COAT:
+        return 120;
+    }
+    if (gBattleMoves[move].power == 1)
+        return 80;
+    return gBattleMoves[move].power;
+}
+
+u8 Hack_Forewarn(u8 battler)
+{
+    u8 i, j, best = 0, power;
+    u16 move = MOVE_NONE;
+
+    for (i = 0; i < gBattlersCount; i++)
+    {
+        if (GetBattlerSide(i) == GetBattlerSide(battler) || gBattleMons[i].hp == 0)
+            continue;
+        for (j = 0; j < MAX_MON_MOVES; j++)
+        {
+            if (gBattleMons[i].moves[j] == MOVE_NONE)
+                continue;
+            power = Hack_ForewarnPower(gBattleMons[i].moves[j]);
+            if (move == MOVE_NONE || power > best || (power == best && (Random() & 1)))
+            {
+                best = power;
+                move = gBattleMons[i].moves[j];
+            }
+        }
+    }
+    if (move == MOVE_NONE)
+        return 0;
+    PREPARE_MOVE_BUFFER(gBattleTextBuff1, move);
+    gBattleScripting.battler = battler;
+    BattleScriptPushCursorAndCallback(BattleScript_HackForewarn);
+    return 1;
+}
+
+u8 Hack_Anticipation(u8 battler)
+{
+    u8 i, j;
+    s32 savedDamage = gBattleMoveDamage;
+    u16 move;
+
+    for (i = 0; i < gBattlersCount; i++)
+    {
+        if (GetBattlerSide(i) == GetBattlerSide(battler) || gBattleMons[i].hp == 0)
+            continue;
+        for (j = 0; j < MAX_MON_MOVES; j++)
+        {
+            move = gBattleMons[i].moves[j];
+            if (move == MOVE_NONE || gBattleMoves[move].power == 0)
+                continue;
+            if (gBattleMoves[move].effect == EFFECT_OHKO || (TypeCalc(move, i, battler) & MOVE_RESULT_SUPER_EFFECTIVE))
+            {
+                gBattleMoveDamage = savedDamage;
+                gBattleScripting.battler = battler;
+                BattleScriptPushCursorAndCallback(BattleScript_HackAnticipation);
+                return 1;
+            }
+        }
+    }
+    gBattleMoveDamage = savedDamage;
+    return 0;
+}
+
+// Imposter: transform into the foe across when switching in.
+static EWRAM_DATA u16 sHackImposterSavedMove = 0;
+static EWRAM_DATA u8 sHackImposterSavedAttacker = 0;
+static EWRAM_DATA u8 sHackImposterSavedTarget = 0;
+static EWRAM_DATA u8 sHackImposterSavedFlags = 0;
+
+u8 Hack_Imposter(u8 battler)
+{
+    u8 foe = Hack_FoeAcross(battler);
+
+    if (foe == MAX_BATTLERS_COUNT || (gBattleMons[foe].status2 & (STATUS2_TRANSFORMED | STATUS2_SUBSTITUTE))
+     || (gStatuses3[foe] & STATUS3_SEMI_INVULNERABLE) || (gBattleMons[battler].status2 & STATUS2_TRANSFORMED))
+        return 0;
+    sHackImposterSavedMove = gCurrentMove;
+    sHackImposterSavedAttacker = gBattlerAttacker;
+    sHackImposterSavedTarget = gBattlerTarget;
+    sHackImposterSavedFlags = gMoveResultFlags;
+    gBattlerAttacker = battler;
+    gBattlerTarget = foe;
+    gCurrentMove = MOVE_TRANSFORM;
+    gMoveResultFlags = 0;
+    gBattleScripting.battler = battler;
+    BattleScriptPushCursorAndCallback(BattleScript_HackImposter);
+    return 1;
+}
+
+void Hack_BS_ImposterEnd(void)
+{
+    gCurrentMove = sHackImposterSavedMove;
+    gBattlerAttacker = sHackImposterSavedAttacker;
+    gBattlerTarget = sHackImposterSavedTarget;
+    gMoveResultFlags = sHackImposterSavedFlags;
+    gBattlescriptCurrInstr += 5;
+}
+
+// Abilities Mold Breaker ignores (modern "breakable" abilities).
+static bool8 Hack_IsBreakable(u8 ability)
+{
+    switch (ability)
+    {
+    case ABILITY_BATTLE_ARMOR: case ABILITY_BIG_PECKS: case ABILITY_CLEAR_BODY: case ABILITY_CONTRARY:
+    case ABILITY_DAMP: case ABILITY_DRY_SKIN: case ABILITY_FILTER: case ABILITY_FLASH_FIRE:
+    case ABILITY_FRIEND_GUARD: case ABILITY_HEAVY_METAL: case ABILITY_HYPER_CUTTER: case ABILITY_IMMUNITY:
+    case ABILITY_INNER_FOCUS: case ABILITY_INSOMNIA: case ABILITY_KEEN_EYE: case ABILITY_LEAF_GUARD:
+    case ABILITY_LEVITATE: case ABILITY_LIGHT_METAL: case ABILITY_LIGHTNING_ROD: case ABILITY_LIMBER:
+    case ABILITY_MAGIC_BOUNCE: case ABILITY_MAGMA_ARMOR: case ABILITY_MARVEL_SCALE: case ABILITY_MULTISCALE:
+    case ABILITY_OBLIVIOUS: case ABILITY_OVERCOAT: case ABILITY_OWN_TEMPO: case ABILITY_SAND_VEIL:
+    case ABILITY_SAP_SIPPER: case ABILITY_SHELL_ARMOR: case ABILITY_SHIELD_DUST: case ABILITY_SIMPLE:
+    case ABILITY_SNOW_CLOAK: case ABILITY_SOLID_ROCK: case ABILITY_SOUNDPROOF: case ABILITY_STICKY_HOLD:
+    case ABILITY_STORM_DRAIN: case ABILITY_STURDY: case ABILITY_SUCTION_CUPS: case ABILITY_TANGLED_FEET:
+    case ABILITY_TELEPATHY: case ABILITY_THICK_FAT: case ABILITY_UNAWARE: case ABILITY_VITAL_SPIRIT:
+    case ABILITY_VOLT_ABSORB: case ABILITY_WATER_ABSORB: case ABILITY_WATER_VEIL: case ABILITY_WHITE_SMOKE:
+    case ABILITY_WONDER_GUARD: case ABILITY_WONDER_SKIN: case ABILITY_WIND_RIDER:
+        return TRUE;
+    }
+    return FALSE;
+}
+
+// Mold Breaker: other battlers' breakable abilities are switched off for the move.
+static EWRAM_DATA u8 sHackMoldMask = 0;
+static EWRAM_DATA u8 sHackMoldSaved[MAX_BATTLERS_COUNT] = {0};
+static EWRAM_DATA u32 sHackMoldPersonality[MAX_BATTLERS_COUNT] = {0};
+
+void Hack_MoldBreakerBegin(void)
+{
+    u8 i, effect = gBattleMoves[gCurrentMove].effect;
+
+    sHackMoldMask = 0;
+    if (gBattleMons[gBattlerAttacker].ability != ABILITY_MOLD_BREAKER
+     || effect == EFFECT_ROLE_PLAY || effect == EFFECT_SKILL_SWAP || effect == EFFECT_TRANSFORM)
+        return;
+    for (i = 0; i < gBattlersCount; i++)
+    {
+        if (i == gBattlerAttacker || !Hack_IsBreakable(gBattleMons[i].ability))
+            continue;
+        sHackMoldSaved[i] = gBattleMons[i].ability;
+        sHackMoldPersonality[i] = gBattleMons[i].personality;
+        gBattleMons[i].ability = ABILITY_NONE;
+        sHackMoldMask |= gBitTable[i];
+    }
+}
+
+void Hack_MoldBreakerEnd(void)
+{
+    u8 i;
+
+    for (i = 0; i < gBattlersCount; i++)
+    {
+        if ((sHackMoldMask & gBitTable[i]) && gBattleMons[i].ability == ABILITY_NONE
+         && gBattleMons[i].personality == sHackMoldPersonality[i])
+            gBattleMons[i].ability = sHackMoldSaved[i];
+    }
+    sHackMoldMask = 0;
+}
+
+// Neutralizing Gas: while its user is in battle, every other ability is switched off.
+static EWRAM_DATA u8 sHackGasMask = 0;
+static EWRAM_DATA u8 sHackGasSaved[MAX_BATTLERS_COUNT] = {0};
+static EWRAM_DATA u32 sHackGasPersonality[MAX_BATTLERS_COUNT] = {0};
+
+void Hack_UpdateNeutralizingGas(void)
+{
+    u8 i;
+    bool8 active = FALSE;
+
+    if (gBattlersCount == 0)
+        return;
+    // Forget entries for battlers that switched out
+    for (i = 0; i < gBattlersCount; i++)
+        if ((sHackGasMask & gBitTable[i]) && gBattleMons[i].personality != sHackGasPersonality[i])
+            sHackGasMask &= ~gBitTable[i];
+    for (i = 0; i < gBattlersCount; i++)
+        if (gBattleMons[i].hp != 0 && gBattleMons[i].ability == ABILITY_NEUTRALIZING_GAS && !(gAbsentBattlerFlags & gBitTable[i]))
+            active = TRUE;
+    for (i = 0; i < gBattlersCount; i++)
+    {
+        if (active && !(sHackGasMask & gBitTable[i]) && gBattleMons[i].ability != ABILITY_NONE
+         && gBattleMons[i].ability != ABILITY_NEUTRALIZING_GAS && gBattleMons[i].hp != 0)
+        {
+            sHackGasSaved[i] = gBattleMons[i].ability;
+            sHackGasPersonality[i] = gBattleMons[i].personality;
+            gBattleMons[i].ability = ABILITY_NONE;
+            sHackGasMask |= gBitTable[i];
+        }
+        else if (!active && (sHackGasMask & gBitTable[i]))
+        {
+            if (gBattleMons[i].ability == ABILITY_NONE)
+                gBattleMons[i].ability = sHackGasSaved[i];
+            sHackGasMask &= ~gBitTable[i];
+        }
+    }
+}
+
+void Hack_ResetAbilityState(void)
+{
+    sHackGasMask = 0;
+    sHackMoldMask = 0;
+    sHackStatDropped = 0;
+}
