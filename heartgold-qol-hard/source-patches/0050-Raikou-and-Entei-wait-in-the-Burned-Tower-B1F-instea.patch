+#!/usr/bin/env python3
+"""Raikou and Entei stay put: they wait in the Burned Tower's basement instead of roaming Johto.
+
+In HeartGold the two beasts run off when the player wakes them in the Burned Tower B1F and roam Johto's routes,
+fleeing every battle; after each Hall of Fame one that was beaten (not caught) starts roaming again. Here the
+scene still shows them run, but they no longer roam: from the next time the player comes down to B1F, each waits
+where it slept, at Lv. 46 (the level legendaries.py gives the roamers), and is fought like the static Suicune.
+Catching one ends it; beating one or running away hides it until the next Hall of Fame, when it is back in B1F.
+
+How:
+- the scene drops `create_roamer 0` and `create_roamer 1`, so their roamer status stays 0;
+- two new objects in B1F, Raikou at (14, 14) and Entei at (16, 14), hidden by FLAG_UNK_A32 and FLAG_UNK_A33
+  (which nothing in the game uses); a new script run on entering B1F shows each only once the scene is done
+  (FLAG_HIDE_BURNED_TOWER_B1F_RAIKOU set) and while its roamer status (VAR_ROAMER_*_STATUS) is 0;
+- after a battle the status is 1 if it was caught and 2 otherwise, as the game's own roamers have it, and the
+  map's resume script hides the beast that was fought (it hid only the static Suicune before);
+- after the Hall of Fame, the game sets a beaten beast's status back to 0 and called create_roamer; now it only
+  resets the status.
+
+Saves that had already woken the beasts in an earlier version keep them roaming.
+
+It needs the vanilla dump (make dump_scripts, as for fossil_reviver.py); run after legendaries.py:
+    python3 tools/hack/beasts_stay.py /path/to/dumped/hg-engine
+"""
+import json
+import os
+import sys
+
+B1F_SCRIPT = "data/scr_seq/scr_seq_0024_D18R0102.s"
+B1F_HEADER = "data/scr_seq/scr_seq_0285_D18R0102_hdr.s"
+B1F_INCLUDE = "data/scr_seq/include/event_D18R0102.inc"
+B1F_EVENTS = "data/eventdata/zone_event/204_D18R0102.json"
+HALL_OF_FAME = "data/scr_seq/scr_seq_0825_T10R0701.s"
+HALL_OF_FAME_INCLUDE = "data/scr_seq/include/event_T10R0701.inc"   # unchanged, but the script needs it beside it
+LEVEL = 46
+BEASTS = [  # (name, species, roamer status variable, hidden flag, script, object, tile)
+    ("raikou", "SPECIES_RAIKOU", "VAR_ROAMER_RAIKOU_STATUS", "FLAG_UNK_A32", 3, 13, (14, 14)),
+    ("entei", "SPECIES_ENTEI", "VAR_ROAMER_ENTEI_STATUS", "FLAG_UNK_A33", 4, 14, (16, 14)),
+]
+ON_ENTER = 5
+
+BATTLE = """
+// {name} waits here (tools/hack/beasts_stay.py): caught, its roamer status is 1; beaten or fled from, 2
+scr_seq_D18R0102_{n:03d}:
+	play_se SEQ_SE_DP_SELECT
+	lockall
+	faceplayer
+	play_cry {species}, 0
+	wait_cry
+	setvar VAR_TEMP_x4003, {which}
+	setflag FLAG_ENGAGING_STATIC_POKEMON
+	wild_battle {species}, {level}, 0
+	clearflag FLAG_ENGAGING_STATIC_POKEMON
+	check_battle_won VAR_SPECIAL_RESULT
+	compare VAR_SPECIAL_RESULT, 0
+	goto_if_eq _beasts_white_out
+	setvar {status}, 2
+	get_static_encounter_outcome VAR_TEMP_x4002
+	compare VAR_TEMP_x4002, 4
+	goto_if_ne _beasts_{name}_done
+	setvar {status}, 1
+_beasts_{name}_done:
+	releaseall
+	end
+"""
+
+ENTER = """
+// on entering B1F (tools/hack/beasts_stay.py): Raikou and Entei wait here once the scene has woken them, while
+// their roamer status is 0
+scr_seq_D18R0102_{n:03d}:
+	goto_if_unset FLAG_HIDE_BURNED_TOWER_B1F_RAIKOU, _beasts_asleep
+	setflag FLAG_UNK_A32
+	compare VAR_ROAMER_RAIKOU_STATUS, 0
+	goto_if_ne _beasts_entei
+	clearflag FLAG_UNK_A32
+_beasts_entei:
+	setflag FLAG_UNK_A33
+	compare VAR_ROAMER_ENTEI_STATUS, 0
+	goto_if_ne _beasts_entered
+	clearflag FLAG_UNK_A33
+_beasts_entered:
+	end
+
+_beasts_asleep:
+	setflag FLAG_UNK_A32
+	setflag FLAG_UNK_A33
+	end
+
+_beasts_white_out:
+	white_out
+	releaseall
+	end
+"""
+
+RESUME_OLD = """_001B:
+	setflag FLAG_HIDE_BURNED_TOWER_STATIC_SUICUNE
+	hide_person obj_D18R0102_follower_mon_static_suicune_2
+	clearflag FLAG_ENGAGING_STATIC_POKEMON
+	end
+"""
+RESUME_NEW = """_001B:
+	compare VAR_TEMP_x4003, 1
+	goto_if_eq _beasts_hide_raikou
+	compare VAR_TEMP_x4003, 2
+	goto_if_eq _beasts_hide_entei
+	setflag FLAG_HIDE_BURNED_TOWER_STATIC_SUICUNE
+	hide_person obj_D18R0102_follower_mon_static_suicune_2
+	clearflag FLAG_ENGAGING_STATIC_POKEMON
+	end
+
+_beasts_hide_raikou:
+	setvar VAR_TEMP_x4003, 0
+	setflag FLAG_UNK_A32
+	hide_person obj_D18R0102_raikou
+	clearflag FLAG_ENGAGING_STATIC_POKEMON
+	end
+
+_beasts_hide_entei:
+	setvar VAR_TEMP_x4003, 0
+	setflag FLAG_UNK_A33
+	hide_person obj_D18R0102_entei
+	clearflag FLAG_ENGAGING_STATIC_POKEMON
+	end
+"""
+
+
+def replace(text, old, new, path):
+    if text.count(old) != 1:
+        sys.exit("expected exactly one of this in %s: %r" % (path, old[:70]))
+    return text.replace(old, new)
+
+
+def main():
+    dump = sys.argv[1]
+
+    def read(path):
+        source = path if os.path.exists(path) else os.path.join(dump, path)
+        return open(source, encoding="utf-8", newline="").read()
+
+    out = {}
+    script = read(B1F_SCRIPT)
+    script = replace(script, "\tcreate_roamer 0\n\tcreate_roamer 1\n", "", B1F_SCRIPT)
+    script = replace(script, RESUME_OLD, RESUME_NEW, B1F_SCRIPT)
+    script = replace(script, "scrdef_end", "".join("scrdef scr_seq_D18R0102_%03d\n" % n
+                                                   for n in (3, 4, ON_ENTER)) + "scrdef_end", B1F_SCRIPT)
+    script = script.rstrip("\n") + "\n"
+    for which, (name, species, status, flag, n, obj, tile) in enumerate(BEASTS, 1):
+        script += BATTLE.format(name=name, species=species, status=status, n=n, which=which, level=LEVEL)
+    script += ENTER.format(n=ON_ENTER)
+    out[B1F_SCRIPT] = script
+
+    header = read(B1F_HEADER)
+    # type 2: run on entering, before the map's people are placed, as the game's own scripts that set hidden flags
+    header = replace(header, "\t.byte 0\n", "\t.byte 2\n\t.hword %d, 0\n\t.byte 0\n" % (ON_ENTER + 1), B1F_HEADER)
+    out[B1F_HEADER] = header
+
+    include = read(B1F_INCLUDE)
+    include = replace(include, "\n\n.equ obj_D18R0102_follower_mon_static_suicune,",
+                      "\n" + "".join(".equ _EV_scr_seq_D18R0102_%03d, %d\n" % (n, n) for n in (3, 4, ON_ENTER))
+                      + "\n.equ obj_D18R0102_follower_mon_static_suicune,", B1F_INCLUDE)
+    include = replace(include, "\n\n.endif", "\n" + "".join(".equ obj_D18R0102_%s, %d\n" % (b[0], b[5]) for b in BEASTS)
+                      + "\n.endif", B1F_INCLUDE)
+    out[B1F_INCLUDE] = include
+
+    events = json.loads(read(B1F_EVENTS))
+    if len(events["object_events"]) != BEASTS[0][5]:
+        sys.exit("unexpected number of objects in the Burned Tower B1F")
+    for name, species, status, flag, n, obj, tile in BEASTS:
+        events["object_events"].append({
+            "id": "obj_D18R0102_%s" % name,
+            "graphics_id": "SPRITE_FOLLOWER_MON_STATIC_%s" % name.upper(),
+            "movement_type": 15,
+            "trainer_type": 0,
+            "hidden_flag": flag,
+            "script": "_EV_scr_seq_D18R0102_%03d + 1" % n,
+            "initial_dir": 1,
+            "param0": 0, "param1": 0, "param2": 0,
+            "movement_range_x": 0, "movement_range_z": 0,
+            "x": tile[0], "z": tile[1], "y": 0,
+        })
+    out[B1F_EVENTS] = json.dumps(events, indent=2) + "\n"
+
+    hall = read(HALL_OF_FAME)
+    hall = replace(hall, "\tsetvar VAR_ROAMER_ENTEI_STATUS, 0\n\tcreate_roamer 1\n", "\tsetvar VAR_ROAMER_ENTEI_STATUS, 0\n", HALL_OF_FAME)
+    hall = replace(hall, "\tsetvar VAR_ROAMER_RAIKOU_STATUS, 0\n\tcreate_roamer 0\n", "\tsetvar VAR_ROAMER_RAIKOU_STATUS, 0\n", HALL_OF_FAME)
+    out[HALL_OF_FAME] = hall
+    out[HALL_OF_FAME_INCLUDE] = read(HALL_OF_FAME_INCLUDE)
+
+    for path, content in out.items():
+        os.makedirs(os.path.dirname(path), exist_ok=True)
+        open(path, "w", encoding="utf-8", newline="").write(content)
+        print("wrote", path)
+
+
+if __name__ == "__main__":
+    main()
