-	create_roamer 1
 	wait 15, VAR_SPECIAL_RESULT
 	clearflag FLAG_HIDE_BURNED_TOWER_B1F_EUSINE
 	play_se SEQ_SE_DP_KAIDAN2
@@ -290,3 +309,75 @@ _0362:
 	setflag FLAG_CAUGHT_SUICUNE
 	return
 	.balign 4
+
+// raikou waits here (tools/hack/beasts_stay.py): caught, its roamer status is 1; beaten or fled from, 2
+scr_seq_D18R0102_003:
+	play_se SEQ_SE_DP_SELECT
+	lockall
+	faceplayer
+	play_cry SPECIES_RAIKOU, 0
+	wait_cry
+	setvar VAR_TEMP_x4003, 1
+	setflag FLAG_ENGAGING_STATIC_POKEMON
+	wild_battle SPECIES_RAIKOU, 46, 0
+	clearflag FLAG_ENGAGING_STATIC_POKEMON
+	check_battle_won VAR_SPECIAL_RESULT
+	compare VAR_SPECIAL_RESULT, 0
+	goto_if_eq _beasts_white_out
+	setvar VAR_ROAMER_RAIKOU_STATUS, 2
+	get_static_encounter_outcome VAR_TEMP_x4002
+	compare VAR_TEMP_x4002, 4
+	goto_if_ne _beasts_raikou_done
+	setvar VAR_ROAMER_RAIKOU_STATUS, 1
+_beasts_raikou_done:
+	releaseall
+	end
+
+// entei waits here (tools/hack/beasts_stay.py): caught, its roamer status is 1; beaten or fled from, 2
+scr_seq_D18R0102_004:
+	play_se SEQ_SE_DP_SELECT
+	lockall
+	faceplayer
+	play_cry SPECIES_ENTEI, 0
+	wait_cry
+	setvar VAR_TEMP_x4003, 2
+	setflag FLAG_ENGAGING_STATIC_POKEMON
+	wild_battle SPECIES_ENTEI, 46, 0
+	clearflag FLAG_ENGAGING_STATIC_POKEMON
+	check_battle_won VAR_SPECIAL_RESULT
+	compare VAR_SPECIAL_RESULT, 0
+	goto_if_eq _beasts_white_out
+	setvar VAR_ROAMER_ENTEI_STATUS, 2
+	get_static_encounter_outcome VAR_TEMP_x4002
+	compare VAR_TEMP_x4002, 4
+	goto_if_ne _beasts_entei_done
+	setvar VAR_ROAMER_ENTEI_STATUS, 1
+_beasts_entei_done:
+	releaseall
+	end
+
+// on entering B1F (tools/hack/beasts_stay.py): Raikou and Entei wait here once the scene has woken them, while
+// their roamer status is 0
+scr_seq_D18R0102_005:
+	goto_if_unset FLAG_HIDE_BURNED_TOWER_B1F_RAIKOU, _beasts_asleep
+	setflag FLAG_UNK_A32
+	compare VAR_ROAMER_RAIKOU_STATUS, 0
+	goto_if_ne _beasts_entei
+	clearflag FLAG_UNK_A32
+_beasts_entei:
+	setflag FLAG_UNK_A33
+	compare VAR_ROAMER_ENTEI_STATUS, 0
+	goto_if_ne _beasts_entered
+	clearflag FLAG_UNK_A33
+_beasts_entered:
+	end
+
+_beasts_asleep:
+	setflag FLAG_UNK_A32
+	setflag FLAG_UNK_A33
+	end
+
+_beasts_white_out:
+	white_out
+	releaseall
+	end
