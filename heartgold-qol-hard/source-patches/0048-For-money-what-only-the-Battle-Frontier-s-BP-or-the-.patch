index 000000000..6ce7ab132
--- /dev/null
+++ b/tools/hack/gap_items.py
@@ -0,0 +1,62 @@
+#!/usr/bin/env python3
+"""For money, what only the Battle Frontier's BP or the Pokewalker gave.
+
+The Battle Frontier's Exchange Service Corner (scr_seq_0076_D32.s) trades 42 prizes for BP. Its vitamins, Rare
+Candy, Power items and held items the hack already sells, and some of its TMs are gifts or lie on the ground,
+but nine TMs were BP-only. The Pokewalker's routes (overlay 112's course table) hold 156 items; the useful ones
+found nowhere else are the five pinch berries, the four weather rocks and four kinds of Poke Ball. All these are
+now sold:
+
+- Goldenrod Department Store 5F (TMs): Toxic, Thunder Wave and Will-O-Wisp (P10,000), Brick Break, Bulk Up and
+  Calm Mind (P20,000) from four badges; Energy Ball and X-Scissor (P20,000) and Stone Edge (P30,000) from six;
+- Goldenrod Department Store 3F (berries): Liechi, Ganlon, Salac, Petaya and Apicot Berries from six badges,
+  P2,000;
+- Goldenrod Department Store 2F (balls): Dive, Luxury, Repeat and Timer Balls from two badges, P1,000;
+- Celadon Department Store 4F (held items, after the Champion): Damp, Heat, Icy and Smooth Rocks, P10,000.
+
+    python3 tools/hack/gap_items.py
+"""
+import re
+import sys
+
+MART = "src/field/mart.c"
+ITEMS = "data/itemdata/itemdata.c"
+STOCK = {  # counter: [(item, price, badges needed)]
+    "sGoldenrodDepartment5F": [("TM006", 10000, 4), ("TM073", 10000, 4), ("TM061", 10000, 4), ("TM031", 20000, 4),
+                               ("TM008", 20000, 4), ("TM004", 20000, 4), ("TM053", 20000, 6), ("TM081", 20000, 6),
+                               ("TM071", 30000, 6)],
+    "sGoldenrodDepartment3F": [(b + "_BERRY", 2000, 6) for b in ("LIECHI", "GANLON", "SALAC", "PETAYA", "APICOT")],
+    "sGoldenrodDepartmentLower2F": [(b + "_BALL", 1000, 2) for b in ("DIVE", "LUXURY", "REPEAT", "TIMER")],
+    "sCeladonDepartment4F": [(r + "_ROCK", 10000, 0) for r in ("DAMP", "HEAT", "ICY", "SMOOTH")],
+}
+
+
+def main():
+    mart, items = open(MART).read(), open(ITEMS).read()
+    for array, stock in STOCK.items():
+        m = re.search(r"(u16 %s\[\] = \{\n)([^}]*?)(,\s*0xFFFF\n\};)" % array, mart)
+        if not m:
+            sys.exit("no " + array)
+        if "ITEM_" + stock[0][0] + "," in m.group(2) or "ITEM_" + stock[0][0] + "\n" in m.group(2):
+            sys.exit("already stocked: " + array)
+        names = [n for n, _, _ in stock]
+        added = ",\n    ".join(", ".join("ITEM_" + n for n in names[i:i + 6]) for i in range(0, len(names), 6))
+        mart = mart.replace(m.group(0), "%s%s,\n    // only the Battle Frontier or the Pokewalker gave these (tools/hack/gap_items.py)\n"
+                            "    %s, 0xFFFF\n};" % (m.group(1), m.group(2), added))
+        for name, price, _ in stock:
+            m = re.search(r"\n\[ITEM_%s\] =\n\{\n    ITEM_PRICE\(\d+\)" % name, items)
+            if not m:
+                sys.exit("no item data for " + name)
+            items = items[:m.start()] + re.sub(r"ITEM_PRICE\(\d+\)", "ITEM_PRICE(%d)" % price, m.group(0)) + items[m.end():]
+    head = "const struct BadgeMartItems sBadgeLockedMartItems[] = {\n"
+    if head not in mart:
+        sys.exit("no sBadgeLockedMartItems")
+    mart = mart.replace(head, head + "    // only the Battle Frontier or the Pokewalker gave these (tools/hack/gap_items.py)\n"
+                        + "".join("    { ITEM_%s, %d },\n" % (n, b) for stock in STOCK.values() for n, _, b in stock if b))
+    open(MART, "w").write(mart)
+    open(ITEMS, "w").write(items)
+    print("stocked", ", ".join(STOCK))
+
+
+if __name__ == "__main__":
+    main()
