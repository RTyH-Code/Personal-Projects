+#!/usr/bin/env python3
+"""Late-game trainers' Pokemon evolve where their level allows.
+
+The level scaling left ordinary trainers with Pokemon far past their
+evolutions: a Lv. 78 Metapod, a Lv. 85 Magikarp. Same rules as the FireRed
+hack:
+
+- Lv. 50 and up: a Pokemon at least 5 levels past a level-up evolution
+  evolves, step by step along its family.
+- Lv. 50 and up: stone, held-item and friendship evolutions between Pokemon
+  of the first three generations happen too (Raichu, Crobat, Scizor).
+- Lv. 75 and up: every other evolution as well (Rhyperior, Magnezone).
+
+Early and mid-game teams keep their unevolved Pokemon, as in the original.
+The hand-built boss teams are not touched. Evolutions that depend on the
+Pokemon's gender are left alone, since a trainer's Pokemon gets its gender
+from the trainer. Where a Pokemon has several evolutions the trainer's
+number picks one, so Eevee does not always become the same thing. Custom
+movesets are kept.
+
+    python3 tools/hack/trainer_evolutions.py
+"""
+import re
+
+TRAINERS = "data/Trainers.c"
+EVOLUTIONS = "data/Evolutions.c"
+SPECIES_H = "include/constants/species.h"
+MIN_LEVEL, GRACE, TOP_LEVEL = 50, 5, 75
+BOSS = re.compile(r"LEADER_|ELITE_FOUR_|CHAMPION|RIVAL|PKMN_TRAINER_RED|EXECUTIVE|KIMONO_GIRL|PKMN_TRAINER_LANCE")
+LEVEL_METHODS = {"EVO_LEVEL", "EVO_LEVEL_ATK_GT_DEF", "EVO_LEVEL_ATK_EQ_DEF", "EVO_LEVEL_ATK_LT_DEF",
+                 "EVO_LEVEL_PID_LO", "EVO_LEVEL_PID_HI", "EVO_LEVEL_NINJASK"}
+SKIP = {"EVO_NONE", "EVO_LEVEL_SHEDINJA", "EVO_LEVEL_MALE", "EVO_LEVEL_FEMALE", "EVO_STONE_MALE", "EVO_STONE_FEMALE"}
+# the later evolutions this hack adds for Johto and Kanto Pokemon
+ADDED = {"KLEAVOR", "URSALUNA", "ANNIHILAPE", "WYRDEER", "FARIGIRAF", "DUDUNSPARCE", "SYLVEON"}
+
+
+def main():
+    ids = {n: int(v) for n, v in re.findall(r"#define SPECIES_(\w+)\s+\(?(\d+)\)?\s*$", open(SPECIES_H).read(), re.M)}
+    in_game = lambda s: ids.get(s, 9999) <= 493 or s in ADDED
+    by_level, classic, other = {}, {}, {}
+    for m in re.finditer(r"^    \[SPECIES_(\w+)\] = \{(.*?)^    \},", open(EVOLUTIONS).read(), re.S | re.M):
+        base = m.group(1)
+        for method, param, target in re.findall(r"\{ (EVO_\w+), (\w+), SPECIES_(\w+) \}", m.group(2)):
+            if method in SKIP or not in_game(target) or not in_game(base):
+                continue
+            if method in LEVEL_METHODS:
+                by_level.setdefault(base, []).append((int(param), target))
+            elif ids[base] <= 386 and ids[target] <= 386:
+                classic.setdefault(base, []).append(target)
+            else:
+                other.setdefault(base, []).append(target)
+
+    def evolve(species, level, pick):
+        for _ in range(3):
+            if species in by_level and level >= min(l for l, _ in by_level[species]) + GRACE:
+                options = [t for l, t in by_level[species] if level >= l + GRACE]
+                species = options[pick % len(options)]
+            elif species in classic:
+                species = classic[species][pick % len(classic[species])]
+            elif species in other and level >= TOP_LEVEL:
+                species = other[species][pick % len(other[species])]
+            else:
+                break
+        return species
+
+    changed = trainers = 0
+
+    def trainer(match):
+        nonlocal changed, trainers
+        number, body = int(match.group(1)), match.group(0)
+        if BOSS.search(re.search(r"\.trainerClass = TRAINERCLASS_(\w+)", body).group(1)):
+            return body
+        before = changed
+
+        def mon(m):
+            nonlocal changed
+            level = int(re.search(r"\.level = (\d+)", m.group(0)).group(1))
+            species = re.search(r"\.species = SPECIES_(\w+)", m.group(0)).group(1)
+            if level < MIN_LEVEL:
+                return m.group(0)
+            new = evolve(species, level, number)
+            if new == species:
+                return m.group(0)
+            changed += 1
+            return m.group(0).replace(".species = SPECIES_%s," % species, ".species = SPECIES_%s," % new)
+        body = re.sub(r"\{\n\s+\.ivs = .*?\n\s+\},", mon, body, flags=re.S)
+        trainers += changed > before
+        return body
+
+    text = re.sub(r"^    \[(\d+)\] = \{\n.*?^    \},\n", trainer, open(TRAINERS).read(), flags=re.S | re.M)
+    open(TRAINERS, "w").write(text)
+    print("%d Pokemon of %d trainers evolved" % (changed, trainers))
+
+
+if __name__ == "__main__":
+    main()
