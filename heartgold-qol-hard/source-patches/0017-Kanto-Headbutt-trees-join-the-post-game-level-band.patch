+++ b/tools/hack/kanto_headbutt.py
@@ -0,0 +1,66 @@
+#!/usr/bin/env python3
+"""Kanto Headbutt trees for the post-game.
+
+kanto_wild.py moved Kanto's grass, cave, surfing, Rock Smash and fishing
+Pokemon into a post-game level band but left the Headbutt trees at their
+original levels (Lv. 2-6 on Route 1). This gives the trees of Kanto the same
+band and the same rule: a Pokemon past a plain level-up evolution appears
+evolved. Johto's trees are not touched.
+
+Run once from the hg-engine root, after kanto_wild.py:
+    python3 tools/hack/kanto_headbutt.py
+"""
+import re
+
+from kanto_wild import evolve, kanto_level, load_evolutions
+
+HEADBUTT = "data/Headbutt.c"
+TOWNS = ("pallet", "viridian", "pewter", "cerulean", "lavender", "vermilion", "celadon", "fuchsia", "cinnabar",
+         "saffron")
+
+
+def table_name(area):
+    """The name kanto_level() knows a Kanto area by, or None for an area in Johto."""
+    if area.startswith("mtSilver"):
+        return "MT_SILVER"
+    # some areas have a second entry whose name ends in its three-digit number (route2414 is Route 2)
+    route = re.fullmatch(r"route(\d{1,2}?)(\d{3})?", area)
+    if route:
+        number = int(route.group(1))
+        return "ROUTE_%d" % number if number <= 25 or number == 28 else None
+    return area.upper() if area.startswith(TOWNS) else None
+
+
+def main():
+    evolutions = load_evolutions()
+    text = open(HEADBUTT).read()
+    areas = evolved = 0
+
+    def rewrite(match):
+        nonlocal areas, evolved
+        table = table_name(match.group(1))
+        if table is None or "SPECIES_" not in match.group(0):
+            return match.group(0)
+        changed = False
+
+        def slot(s):
+            nonlocal evolved, changed
+            name, low, high = s.group(1), int(s.group(2)), int(s.group(3))
+            if name == "NONE":
+                return s.group(0)
+            changed = True
+            low, high = kanto_level(low, table), kanto_level(high, table)
+            new = evolve(name, low, evolutions)
+            evolved += new != name
+            return "{ SPECIES_%s, %d, %d }" % (new, low, high)
+        body = re.sub(r"\{ SPECIES_(\w+), (\d+), (\d+) \}", slot, match.group(0))
+        areas += changed
+        return body
+
+    text = re.sub(r"^    \.(\w+) = \{\n.*?^    \},\n", rewrite, text, flags=re.S | re.M)
+    open(HEADBUTT, "w").write(text)
+    print("%d Kanto Headbutt areas, %d slots now hold an evolved Pokemon" % (areas, evolved))
+
+
+if __name__ == "__main__":
+    main()
