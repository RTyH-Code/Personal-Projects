+#!/usr/bin/env python3
+"""The Move Reminder for free, and a second one from the start.
+
+HeartGold's Move Maniac, in a house in Blackthorn City, makes a Pokemon remember a move it could have learned by
+level for one Heart Scale each time. This makes him free, and puts a second reminder, a woman doing the same, in
+Cherrygrove City's Pokemon Center, so moves can be remembered from the first town on.
+
+It needs the vanilla dump of both maps (make dump_scripts, as for fossil_reviver.py):
+    python3 tools/hack/move_reminder.py /path/to/dumped/hg-engine
+"""
+import json
+import os
+import sys
+
+# Blackthorn City's Move Maniac (T30R0601's script 1), and his lines in text bank 635
+MANIAC_SCRIPT = "data/scr_seq/scr_seq_0948_T30R0601.s"
+MANIAC_INCLUDE = "data/scr_seq/include/event_T30R0601.inc"     # unchanged, but the script needs it beside it
+MANIAC_TEXT = "data/text/custom/635.txt"
+MANIAC_LINES = {
+    9: r"Me?\nI’m the Pokémon Move Maniac.\rI know every move that Pokémon learn\nwhile they’re leveling up, and I can\f"
+       r"make Pokémon remember those moves.\rAnd I’ll do it for free, as often\nas you like!\r",
+    10: r"Want me to make one of your Pokémon\nremember a move?\r",
+    11: r"If any of your Pokémon needs to\nremember a move, come back any time.",
+    25: r"There! Come back whenever another\nmove needs remembering.",
+}
+
+# Cherrygrove City's Pokemon Center: a second reminder, its script 6 and object 10, in text bank 552
+CENTER_SCRIPT = "data/scr_seq/scr_seq_0852_T21PC0101.s"
+CENTER_INCLUDE = "data/scr_seq/include/event_T21PC0101.inc"
+CENTER_EVENTS = "data/eventdata/zone_event/066_T21PC0101.json"
+CENTER_TEXT = "data/text/custom/552.txt"
+NEW_SCRIPT = 6
+NEW_OBJECT = 10
+POSITION = (1, 10)          # the corridor down the left wall, out of everyone's way; she faces right, into it
+
+CENTER_LINES = [
+    r"I make Pokémon remember moves they\ncould have learned as they leveled up.\rIt’s free, as often as you like!\r"
+    r"Which Pokémon needs tutoring?\r",
+    r"Which move should I make it remember?\r",
+    r"There! Come back whenever another\nmove needs remembering.",
+    r"Come back if one of your Pokémon\nneeds to remember a move.",
+    r"Sorry...\rThere isn’t any move I can make\nthat Pokémon remember.",
+    r"An Egg can’t remember a move.\nIt hasn’t even hatched!",
+]
+
+CENTER_REMINDER = """
+// a second Move Reminder, free (tools/hack/move_reminder.py)
+scr_seq_T21PC0101_{n:03d}:
+	play_se SEQ_SE_DP_SELECT
+	lockall
+	faceplayer
+	npc_msg {m0}
+	closemsg
+	fade_screen 6, 1, 0, RGB_BLACK
+	wait_fade
+	party_select_ui
+	get_party_selection VAR_SPECIAL_x8005
+	restore_overworld
+	fade_screen 6, 1, 1, RGB_BLACK
+	wait_fade
+	compare VAR_SPECIAL_x8005, 255
+	goto_if_eq _reminder_bye
+	get_partymon_species VAR_SPECIAL_x8005, VAR_SPECIAL_RESULT
+	compare VAR_SPECIAL_RESULT, 0
+	goto_if_eq _reminder_egg
+	scrcmd_466 VAR_SPECIAL_RESULT, VAR_SPECIAL_x8005
+	compare VAR_SPECIAL_RESULT, 0
+	goto_if_eq _reminder_none
+	npc_msg {m1}
+	closemsg
+	fade_screen 6, 1, 0, RGB_BLACK
+	wait_fade
+	move_relearner_init VAR_SPECIAL_x8005
+	move_relearner_get_result VAR_SPECIAL_RESULT
+	restore_overworld
+	fade_screen 6, 1, 1, RGB_BLACK
+	wait_fade
+	compare VAR_SPECIAL_RESULT, 255
+	goto_if_eq _reminder_bye
+	npc_msg {m2}
+	wait_button
+	closemsg
+	releaseall
+	end
+
+_reminder_bye:
+	npc_msg {m3}
+	wait_button
+	closemsg
+	releaseall
+	end
+
+_reminder_none:
+	npc_msg {m4}
+	wait_button
+	closemsg
+	releaseall
+	end
+
+_reminder_egg:
+	npc_msg {m5}
+	wait_button
+	closemsg
+	releaseall
+	end
+"""
+
+
+def read_lines(text):
+    lines = text.split("\r\n")
+    if lines[-1] == "":
+        lines.pop()
+    return lines
+
+
+def replace(text, old, new):
+    if text.count(old) != 1:
+        sys.exit("expected exactly one of: %r" % old[:60])
+    return text.replace(old, new)
+
+
+def main():
+    dump = sys.argv[1]
+    read = lambda path: open(os.path.join(dump, path), encoding="utf-8", newline="").read()
+    out = {}
+
+    # the Move Maniac: no Heart Scale asked for or taken; and his first meeting goes on to choosing a Pokemon
+    script = read(MANIAC_SCRIPT)
+    script = replace(script, "\thasitem ITEM_HEART_SCALE, 1, VAR_SPECIAL_RESULT\n\tcompare VAR_SPECIAL_RESULT, 0\n"
+                     "\tgoto_if_eq _022D\n", "")
+    script = replace(script, "\tnpc_msg 10\n\tnpc_msg 12\n", "\tnpc_msg 10\n_maniac_choose:\n\tnpc_msg 12\n")
+    script = replace(script, "\ttakeitem ITEM_HEART_SCALE, 1, VAR_SPECIAL_RESULT\n\tbuffer_players_name 3\n", "")
+    script = replace(script, "_0238:\n\tnpc_msg 9\n\twait_button\n\tclosemsg\n\treleaseall\n\tsetflag FLAG_MET_MOVE_MANIAC\n\tend",
+                     "_0238:\n\tsetflag FLAG_MET_MOVE_MANIAC\n\tnpc_msg 9\n\tgoto _maniac_choose")
+    out[MANIAC_SCRIPT] = script
+    out[MANIAC_INCLUDE] = read(MANIAC_INCLUDE)
+    text = read_lines(read(MANIAC_TEXT))
+    for i, line in MANIAC_LINES.items():
+        text[i] = line
+    out[MANIAC_TEXT] = "\r\n".join(text) + "\r\n"
+
+    # the second reminder
+    text = read_lines(read(CENTER_TEXT))
+    first = len(text)
+    text += CENTER_LINES
+    out[CENTER_TEXT] = "\r\n".join(text) + "\r\n"
+    numbers = {"m%d" % k: first + k for k in range(len(CENTER_LINES))}
+    script = read(CENTER_SCRIPT)
+    script = replace(script, "scrdef_end", "scrdef scr_seq_T21PC0101_%03d\nscrdef_end" % NEW_SCRIPT)
+    out[CENTER_SCRIPT] = script.rstrip("\n") + "\n" + CENTER_REMINDER.format(n=NEW_SCRIPT, **numbers)
+    include = read(CENTER_INCLUDE)
+    include = replace(include, "\n\n.equ obj_T21PC0101_pcwoman1,",
+                      "\n.equ _EV_scr_seq_T21PC0101_%03d, %d\n\n.equ obj_T21PC0101_pcwoman1," % (NEW_SCRIPT, NEW_SCRIPT))
+    include = replace(include, "\n\n.endif", "\n.equ obj_T21PC0101_reminder, %d\n\n.endif" % NEW_OBJECT)
+    out[CENTER_INCLUDE] = include
+    events = json.loads(read(CENTER_EVENTS))
+    if len(events["object_events"]) != NEW_OBJECT:
+        sys.exit("unexpected number of objects in Cherrygrove's Pokemon Center")
+    events["object_events"].append({
+        "id": "obj_T21PC0101_reminder",
+        "graphics_id": "SPRITE_GSWOMAN1",
+        "movement_type": 15,
+        "trainer_type": 0,
+        "hidden_flag": "FLAG_NOTHING",
+        "script": "_EV_scr_seq_T21PC0101_%03d + 1" % NEW_SCRIPT,
+        "initial_dir": 3,      # facing right, into the corridor
+        "param0": 0, "param1": 0, "param2": 0,
+        "movement_range_x": 0, "movement_range_z": 0,
+        "x": POSITION[0], "z": POSITION[1], "y": 0,
+    })
+    out[CENTER_EVENTS] = json.dumps(events, indent=2) + "\n"
+
+    for path, content in out.items():
+        os.makedirs(os.path.dirname(path), exist_ok=True)
+        open(path, "w", encoding="utf-8", newline="").write(content)
+        print("wrote", path)
+
+
+if __name__ == "__main__":
+    main()
-- 
