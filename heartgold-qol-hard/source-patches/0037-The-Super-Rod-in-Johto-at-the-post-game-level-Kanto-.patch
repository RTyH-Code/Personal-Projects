+#!/usr/bin/env python3
+"""The Super Rod in Johto at the post-game level Kanto's has.
+
+The Super Rod is a post-game item, from the Fishing Guru on Kanto's Route 12,
+and a team is around Lv. 62-70 when it has one. kanto_wild.py put Kanto's
+Super Rod Pokemon at 62 (and Mt. Silver's at 68), but Johto's water kept
+HeartGold's 40 in all 39 of its tables. They move to 62 too. The Old and Good
+Rods (extra_wild.py) and the Safari Zone, whose levels grow with its own
+block system, are unchanged.
+
+Run once from the hg-engine root, after extra_wild.py:
+    python3 tools/hack/super_rod.py
+"""
+import re
+
+ENCOUNTERS = "data/Encounters.c"
+OLD, NEW = 40, 62
+
+
+def main():
+    text = open(ENCOUNTERS).read()
+    done = []
+
+    def table(m):
+        body = m.group(0)
+        rod = re.search(r"\.superRodSlots = \{.*?\n        \},", body, re.S)
+        slots = re.findall(r"\{ (\d+), (\d+), SPECIES_(\w+) \}", rod.group(0))
+        real = [(int(a), int(b)) for a, b, s in slots if s != "NONE"]
+        if not real or {x for pair in real for x in pair} != {OLD}:
+            return body
+        done.append(m.group(1))
+        new = rod.group(0).replace("{ %d, %d, SPECIES_" % (OLD, OLD), "{ %d, %d, SPECIES_" % (NEW, NEW))
+        return body[:rod.start()] + new + body[rod.end():]
+    text = re.sub(r"^    \[ENCDATA_(\w+)\] = \{\n.*?^    \},\n", table, text, flags=re.S | re.M)
+    open(ENCOUNTERS, "w").write(text)
+    print("Super Rod Lv. %d -> %d in %d tables: %s" % (OLD, NEW, len(done), ", ".join(done)))
+
+
+if __name__ == "__main__":
+    main()
