index 000000000..ee3f28fb9
--- /dev/null
+++ b/tools/hack/catch_up.py
@@ -0,0 +1,52 @@
+#!/usr/bin/env python3
+"""Catching up on levels, and hidden abilities for the player.
+
+From trainer battles alone a full team of six is a few levels short of the
+bosses from Jasmine to the Elite Four and far short of Red, and nothing in
+the game gives the player a hidden ability although some bosses have one.
+
+- Goldenrod Department Store 3F sells the Lucky Egg from four badges.
+- Celadon Department Store 4F, which is past the Champion, sells Rare
+  Candies, the Ability Capsule and the Ability Patch.
+
+Run after shops.py, from the hg-engine root:
+    python3 tools/hack/catch_up.py
+"""
+import re
+import sys
+
+MART = "src/field/mart.c"
+ITEMS = "data/itemdata/itemdata.c"
+GOLDENROD = [("LUCKY_EGG", 5000, 4)]                       # item, price, badges needed
+CELADON = [("RARE_CANDY", 3000), ("ABILITY_CAPSULE", 10000), ("ABILITY_PATCH", 25000)]
+
+
+def main():
+    mart, items = open(MART).read(), open(ITEMS).read()
+    if "ITEM_RARE_CANDY" in re.search(r"sCeladonDepartment4F\[\] = \{(.*?)\};", mart, re.S).group(1):
+        sys.exit("already done")
+
+    def extend(text, array, names):
+        m = re.search(r"(u16 %s\[\] = \{\n.*?)(, 0xFFFF\n\};)" % array, text, re.S)
+        if not m:
+            sys.exit("no " + array)
+        return text.replace(m.group(0), m.group(1) + ",\n    " + ", ".join("ITEM_" + n for n in names) + m.group(2))
+
+    mart = extend(mart, "sGoldenrodDepartment3F", [n for n, _, _ in GOLDENROD])
+    mart = extend(mart, "sCeladonDepartment4F", [n for n, _ in CELADON])
+    head = "const struct BadgeMartItems sBadgeLockedMartItems[] = {\n"
+    if head not in mart:
+        sys.exit("no sBadgeLockedMartItems")
+    mart = mart.replace(head, head + "".join("    { ITEM_%s, %d },\n" % (n, b) for n, _, b in GOLDENROD))
+    for name, price in [(n, p) for n, p, _ in GOLDENROD] + CELADON:
+        items, n = re.subn(r"(\[ITEM_%s\] =\n\{\n    ITEM_PRICE\()\d+(\))" % name,
+                           lambda m: m.group(1) + str(price) + m.group(2), items)
+        if n != 1:
+            sys.exit("no price for " + name)
+    open(MART, "w").write(mart)
+    open(ITEMS, "w").write(items)
+    print("Goldenrod 3F: %s; Celadon 4F: %s" % (", ".join(n for n, _, _ in GOLDENROD), ", ".join(n for n, _ in CELADON)))
+
+
+if __name__ == "__main__":
+    main()
