+#!/usr/bin/env python3
+"""The Pokemon that could only be bred, wild in Johto.
+
+encounters.py gave every family a Johto source, but seven base forms were
+left to breeding from an evolved form caught wild, once the Safari Zone,
+which has them, became something a player can skip: Azurill, Seedot,
+Shroomish, Ponyta, Voltorb, Rhyhorn and Beldum (league_wild.py evolved
+Victory Road's Beldum to Metang). Each is placed by encounters.py's rules
+(only a slot whose species fills another slot too, at that slot's level, no
+more common than asked), where its kind fits and before any later pass
+could evolve it:
+    Route 32           Azurill (rare)
+    Ilex Forest        Seedot, Shroomish (uncommon)
+    Route 36           Ponyta (uncommon)
+    Route 37           Voltorb (rare)
+    Mt. Mortar's central room   Rhyhorn (rare)
+    Dark Cave, Route 45 side   Beldum (very rare), with Gible
+
+Run once from the hg-engine root, after super_rod.py:
+    python3 tools/hack/breeding_wild.py
+"""
+import encounters
+
+LAND = {
+    "ROUTE_32": [("AZURILL", "R", "")],
+    "ILEX_FOREST": [("SEEDOT", "U", ""), ("SHROOMISH", "U", "")],
+    "ROUTE_36": [("PONYTA", "U", "")],
+    "ROUTE_37": [("VOLTORB", "R", "")],
+    "MT_MORTAR_CENTRAL_ROOM": [("RHYHORN", "R", "")],
+    "DARK_CAVE_ROUTE_45_ENTRANCE": [("BELDUM", "V", "")],
+}
+
+
+def main():
+    encounters.LAND, encounters.WATER = LAND, {}
+    encounters.main()
+
+
+if __name__ == "__main__":
+    main()
