@@ -0,0 +1,143 @@
+#!/usr/bin/env python3
+"""Training items in the Goldenrod Department Store: mints, EV-lowering berries, Power items and Bottle Caps.
+
+- 3F (berries): Pomeg, Kelpsy, Qualot, Hondew, Grepa and Tamato Berries, which lower a stat's effort values
+  (the game's own use for them), from the start, at P500.
+- 4F (vitamins): the six Power items, which add effort values to one stat as their holder battles, from four
+  badges, at P5,000.
+- 5F (TMs): the 21 nature mints (hg-engine already makes them work: the Pokemon's stats follow the mint's
+  nature), from four badges, at P5,000; and from eight badges the Bottle Cap (P20,000) and the Gold Bottle Cap
+  (P60,000).
+
+hg-engine has Bottle Caps as items with no use. Here they are used from the bag on a Pokemon, like a mint: a
+Gold Bottle Cap makes all six of its IVs 31; a Bottle Cap makes its lowest IV 31 (the first of the lowest, in
+the order HP, Attack, Defense, Speed, Sp. Atk, Sp. Def). Neither is used up on a Pokemon whose IVs are all 31.
+
+    python3 tools/hack/training_items.py
+"""
+import re
+import sys
+
+MART = "src/field/mart.c"
+ITEMS = "data/itemdata/itemdata.c"
+HANDLER = "src/individual/PartyMenu_HandleUseItemOnMon.c"
+PARTY_TEXT = "data/text/300.txt"
+
+MINTS = ["LONELY", "ADAMANT", "NAUGHTY", "BRAVE", "BOLD", "IMPISH", "LAX", "RELAXED", "MODEST", "MILD", "RASH",
+         "QUIET", "CALM", "GENTLE", "CAREFUL", "SASSY", "TIMID", "HASTY", "JOLLY", "NAIVE", "SERIOUS"]
+STOCK = {  # counter: [(item, price, badges needed)]
+    "sGoldenrodDepartment3F": [(b + "_BERRY", 500, 0) for b in ("POMEG", "KELPSY", "QUALOT", "HONDEW", "GREPA", "TAMATO")],
+    "sGoldenrodDepartment4F": [("POWER_" + p, 5000, 4) for p in ("WEIGHT", "BRACER", "BELT", "LENS", "BAND", "ANKLET")],
+    "sGoldenrodDepartment5F": [(m + "_MINT", 5000, 4) for m in MINTS]
+                              + [("BOTTLE_CAP", 20000, 8), ("GOLD_BOTTLE_CAP", 60000, 8)],
+}
+FIELD_USE_ON_MON = 33       # what the mints have: Use, then choose a Pokemon
+
+CAP_MESSAGES = [
+    r"{STRVAR_1 0, 0, 0}’s potential was brought\nout by the Bottle Cap!\r",
+    r"{STRVAR_1 0, 0, 0}’s potential was fully\nbrought out by the Gold Bottle Cap!\r",
+]
+
+CAP_CODE = '''
+    // handle bottle caps (tools/hack/training_items.py): the gold one makes every IV 31, the plain one the
+    // lowest; neither is used up if every IV is already 31
+
+    if (wk->args->itemId == ITEM_BOTTLE_CAP || wk->args->itemId == ITEM_GOLD_BOTTLE_CAP) {
+        u32 stat, lowest = 0, iv, max = 31;
+        BOOL any = FALSE;
+        for (stat = 0; stat < 6; stat++) {
+            iv = GetMonData(pp, MON_DATA_HP_IV + stat, NULL);
+            if (iv < 31) {
+                if (!any || iv < GetMonData(pp, MON_DATA_HP_IV + lowest, NULL)) {
+                    lowest = stat;
+                }
+                any = TRUE;
+            }
+        }
+        if (any) {
+            void *bag = Sav2_Bag_get(SaveBlock2_get());
+            for (stat = 0; stat < 6; stat++) {
+                if (wk->args->itemId == ITEM_GOLD_BOTTLE_CAP || stat == lowest) {
+                    SetMonData(pp, MON_DATA_HP_IV + stat, &max);
+                }
+            }
+            partyMenuSignal = wk->args->itemId == ITEM_GOLD_BOTTLE_CAP ? %d : %d; // signal to change the message to this index
+            wk->args->species = GetMonData(pp, MON_DATA_FORM, NULL); // no form change
+            RecalcPartyPokemonStats(pp);
+            Bag_TakeItem(bag, wk->args->itemId, 1, 11);
+            sys_FreeMemoryEz(dat);
+            PokeList_FormDemoOverlayLoad(wk);
+            return TRUE;
+        }
+    }
+
+    return FALSE;
+}
+'''
+
+
+def item_block(items, name):
+    m = re.search(r"\n\[ITEM_%s\] =\n\{\n(.*?)\n\},?\n" % name, items, re.S)
+    if not m:
+        sys.exit("no item data for " + name)
+    return m
+
+
+def set_field(items, name, field, value):
+    m = item_block(items, name)
+    block = m.group(1)
+    if field == "price":
+        new = re.sub(r"ITEM_PRICE\(\d+\)", "ITEM_PRICE(%d)" % value, block, count=1)
+    else:
+        new = re.sub(r"\.%s = [^,]+," % field, ".%s = %s," % (field, value), block, count=1)
+    if new == block and not (field == "price" and "ITEM_PRICE(%d)" % value in block):
+        if ".%s = %s," % (field, value) not in block:
+            sys.exit("could not set %s of %s" % (field, name))
+    return items[:m.start(1)] + new + items[m.end(1):]
+
+
+def main():
+    mart, items = open(MART).read(), open(ITEMS).read()
+    if "ITEM_POMEG_BERRY" in mart:
+        sys.exit("the training items are already in")
+    for array, stock in STOCK.items():
+        # the list ends ", 0xFFFF" on its last line of items, or with 0xFFFF on a line of its own
+        m = re.search(r"(u16 %s\[\] = \{\n)([^}]*?)(,\s*0xFFFF\n\};)" % array, mart)
+        if not m:
+            sys.exit("no " + array)
+        names = [n for n, _, _ in stock]
+        added = ",\n    ".join(", ".join("ITEM_" + n for n in names[i:i + 6]) for i in range(0, len(names), 6))
+        mart = mart.replace(m.group(0), "%s%s,\n    // training items (tools/hack/training_items.py)\n    %s, 0xFFFF\n};" % (
+            m.group(1), m.group(2), added))
+        for name, price, _ in stock:
+            items = set_field(items, name, "price", price)
+    head = "const struct BadgeMartItems sBadgeLockedMartItems[] = {\n"
+    if head not in mart:
+        sys.exit("no sBadgeLockedMartItems")
+    locks = "".join("    { ITEM_%s, %d },\n" % (n, b) for stock in STOCK.values() for n, _, b in stock if b)
+    mart = mart.replace(head, head + "    // training items (tools/hack/training_items.py)\n" + locks)
+    for cap in ("BOTTLE_CAP", "GOLD_BOTTLE_CAP"):
+        items = set_field(items, cap, "fieldUseFunc", FIELD_USE_ON_MON)
+    open(MART, "w").write(mart)
+    open(ITEMS, "w").write(items)
+
+    raw = open(PARTY_TEXT, encoding="utf-8", newline="").read()
+    lines = raw.split("\r\n")
+    if lines[-1] == "":
+        lines.pop()
+    first = len(lines)
+    lines += CAP_MESSAGES
+    open(PARTY_TEXT, "w", encoding="utf-8", newline="").write("\r\n".join(lines) + "\r\n")
+
+    handler = open(HANDLER).read()
+    tail = "        PokeList_FormDemoOverlayLoad(wk);\n        return TRUE;\n    }\n\n    return FALSE;\n}\n"
+    if handler.count(tail) != 1:
+        sys.exit("unexpected end of UseItemMonAttrChangeCheck")
+    handler = handler.replace(tail, "        PokeList_FormDemoOverlayLoad(wk);\n        return TRUE;\n    }\n"
+                              + CAP_CODE % (first + 1, first))
+    open(HANDLER, "w").write(handler)
+    print("stocked", ", ".join(STOCK), "; Bottle Caps use messages %d and %d of %s" % (first, first + 1, PARTY_TEXT))
+
+
+if __name__ == "__main__":
