+NEVER_PICK = set("""EXPLOSION SELF_DESTRUCT FOCUS_PUNCH DREAM_EATER LAST_RESORT HYPER_BEAM GIGA_IMPACT BLAST_BURN
+FRENZY_PLANT HYDRO_CANNON ROCK_WRECKER SOLAR_BEAM SKY_ATTACK RAZOR_WIND SKULL_BASH SNORE SPIT_UP NATURAL_GIFT FLING
+UPROAR PRESENT BIDE FAKE_OUT FEINT SUCKER_PUNCH PURSUIT THIEF COVET PLUCK BUG_BITE FLY DIG DIVE BOUNCE SHADOW_FORCE
+DOOM_DESIRE FUTURE_SIGHT ROLLOUT ICE_BALL FURY_CUTTER RAGE FALSE_SWIPE PAY_DAY SELFDESTRUCT MEMENTO OVERHEAT
