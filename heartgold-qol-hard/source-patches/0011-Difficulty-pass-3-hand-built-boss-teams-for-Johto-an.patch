@@ -0,0 +1,576 @@
+#!/usr/bin/env python3
+"""Difficulty pass, part 3: hand-built boss teams for Johto and the League.
+
+Covers the eight Johto Gym Leaders, the rival's battles up to Victory Road,
+the Team Rocket executives, the Kimono Girls, the Elite Four and Lance.
+
+Roster rule: Johto Pokemon first (the ace included), Kanto ones where Johto
+has nothing suitable for the theme, Hoenn and Sinnoh ones only to round a
+team out. Team sizes grow from three to six. Every Pokemon has chosen moves
+and a held item; from Chuck on they also have a nature and an EV spread.
+
+A Pokemon in TEAMS is (species, level, item, moves, options):
+  - moves None: picked automatically (best move of each of its types, the
+    best coverage move and a status, set-up or recovery move);
+  - every move, given or picked, must be one the species can have at that
+    level: level-up (its own or an earlier stage's), a TM or HM that exists
+    in the game, and, for teams marked EXTRA, egg and tutor moves;
+  - options: ability="NAME", spread="fast"/"bulky"/"wall" (default by stats),
+    nature="NAME", allow=[moves] for a signature move the original team had
+    before the species learns it (Whitney's Milk Drink).
+The script stops on an illegal move, an unknown name or an unimplemented
+move, and warns about Pokemon below their evolution level.
+
+Run once from the hg-engine root, after difficulty.py:
+    python3 tools/hack/boss_teams.py            (add --report to only print)
+"""
+import json
+import re
+import sys
+
+TRAINERS = "data/Trainers.c"
+
+# ---------------------------------------------------------------- game data
+
+def load_species():
+    species = {}
+    text = open("data/Species.c").read()
+    for m in re.finditer(r"^    \[SPECIES_(\w+)\] = \{\n(.*?)^    \},\n", text, re.S | re.M):
+        body = m.group(2)
+        stats = re.search(r"\.baseStats = \{(.*?)\}", body, re.S)
+        if not stats:
+            continue
+        s = {k: int(v) for k, v in re.findall(r"\.(\w+) = (\d+)", stats.group(1))}
+        species[m.group(1)] = {
+            "stats": s,
+            "types": list(dict.fromkeys(re.findall(r"TYPE_(\w+)", re.search(r"\.types = \{(.*?)\}", body).group(1)))),
+            "abilities": re.findall(r"ABILITY_(\w+)", re.search(r"\.abilities = \{(.*?)\}", body).group(1)),
+        }
+    for name, ability in re.findall(r"\[SPECIES_(\w+)\s*\] = ABILITY_(\w+),", open("data/HiddenAbilityTable.c").read()):
+        if name in species and ability != "NONE":
+            species[name]["abilities"].append(ability)
+    return species
+
+
+def config_values():
+    """The config.h numbers that move data can depend on."""
+    values = {}
+    for name, value in re.findall(r"^#define (\w+)\s+(\w+)\s*$", open("include/config.h").read(), re.M):
+        values[name] = value
+    resolved = {}
+    for name, value in values.items():
+        while value in values:
+            value = values[value]
+        if value.isdigit():
+            resolved[name] = int(value)
+    return resolved
+
+
+def evaluate(expression, config):
+    """A move field: a plain value, or ((CONDITION) ? (a) : (b)) with config.h names in the condition."""
+    m = re.fullmatch(r"\(\((.+)\) \? \((.+?)\) : \((.+?)\)\)", expression)
+    if not m:
+        return expression
+    condition = m.group(1).replace("&&", " and ").replace("||", " or ")
+    return m.group(2) if eval(condition, {"__builtins__": {}}, dict(config)) else m.group(3)
+
+
+def load_moves():
+    moves = {}
+    config = config_values()
+    text = open("data/Moves.c").read()
+    for m in re.finditer(r"^    \[MOVE_(\w+)\] = \{\n(.*?)^    \},\n", text, re.S | re.M):
+        body = m.group(2)
+        get = lambda k: evaluate(re.search(r"\.%s = ([^,]+)," % k, body).group(1), config)
+        moves[m.group(1)] = {
+            "type": get("type").replace("TYPE_", ""), "power": int(get("power")), "accuracy": int(get("accuracy")),
+            "split": get("split").replace("SPLIT_", ""), "effect": get("effect"),
+            "usable": "FLAG_UNUSABLE_UNIMPLEMENTED" not in body,
+        }
+    return moves
+
+
+def load_machines():
+    """Moves of the TMs and HMs the player can actually get (TM01-92, HM01-08)."""
+    found = set()
+    for move, label in re.findall(r"MOVE_(\w+), // (\w+)", open("data/MachineMoves.c").read()):
+        m = re.match(r"(TM|HM)(\d+)$", label)
+        if m and (m.group(1) == "HM" or int(m.group(2)) <= 92):
+            found.add(move)
+    return found
+
+
+def load_parents():
+    parent = {}
+    text = open("data/Evolutions.c").read()
+    for m in re.finditer(r"^    \[SPECIES_(\w+)\] = \{(.*?)^    \},", text, re.S | re.M):
+        for method, param, target in re.findall(r"\{ (EVO_\w+), ([^,]+), SPECIES_(\w+) \}", m.group(2)):
+            if method != "EVO_NONE" and target != m.group(1):
+                parent.setdefault(target, (m.group(1), method, param))
+    return parent
+
+
+SPECIES = load_species()
+MOVES = load_moves()
+MACHINES = load_machines()
+PARENT = load_parents()
+LEARNSETS = json.load(open("data/learnsets/learnsets.json"))
+ITEMS = set(re.findall(r"#define ITEM_(\w+)\s", open("include/constants/item.h").read()))
+MOVE_IDS = {n: int(v) for n, v in re.findall(r"#define MOVE_(\w+)\s+\(?(\d+)\)?\s*$", open("include/constants/moves.h").read(), re.M)}
+LAST_GEN_4_MOVE = MOVE_IDS["SHADOW_FORCE"]
+NATURES = set(re.findall(r"#define NATURE_(\w+)\s", open("include/constants/pokemon.h").read()))
+
+
+def level_up_moves(species, level):
+    """Level-up moves, the species' own and its earlier stages'. Later-generation moves count here."""
+    pool = set()
+    s = species
+    while s:
+        ls = LEARNSETS.get("SPECIES_" + s, {})
+        pool.update(e["Move"][5:] for e in ls.get("LevelMoves", []) if e["Level"] <= level)
+        s = PARENT.get(s, (None,))[0]
+    return {m for m in pool if m in MOVES and MOVES[m]["usable"]}
+
+
+def legal_moves(species, level, extra):
+    pool = level_up_moves(species, level)
+    ls = LEARNSETS.get("SPECIES_" + species, {})
+    pool.update(m[5:] for m in ls.get("MachineMoves", []) if m[5:] in MACHINES)
+    if extra:  # egg and tutor moves, but only ones that exist in Gen 4
+        s = species
+        while s:
+            e = LEARNSETS.get("SPECIES_" + s, {})
+            pool.update(m[5:] for m in e.get("EggMoves", []) + e.get("TutorMoves", [])
+                        if MOVE_IDS.get(m[5:], 9999) <= LAST_GEN_4_MOVE)
+            s = PARENT.get(s, (None,))[0]
+    return {m for m in pool if m in MOVES and MOVES[m]["usable"]}
+
