+def rival(stage, starter):
+    s1, s2, s3 = STARTERS[starter]
+    seed = {"CHIKORITA": "MIRACLE_SEED", "CYNDAQUIL": "CHARCOAL", "TOTODILE": "MYSTIC_WATER"}[s1]
+    if stage == "azalea":
+        return [("GASTLY", 18, "ORAN_BERRY", None, {}), ("ZUBAT", 19, "ORAN_BERRY", None, {}),
+                ("MAGNEMITE", 18, "ORAN_BERRY", None, {}), (s2, 21, "SITRUS_BERRY", None, {})]
+    if stage == "burned tower":
+        return [("MAGNEMITE", 24, "SITRUS_BERRY", None, {}), ("GOLBAT", 25, "SITRUS_BERRY", None, {}),
+                ("HAUNTER", 25, "SPELL_TAG", None, {}), ("SNEASEL", 25, "SITRUS_BERRY", None, {}),
+                (s2, 27, seed, None, {})]
+    if stage == "goldenrod tunnel":
+        return [("MAGNETON", 41, "MAGNET", None, {}), ("GOLBAT", 42, "SITRUS_BERRY", None, {}),
+                ("SNEASEL", 42, "RAZOR_CLAW", None, {}), ("GENGAR", 42, "SPELL_TAG", None, {}),
+                ("ALAKAZAM", 42, "TWISTED_SPOON", None, {}), (s3, 44, seed, None, {})]
+    if stage == "victory road":
+        return [("MAGNEZONE", 48, "MAGNET", None, {}), ("WEAVILE", 48, "FOCUS_SASH", None, {}),
+                ("CROBAT", 49, "SITRUS_BERRY", None, {}), ("GENGAR", 49, "WISE_GLASSES", None, {}),
+                ("ALAKAZAM", 49, "TWISTED_SPOON", None, {}), (s3, 50, "SITRUS_BERRY", None, {})]
+    sys.exit("unknown rival stage " + stage)
+
+
+RIVAL_BATTLES = {
+    "azalea": ([], {1: "vs_totodile", 266: "vs_chikorita", 269: "vs_cyndaquil"}),
+    "burned tower": ([EXTRA], {263: "vs_totodile", 267: "vs_chikorita", 270: "vs_cyndaquil"}),
+    "goldenrod tunnel": ([EXTRA, TUNED], {288: "vs_totodile", 289: "vs_chikorita", 271: "vs_cyndaquil"}),
+    "victory road": ([EXTRA, TUNED], {264: "vs_totodile", 268: "vs_chikorita", 272: "vs_cyndaquil"}),
+}
+for stage, (flags, ids) in RIVAL_BATTLES.items():
+    for trainer_id, starter in ids.items():
+        TEAMS[trainer_id] = ("Rival, %s (%s)" % (stage, starter.replace("_", " ")), flags, rival(stage, starter))
+
+
+# ----------------------------------------------------------------- writing
+
+def build(trainer_id):
+    label, flags, mons = TEAMS[trainer_id]
+    extra, tuned = EXTRA in flags, TUNED in flags
+    built, warnings = [], []
+    for species, level, item, moves, options in mons:
+        if species not in SPECIES:
+            sys.exit("%s: unknown species %s" % (label, species))
+        if item != "NONE" and item not in ITEMS:
+            sys.exit("%s: unknown item %s" % (label, item))
+        pool = legal_moves(species, level, extra)
+        if moves is None:
+            moves = pick_moves(species, level, extra)
+        for m in moves:
+            if m not in MOVES:
+                sys.exit("%s: unknown move %s" % (label, m))
+            if m not in pool and m not in options.get("allow", ()):
+                sys.exit("%s: %s cannot have %s at Lv. %d" % (label, species, m, level))
+        ability = options.get("ability")
+        if ability and ability not in SPECIES[species]["abilities"]:
+            sys.exit("%s: %s does not have %s (has %s)" % (label, species, ability, SPECIES[species]["abilities"]))
+        if species in PARENT:
+            pre, method, param = PARENT[species]
+            if method.startswith("EVO_LEVEL") and param.strip().isdigit() and level < int(param):
+                warnings.append("%s Lv. %d is below its evolution level %s" % (species.title(), level, param.strip()))
+        evs = nature = None
+        if tuned:
+            evs, nature = spread_for(species, options, moves)
+            if nature not in NATURES:
+                sys.exit("%s: unknown nature %s" % (label, nature))
+        built.append(dict(species=species, level=level, item=item, moves=moves, ability=ability, evs=evs, nature=nature))
+    return label, built, warnings
+
+
+def party_source(built):
+    any_ability = any(m["ability"] for m in built)
+    out = []
+    for m in built:
+        moves = ["MOVE_" + x for x in m["moves"]] + ["MOVE_NONE"] * (4 - len(m["moves"]))
+        lines = [
+            "            {",
+            "                .ivs = 255,",
+            "                .abilitySlot = TRAINER_POKEMON_ABILITY_1,",
+            "                .level = %d," % m["level"],
+            "                .species = SPECIES_%s," % m["species"],
+            "                .item = ITEM_%s," % m["item"],
+            "                .moves = { %s }," % ", ".join(moves),
+        ]
+        if any_ability:
+            lines.append("                .ability = ABILITY_%s," % (m["ability"] or SPECIES[m["species"]]["abilities"][0]))
+        if m["evs"]:
+            e = m["evs"]
+            order = ("hp", "attack", "defense", "speed", "spAttack", "spDefense")
+            lines.append("                .setIvs = { %s }," % ", ".join(["31"] * 6))
+            lines.append("                .setEvs = { %s }," % ", ".join(str(e[k]) for k in order))
+            lines.append("                .nature = NATURE_%s," % m["nature"])
+        lines += ["                .ballSeal = 0,", "            },"]
+        out.append("\n".join(lines))
+    flags = ["TRAINER_DATA_TYPE_MOVES", "TRAINER_DATA_TYPE_ITEMS"]
+    if any_ability:
+        flags.append("TRAINER_DATA_TYPE_ABILITY")
+    if built[0]["evs"]:
+        flags += ["TRAINER_DATA_TYPE_IV_EV_SET", "TRAINER_DATA_TYPE_NATURE_SET"]
+    return "        .party = {\n" + "\n".join(out) + "\n        },\n", " | ".join(flags)
+
+
+def describe(label, built, warnings):
+    print("== " + label)
+    for m in built:
+        extra = []
+        if m["ability"]:
+            extra.append(m["ability"].replace("_", " ").title())
+        if m["nature"]:
+            extra.append(m["nature"].title())
+        print("   %-10s Lv. %-2d @ %-14s %s%s" % (
+            m["species"].title(), m["level"], m["item"].replace("_", " ").title(),
+            ", ".join(x.replace("_", " ").title() for x in m["moves"]),
+            "  [" + ", ".join(extra) + "]" if extra else ""))
+    for w in warnings:
+        print("   note: " + w)
+
+
+def main():
+    if "--pool" in sys.argv:  # --pool SPECIES LEVEL [extra]: what a Pokemon may know
+        i = sys.argv.index("--pool")
+        species, level = sys.argv[i + 1].upper(), int(sys.argv[i + 2])
+        pool = legal_moves(species, level, "extra" in sys.argv)
+        ranked = sorted(pool, key=lambda m: -move_score(species, m))
+        print(species, SPECIES[species]["types"], SPECIES[species]["abilities"], SPECIES[species]["stats"])
+        print("damaging:", ", ".join("%s(%s %d)" % (m, MOVES[m]["type"][:3], MOVES[m]["power"]) for m in ranked if move_score(species, m) > 0))
+        print("other:", ", ".join(sorted(m for m in pool if move_score(species, m) == 0)))
+        return
+    report_only = "--report" in sys.argv
+    text = open(TRAINERS).read()
+    for trainer_id in TEAMS:
+        label, built, warnings = build(trainer_id)
+        describe(label, built, warnings)
+        if report_only:
+            continue
+        m = re.search(r"^    \[%d\] = \{\n.*?^    \},\n" % trainer_id, text, re.S | re.M)
+        if not m:
+            sys.exit("no trainer %d" % trainer_id)
+        entry = m.group(0)
+        party, flags = party_source(built)
+        entry, n1 = re.subn(r"        \.party = \{\n.*?\n        \},\n", lambda _: party, entry, count=1, flags=re.S)
+        entry, n2 = re.subn(r"\.trainerType = [^,]+,", ".trainerType = %s," % flags, entry, count=1)
+        if n1 != 1 or n2 != 1:
+            sys.exit("could not rewrite trainer %d" % trainer_id)
+        text = text[:m.start()] + entry + text[m.end():]
+    if not report_only:
+        open(TRAINERS, "w").write(text)
+
+
+if __name__ == "__main__":
+    main()
