+
+def taught_power_cap(level):
+    """How strong a TM, egg or tutor move the picker may give at this level."""
+    return 60 if level < 20 else 75 if level < 30 else 90 if level < 40 else 999
+
+
+def move_score(species, move):
+    m, s = MOVES[move], SPECIES[species]["stats"]
+    if m["power"] <= 1 or m["split"] == "STATUS":
+        return 0
+    stat = s["attack"] if m["split"] == "PHYSICAL" else s["spAttack"]
+    score = m["power"] * (m["accuracy"] or 100) / 100 * stat / max(s["attack"], s["spAttack"])
+    if m["type"] in SPECIES[species]["types"]:
+        score *= 1.5
+    if "RECOIL" in m["effect"]:
+        score *= 0.8
+    return score
+
+
+def pick_moves(species, level, extra):
+    own = level_up_moves(species, level)
+    pool = legal_moves(species, level, extra)
+    cap = taught_power_cap(level)
+    types = SPECIES[species]["types"]
+    stats = SPECIES[species]["stats"]
+    damaging = sorted((m for m in pool if m not in NEVER_PICK and move_score(species, m) > 0
+                       and (m in own or MOVES[m]["power"] <= cap)),
+                      key=lambda m: (-move_score(species, m), m))
+    chosen = []
+    top = move_score(species, damaging[0]) if damaging else 0
+    for t in types:
+        best = next((m for m in damaging if MOVES[m]["type"] == t), None)
+        if best and move_score(species, best) >= top / 2:
+            chosen.append(best)
+    # set-up moves follow the side the Pokemon actually attacks from
+    physical = MOVES[damaging[0]]["split"] == "PHYSICAL" if damaging else stats["attack"] >= stats["spAttack"]
+    used_types = {MOVES[m]["type"] for m in chosen}
+    # coverage: a different type, and not Normal unless that is what the Pokemon is
+    coverage = next((m for m in damaging if MOVES[m]["type"] not in used_types
+                     and (MOVES[m]["type"] != "NORMAL" or "NORMAL" in types)), None)
+    if coverage:
+        chosen.append(coverage)
+
+    def utility_ok(m):
+        if m not in pool:
+            return False
+        if m in PHYSICAL_SETUP | SPECIAL_SETUP | SPEED_SETUP:
+            if level < 30 and m not in own:
+                return False
+            if m in PHYSICAL_SETUP and not physical:
+                return False
+            if m in SPECIAL_SETUP and physical:
+                return False
+            if m in SPEED_SETUP and stats["speed"] >= 80:
+                return False
+            return True
+        return m in own or level >= 25
+    utility = next((m for m in UTILITY if utility_ok(m)), None)
+    if utility:
+        chosen.append(utility)
+    for normal_ok in (False, True):
+        for distinct in (True, False):
+            for m in damaging:
+                if len(chosen) >= 4:
+                    break
+                if m in chosen or (MOVES[m]["type"] == "NORMAL" and "NORMAL" not in types and not normal_ok):
+                    continue
+                if distinct and MOVES[m]["type"] in {MOVES[c]["type"] for c in chosen}:
+                    continue
+                chosen.append(m)
+    return chosen[:4]
+
+
+def spread_for(species, options, moves):
+    s = SPECIES[species]["stats"]
+    splits = [MOVES[m]["split"] for m in moves if MOVES[m]["power"] > 1]
+    if splits.count("PHYSICAL") != splits.count("SPECIAL"):
+        physical = splits.count("PHYSICAL") > splits.count("SPECIAL")
+    else:
+        physical = s["attack"] >= s["spAttack"]
+    kind = options.get("spread")
+    if kind is None:
+        kind = "fast" if s["speed"] >= 80 else ("bulky" if s["hp"] + s["defense"] + s["spDefense"] >= 270 else "fast")
+    attack = "attack" if physical else "spAttack"
+    evs = dict(hp=0, attack=0, defense=0, speed=0, spAttack=0, spDefense=0)
+    if kind == "fast":
+        evs.update({attack: 252, "speed": 252, "hp": 4})
+        nature = ("JOLLY" if physical else "TIMID") if s["speed"] >= 90 else ("ADAMANT" if physical else "MODEST")
+    elif kind == "bulky":
+        evs.update({"hp": 252, attack: 252, "defense" if s["defense"] <= s["spDefense"] else "spDefense": 4})
+        nature = "ADAMANT" if physical else "MODEST"
+    elif kind == "wall":
+        phys_wall = s["defense"] >= s["spDefense"]
+        evs.update({"hp": 252, "defense" if phys_wall else "spDefense": 252, "spDefense" if phys_wall else "defense": 4})
+        nature = ("IMPISH" if physical else "BOLD") if phys_wall else ("CAREFUL" if physical else "CALM")
+    else:
+        sys.exit("unknown spread " + kind)
+    return evs, options.get("nature", nature)
+
