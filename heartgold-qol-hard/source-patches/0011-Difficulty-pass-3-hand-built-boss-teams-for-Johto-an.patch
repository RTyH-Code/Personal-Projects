+BELCH STEEL_ROLLER STEEL_BEAM POLTERGEIST PHANTOM_FORCE SECRET_POWER SWIFT STRUGGLE_BUG""".split())
+UTILITY = """SPORE SLEEP_POWDER HYPNOSIS LOVELY_KISS SING DRAGON_DANCE SWORDS_DANCE NASTY_PLOT CALM_MIND BULK_UP
+AGILITY ROCK_POLISH CURSE ROOST RECOVER SLACK_OFF MILK_DRINK SOFT_BOILED MOONLIGHT SYNTHESIS MORNING_SUN
