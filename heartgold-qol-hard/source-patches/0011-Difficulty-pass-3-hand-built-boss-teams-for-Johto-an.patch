+LIGHT_SCREEN REFLECT RAIN_DANCE SUNNY_DAY HAIL SANDSTORM SCREECH FAKE_TEARS SWAGGER ATTRACT PROTECT""".split()
+
+
+PHYSICAL_SETUP = {"DRAGON_DANCE", "SWORDS_DANCE", "BULK_UP", "CURSE"}
+SPECIAL_SETUP = {"NASTY_PLOT", "CALM_MIND"}
+SPEED_SETUP = {"AGILITY", "ROCK_POLISH"}
