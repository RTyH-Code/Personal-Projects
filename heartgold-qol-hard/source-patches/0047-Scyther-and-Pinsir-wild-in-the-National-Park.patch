@@ -0,0 +1,26 @@
+#!/usr/bin/env python3
+"""Scyther and Pinsir wild in the National Park, so the Bug-Catching Contest isn't needed for anything.
+
+In HeartGold they appear only in the Bug-Catching Contest. Every other Pokemon in the contest's tables is wild
+elsewhere in the hack, and its prizes (Sun, Moon, Shiny, Dusk and Dawn Stones, the Everstone, berries) are sold or
+found elsewhere, so with these two the contest can be skipped. They go into the National Park's own grass, the
+contest's grounds on the other days, as rare encounters by encounters.py's rules (only a slot whose species fills
+another slot too, at that slot's level).
+
+Run once from the hg-engine root, after voltorb_wild.py:
+    python3 tools/hack/park_bugs.py
+"""
+import encounters
+
+LAND = {
+    "NATIONAL_PARK": [("SCYTHER", "R", ""), ("PINSIR", "R", "")],
+}
+
+
+def main():
+    encounters.LAND, encounters.WATER = LAND, {}
+    encounters.main()
+
+
+if __name__ == "__main__":
+    main()
