+#!/usr/bin/env python3
+"""Pokemon met surfing in Johto in line with the land beside them.
+
+johto_wild.py and side_wild.py raised walking levels only, so the water kept
+HeartGold's own ranges: Lv. 10-29 at most towns and routes, Lake of Rage
+5-23, Blackthorn 2-23, while the land beside them is in a band under the next
+boss. Each water table is tied to the boss a player faces next when they can
+first surf there, and its surfing slots move into the same band as
+johto_wild.py's, 75-85% of that boss's average, keeping their order:
+    Chuck (34)        everywhere a player passes before Morty, who gives Surf,
+                      and Ecruteak, Olivine, Cianwood and Routes 40-41
+    Pryce (40)        Route 42, Mt. Mortar, Route 43, Lake of Rage
+    Clair (45)        Route 44, Blackthorn, Dragon's Den, the Whirl Islands
+                      (Whirlpool comes after the Radio Tower)
+    the rival on Victory Road (49)   Route 45, Dark Cave's Route 45 side
+A slot's lowest and highest levels both scale, over the first four slots of
+the whole group. The fifth slot (1%) is a rare one: where it was above the
+rest of its table, it stays two levels over the band's top. Fishing and Rock
+Smash are unchanged, and so are the post-game areas and those league_wild.py
+already does. Wild Pokemon are not evolved, as in johto_wild.py.
+
+Run once from the hg-engine root, after side_wild.py:
+    python3 tools/hack/surf_wild.py
+"""
+import re
+
+from johto_wild import LATER
+
+ENCOUNTERS = "data/Encounters.c"
+GROUPS = [
+    (34, ["T20_NEW_BARK_TOWN", "T21_CHERRYGROVE_CITY", "R30_ROUTE_30", "R31_ROUTE_31", "T22_VIOLET_CITY",
+          "R32_ROUTE_32", "D24R0101_RUINS_OF_ALPH_OUTSIDE", "D25R0101_UNION_CAVE_1F", "D25R0102_UNION_CAVE_B1F",
+          "D25R0103_UNION_CAVE_B2F", "D26R0102_SLOWPOKE_WELL_1F", "D26R0103_SLOWPOKE_WELL_B2F",
+          "D36R0101_ILEX_FOREST", "R34_ROUTE_34", "R35_ROUTE_35", "T27_ECRUTEAK_CITY", "T26_OLIVINE_CITY",
+          "W40_ROUTE_40", "W41_ROUTE_41", "T24_CIANWOOD_CITY", "D42R0102_DARK_CAVE_ROUTE_31_ENTRANCE"]),
+    (40, ["R42_ROUTE_42", "D38R0101_MT_MORTAR_WATERFALL_ROOM", "D38R0103_MT_MORTAR_ROOM_ABOVE_WATERFALL",
+          "D38R0104_MT_MORTAR_B1F", "R43_ROUTE_43", "T29_LAKE_OF_RAGE"]),
+    (45, ["R44_ROUTE_44", "T30_BLACKTHORN_CITY", "D44R0102_DRAGONS_DEN", "D40R0101_WHIRL_ISLANDS_1F",
+          "D40R0104_WHIRL_ISLANDS_B2F"]),
+    (49, ["R45_ROUTE_45", "D42R0101_DARK_CAVE_ROUTE_45_ENTRANCE"]),
+]
+SLOT = r"\{ (\d+), (\d+), SPECIES_(\w+) \}"
+
+
+def main():
+    text = open(ENCOUNTERS).read()
+    done = []
+    for average, tables in GROUPS:
+        low, high = round(average * LATER[0]), round(average * LATER[1])
+        found = {}
+        for name in tables:
+            m = re.search(r"^    \[ENCDATA_%s\] = \{\n.*?^    \},\n" % name, text, re.S | re.M)
+            assert m, name
+            surf = re.search(r"\.surfSlots = \{.*?\n        \},", m.group(0), re.S)
+            slots = [(int(a), int(b), s) for a, b, s in re.findall(SLOT, surf.group(0))]
+            found[name] = (m, surf, slots)
+        # the scale runs over the first four slots of every table in the group; the fifth is the rare one
+        every = [x for _, _, slots in found.values() for a, b, s in slots[:4] if s != "NONE" for x in (a, b)]
+        lo, hi = min(every), max(every)
+
+        def scale(level):
+            return high if hi == lo else low + ((level - lo) * (high - low) * 2 + (hi - lo)) // ((hi - lo) * 2)
+
+        def new_slots(slots):
+            top = max([b for a, b, s in slots[:4] if s != "NONE"] or [0])
+            out = []
+            for k, (a, b, s) in enumerate(slots):
+                if s == "NONE":
+                    out.append((a, b, s))
+                elif k == 4 and a > top:            # a rare slot above its table: a little above the band
+                    out.append((high + 2, high + 2, s))
+                else:
+                    out.append((scale(min(max(a, lo), hi)), scale(min(max(b, lo), hi)), s))
+            return out
+        for name, (m, surf, slots) in found.items():
+            new = new_slots(slots)
+            done.append((name, "%d-%d" % (min(a for a, b, s in slots if s != "NONE"), max(b for a, b, s in slots if s != "NONE")),
+                         "%d-%d" % (min(a for a, b, s in new if s != "NONE"), max(b for a, b, s in new if s != "NONE"))))
+        # from the end of the file, so that earlier offsets still hold
+        for name, (m, surf, slots) in sorted(found.items(), key=lambda kv: -kv[1][0].start()):
+            it = iter(new_slots(slots))
+            block = re.sub(SLOT, lambda x: "{ %d, %d, SPECIES_%s }" % next(it), surf.group(0))
+            start, end = m.start() + surf.start(), m.start() + surf.end()
+            text = text[:start] + block + text[end:]
+    open(ENCOUNTERS, "w").write(text)
+    for name, old, new in done:
+        print("%-42s surf Lv. %-6s -> %s" % (name, old, new))
+
+
+if __name__ == "__main__":
+    main()
