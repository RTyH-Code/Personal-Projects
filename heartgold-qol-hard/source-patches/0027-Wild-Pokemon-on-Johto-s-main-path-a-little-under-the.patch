@@ -0,0 +1,81 @@
+#!/usr/bin/env python3
+"""Wild Pokemon on Johto's main path a little under the next boss.
+
+The grass and caves a player walks through on the way to each Johto boss
+kept HeartGold's own low levels (Routes 30-31 at Lv. 2-5 before Falkner's
+12, Routes 42-43 at 14-19 before Pryce's 40), which under the scaled
+experience formula give a team at the bosses' levels little. Catching up
+before Falkner took about 180 wild battles, before Jasmine about 160
+(playtest/LEVEL_CURVE.md). Each area on the main path is tied to the boss
+after it, and its walking levels move into a band under that boss's
+average, keeping their order:
+    before Falkner:      55-80% of his average (Route 30 is the first route)
+    later bosses:        75-85%
+Surfing, fishing and Rock Smash are unchanged (Surf comes mid-game), and so
+are Route 29 and Route 46, optional areas that are already higher (Bell
+Tower, Whirl Islands, the lower floors of Union Cave and Slowpoke Well, the
+top of Mt. Mortar, the Ruins of Alph), and the areas before the League,
+which league_wild.py does. Wild Pokemon are not evolved here: past their
+evolution level they appear as they would in the original game.
+
+Run once from the hg-engine root, after league_wild.py:
+    python3 tools/hack/johto_wild.py
+"""
+import re
+
+ENCOUNTERS = "data/Encounters.c"
+# (the next boss's average level, the encounter tables on the way to that boss)
+GROUPS = [
+    (12, ["R30_ROUTE_30", "R31_ROUTE_31", "D15R0102_SPROUT_TOWER_2F", "D15R0103_SPROUT_TOWER_3F",
+          "D42R0102_DARK_CAVE_ROUTE_31_ENTRANCE"]),
+    (17, ["R32_ROUTE_32", "D25R0101_UNION_CAVE_1F", "D25R0102_UNION_CAVE_B1F", "R33_ROUTE_33",
+          "D26R0102_SLOWPOKE_WELL_1F"]),
+    (22, ["D36R0101_ILEX_FOREST", "R34_ROUTE_34"]),
+    (28, ["R35_ROUTE_35", "D22R0101_NATIONAL_PARK", "D22R0102_NATIONAL_PARK_BUG_CATCHING_CONTEST", "R36_ROUTE_36",
+          "R37_ROUTE_37", "D18R0101_BURNED_TOWER_1F", "D18R0102_BURNED_TOWER_B1F"]),
+    (34, ["R38_ROUTE_38", "R39_ROUTE_39"]),
+    (40, ["R42_ROUTE_42", "D38R0101_MT_MORTAR_WATERFALL_ROOM", "D38R0102_MT_MORTAR_CENTRAL_ROOM",
+          "D38R0104_MT_MORTAR_B1F", "R43_ROUTE_43"]),
+    (45, ["R44_ROUTE_44", "D39R0101_ICE_PATH_1F", "D39R0102_ICE_PATH_B1F", "D39R0103_ICE_PATH_B2F",
+          "D39R0104_ICE_PATH_B3F"]),
+]
+FIRST, LATER = (0.55, 0.80), (0.75, 0.85)
+
+
+def band(average):
+    low, high = FIRST if average == GROUPS[0][0] else LATER
+    return round(average * low), round(average * high)
+
+
+def main():
+    text = open(ENCOUNTERS).read()
+    done = []
+    for average, tables in GROUPS:
+        low, high = band(average)
+        found = {}
+        for name in tables:
+            m = re.search(r"^    \[ENCDATA_%s\] = \{\n.*?^    \},\n" % name, text, re.S | re.M)
+            assert m, name
+            levels = re.search(r"\.levels = \{\s*([\d,\s]+?)\s*\}", m.group(0))
+            found[name] = (m, levels, [int(x) for x in re.findall(r"\d+", levels.group(1))])
+        # one scale for the whole group, so that its areas keep their order
+        every = [x for _, _, levels in found.values() for x in levels if x]
+        lo, hi = min(every), max(every)
+
+        def scale(level):
+            if not level:
+                return 0
+            return high if hi == lo else low + ((level - lo) * (high - low) * 2 + (hi - lo)) // ((hi - lo) * 2)
+        for name, (m, levels, old) in found.items():
+            done.append((name, "%d-%d" % (min(old), max(old)), "%d-%d" % (scale(min(old)), scale(max(old)))))
+        # from the end of the file, so that earlier offsets still hold
+        for name, (m, levels, old) in sorted(found.items(), key=lambda kv: -kv[1][0].start()):
+            start, end = m.start() + levels.start(1), m.start() + levels.end(1)
+            text = text[:start] + ", ".join(str(scale(x)) for x in old) + text[end:]
+    open(ENCOUNTERS, "w").write(text)
+    for name, old, new in done:
+        print("%-46s Lv. %-6s -> %s" % (name, old, new))
+
+
+if __name__ == "__main__":
+    main()
