+#!/usr/bin/env python3
+"""Add a fossil reviver to the Ruins of Alph Research Center.
+
+HeartGold only revives fossils at the Pewter Museum, after the Elite Four.
+This copies the museum scientist's script into the Research Center, adds a
+scientist there to run it and adds his lines to the Research Center's text.
+
+It needs the vanilla dump of the two maps, which hg-engine makes with
+    make dump_scripts DUMP_ROM=rom.nds
+(run that in a scratch copy of hg-engine; it rewrites base/). Pass the
+dumped tree as the argument:
+    python3 tools/hack/fossil_reviver.py /path/to/dumped/hg-engine
+
+The files it writes into data/scr_seq, data/eventdata/zone_event and
+data/text/custom are the only dumped files in the hack; hg-engine builds
+just those when BUILD_DUMPED_SCR_SEQ and BUILD_DUMPED_EVENTDATA are on.
+"""
+import json
+import os
+import re
+import sys
+
+MUSEUM_SCRIPT = "data/scr_seq/scr_seq_0755_T03R0101.s"
+MUSEUM_TEXT = "data/text/custom/464.txt"
+CENTER_SCRIPT = "data/scr_seq/scr_seq_0038_D24R0102.s"
+CENTER_INCLUDE = "data/scr_seq/include/event_D24R0102.inc"
+CENTER_EVENTS = "data/eventdata/zone_event/292_D24R0102.json"
+CENTER_TEXT = "data/text/custom/073.txt"
+
+MUSEUM_MESSAGES = range(1, 10)   # the reviver's lines in the museum's archive
+NEW_SCRIPT = 6                   # the Research Center has scripts 0-5
+NEW_OBJECT = 3                   # and objects 0-2
+# in front of the right-hand machine on the back wall: both tiles in front of it can be stood on in the
+# original (they are where the player reads it from), and it can still be read from the left one
+POSITION = (11, 4)
+
+
+def main():
+    dump = sys.argv[1]
+    # newline="" keeps each file's own line endings (the text archives use CRLF)
+    read = lambda path: open(os.path.join(dump, path), encoding="utf-8", newline="").read()
+
+    center_text = read(CENTER_TEXT).split("\r\n")
+    if center_text[-1] == "":
+        center_text.pop()
+    museum_text = read(MUSEUM_TEXT).split("\r\n")
+    offset = len(center_text) - MUSEUM_MESSAGES[0]
+    center_text += [museum_text[i] for i in MUSEUM_MESSAGES]
+
+    museum = read(MUSEUM_SCRIPT)
+    block = re.search(r"^scr_seq_T03R0101_001:\n.*?(?=^scr_seq_T03R0101_\d+:)", museum, re.S | re.M).group(0)
+    block = block.replace("scr_seq_T03R0101_001:", "scr_seq_D24R0102_%03d:" % NEW_SCRIPT)
+    block = re.sub(r"\b_([0-9A-F]{4})\b", r"_fossil_\1", block)
+
+    def message(m):
+        number = int(m.group(1))
+        if number not in MUSEUM_MESSAGES:
+            sys.exit("unexpected message %d in the museum script" % number)
+        return "npc_msg %d" % (number + offset)
+    block = re.sub(r"npc_msg (\d+)", message, block)
+
+    script = read(CENTER_SCRIPT)
+    script = script.replace("scrdef_end", "scrdef scr_seq_D24R0102_%03d\nscrdef_end" % NEW_SCRIPT, 1)
+    script = script.rstrip("\n") + "\n\n// the fossil reviver, copied from the Pewter Museum (scr_seq_T03R0101_001)\n" + block.rstrip("\n") + "\n"
+
+    include = read(CENTER_INCLUDE)
+    include = include.replace("\n.equ obj_D24R0102_suit",
+                              "\n.equ _EV_scr_seq_D24R0102_%03d, %d\n\n.equ obj_D24R0102_suit" % (NEW_SCRIPT, NEW_SCRIPT), 1)
+    include = include.replace("\n.endif", ".equ obj_D24R0102_fossil, %d\n\n.endif" % NEW_OBJECT, 1)
+
+    events = json.loads(read(CENTER_EVENTS))
+    if len(events["object_events"]) != NEW_OBJECT:
+        sys.exit("unexpected number of objects in the Research Center")
+    events["object_events"].append({
+        "id": "obj_D24R0102_fossil",
+        "graphics_id": "SPRITE_GSASSISTANTM",
+        "movement_type": 15,   # stands still facing down, like the man in the suit
+        "trainer_type": 0,
+        "hidden_flag": "FLAG_NOTHING",
+        "script": "_EV_scr_seq_D24R0102_%03d + 1" % NEW_SCRIPT,
+        "initial_dir": 1,
+        "param0": 0, "param1": 0, "param2": 0,
+        "movement_range_x": 0, "movement_range_z": 0,
+        "x": POSITION[0], "z": POSITION[1], "y": 0,
+    })
+
+    for path, content in ((CENTER_SCRIPT, script), (CENTER_INCLUDE, include),
+                          (CENTER_EVENTS, json.dumps(events, indent=2) + "\n"),
+                          (CENTER_TEXT, "\r\n".join(center_text) + "\r\n")):
+        os.makedirs(os.path.dirname(path), exist_ok=True)
+        open(path, "w", encoding="utf-8", newline="").write(content)
+        print("wrote", path)
+
+
+if __name__ == "__main__":
+    main()
