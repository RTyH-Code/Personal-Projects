+++ b/tools/hack/encounters.py
@@ -0,0 +1,258 @@
+#!/usr/bin/env python3
+"""Wild encounter pass: every non-legendary family is catchable in Johto.
+
+Adds the families that HeartGold only has in Kanto, on the post-game radio,
+in the Safari Zone or not at all (SoulSilver exclusives, most Hoenn and
+Sinnoh families, the other starters). They are placed by strength: weak
+ones early, the strongest (Larvitar, Bagon, Beldum, Gible, Riolu) only with
+seven or eight badges. The Safari Zone itself is not touched.
+
+A placement overwrites one slot of an existing table. Only slots whose
+species also fills another slot of the same table are used, so nothing that
+was already there disappears; the slot's level is kept. Land placements
+name how common they should be:
+    U  uncommon (a 10% slot)    R  rare (5%)
+    V  very rare (4%)           X  1%
+and may be limited to the morning, day or night table ("m", "d", "n").
+Water placements name the list (surf, old, good) and work the same way,
+starting from the least likely slot.
+
+Afterwards the script checks that every family has a Johto source.
+
+Run once from the hg-engine root, after wild_levels.py:
+    python3 tools/hack/encounters.py
+"""
+import re
+import sys
+
+ENCOUNTERS = "data/Encounters.c"
+
+LAND_SLOT_ODDS = [20, 20, 10, 10, 10, 10, 5, 5, 4, 4, 1, 1]
+CLASS_ODDS = {"U": 10, "R": 5, "V": 4, "X": 1}
+TIMES = {"m": "speciesMorning", "d": "speciesDay", "n": "speciesNight"}
+WATER_LISTS = {"surf": "surfSlots", "old": "oldRodSlots", "good": "goodRodSlots"}
+
+# table -> [(species, class, times)]; times "" means all three
+LAND = {
+    # before the second badge
+    "ROUTE_29": [("ZIGZAGOON", "U", ""), ("BIDOOF", "U", "")],
+    "ROUTE_30": [("LEDYBA", "U", "m"), ("WEEDLE", "U", ""), ("KRICKETOT", "U", "n")],
+    "ROUTE_31": [("LEDYBA", "U", "m"), ("WEEDLE", "U", ""), ("KRICKETOT", "U", "n"), ("PACHIRISU", "R", "")],
+    "ROUTE_46": [("SPINDA", "U", "")],
+    "DARK_CAVE_ROUTE_31_ENTRANCE": [("SABLEYE", "R", "")],
+    "ROUTE_32": [("POOCHYENA", "U", ""), ("WINGULL", "U", ""), ("EKANS", "U", ""), ("SURSKIT", "R", "")],
+    "UNION_CAVE_1F": [("MAWILE", "R", "")],
+    "UNION_CAVE_B1F": [("CUBONE", "R", "")],
+    "ROUTE_33": [("NINCADA", "U", ""), ("MEDITITE", "R", "")],
+    "ILEX_FOREST": [("KECLEON", "R", ""), ("PIKACHU", "R", ""), ("BUDEW", "U", ""),
+                    ("ILLUMISE", "V", "n"), ("VOLBEAT", "V", "n")],
+    # badges two to four
+    "ROUTE_34": [("SKITTY", "U", ""), ("GLAMEOW", "U", ""), ("SHELLOS", "R", ""), ("JIGGLYPUFF", "R", ""),
+                 ("RALTS", "V", "")],
+    "ROUTE_35": [("STUNKY", "U", ""), ("GULPIN", "U", ""), ("CHATOT", "R", ""), ("LOTAD", "R", "")],
+    "NATIONAL_PARK": [("BUNEARY", "U", ""), ("CARNIVINE", "R", "")],
+    "ROUTE_36": [("VULPIX", "U", ""), ("SHINX", "U", ""), ("BONSLY", "R", ""), ("PLUSLE", "R", "")],
+    "ROUTE_37": [("VULPIX", "U", ""), ("ELECTRIKE", "U", ""), ("MINUN", "R", ""), ("HOUNDOUR", "R", "n")],
+    "BURNED_TOWER_1F": [("SHUPPET", "U", ""), ("DRIFLOON", "R", ""), ("MURKROW", "R", "n")],
+    "BURNED_TOWER_B1F": [("SLUGMA", "U", ""), ("DUSKULL", "R", ""), ("TORKOAL", "R", ""), ("ROTOM", "X", "")],
+    # badges four to six
+    "ROUTE_38": [("MEOWTH", "U", ""), ("SPOINK", "R", ""), ("CHINGLING", "R", ""),
+                 ("CHIKORITA", "V", ""), ("CYNDAQUIL", "V", "")],
+    "ROUTE_39": [("MEOWTH", "U", ""), ("ZANGOOSE", "R", ""), ("SEVIPER", "R", ""),
+                 ("TOTODILE", "V", ""), ("KANGASKHAN", "V", "")],
+    "RUINS_OF_ALPH_OUTSIDE": [("BALTOY", "U", ""), ("BRONZOR", "U", ""), ("LUNATONE", "R", ""), ("SOLROCK", "R", "")],
+    "CLIFF_CAVE": [("NOSEPASS", "R", "")],
+    "ROUTE_47": [("SKORUPI", "R", ""), ("TRAPINCH", "V", "")],
+    "ROUTE_48": [("TROPIUS", "R", ""), ("CACNEA", "R", "")],
+    # badges six and seven
+    "ROUTE_42": [("NUMEL", "U", ""), ("BULBASAUR", "V", "")],
+    "MT_MORTAR_CENTRAL_ROOM": [("MAKUHITA", "U", ""), ("WHISMUR", "U", ""), ("CLEFAIRY", "R", "")],
+    "MT_MORTAR_B1F": [("CROAGUNK", "R", ""), ("GRIMER", "R", ""), ("ARON", "R", "")],
+    "ROUTE_43": [("CASTFORM", "R", ""), ("MIME_JR", "R", ""), ("CHARMANDER", "V", ""), ("PORYGON", "X", "")],
+    # badges seven and eight
+    "ROUTE_44": [("ELEKID", "R", ""), ("SQUIRTLE", "V", ""), ("MUNCHLAX", "V", ""), ("CHANSEY", "X", "")],
+    "ICE_PATH_1F": [("DELIBIRD", "U", ""), ("SNORUNT", "U", "")],
+    "ICE_PATH_B1F": [("SNOVER", "U", ""), ("SNEASEL", "R", "")],
+    "ICE_PATH_B2F": [("SNORUNT", "U", ""), ("SPHEAL", "R", "")],
+    "ICE_PATH_B3F": [("SNOVER", "U", ""), ("SNEASEL", "R", ""), ("DELIBIRD", "R", "")],
+    "ROUTE_45": [("SKARMORY", "R", ""), ("ABSOL", "R", ""), ("TREECKO", "V", ""), ("TORCHIC", "V", ""),
+                 ("HIPPOPOTAS", "U", ""), ("SWABLU", "U", ""), ("BAGON", "X", "")],
+    "DARK_CAVE_ROUTE_45_ENTRANCE": [("TEDDIURSA", "U", ""), ("GIBLE", "X", "")],
+    "MT_MORTAR_ROOM_ABOVE_WATERFALL": [("RIOLU", "V", ""), ("LARVITAR", "V", "")],
+    "TOHJO_FALLS": [("MUDKIP", "V", "")],
+    # before the Elite Four
+    "ROUTE_26": [("TURTWIG", "V", ""), ("CHIMCHAR", "V", "")],
+    "ROUTE_27": [("PIPLUP", "V", "")],
+    "VICTORY_ROAD_1F": [("BELDUM", "V", "")],
+    "VICTORY_ROAD_2F": [("BELDUM", "V", "")],
+}
+for floor in range(2, 11):
+    LAND["BELL_TOWER_%dF" % floor] = [("SPIRITOMB", "X", "")]
+
+# table -> [(species, list)]
+WATER = {
+    "UNION_CAVE_1F": [("BARBOACH", "old")],
+    "ROUTE_34": [("CORPHISH", "old")],
+    "CIANWOOD_CITY": [("LUVDISC", "good")],
+    "ROUTE_40": [("WAILMER", "surf"), ("FINNEON", "good")],
+    "ROUTE_41": [("CARVANHA", "surf"), ("CLAMPERL", "good")],
+    "WHIRL_ISLANDS_1F": [("RELICANTH", "good")],
+    "ROUTE_42": [("BUIZEL", "surf")],
+    "LAKE_OF_RAGE": [("FEEBAS", "good")],
+}
+
+# families that already have a Johto source this script cannot see
+OTHER_SOURCES = {
+    "EEVEE": "gift in Goldenrod City", "TOGEPI": "egg from Professor Elm's aide", "TYROGUE": "gift in Mt. Mortar",
+    "SCYTHER": "Bug-Catching Contest", "PINSIR": "Bug-Catching Contest", "LAPRAS": "Union Cave on Fridays",
+    "VOLTORB": "Team Rocket HQ", "SUDOWOODO": "Route 36", "OMANYTE": "fossil", "KABUTO": "fossil",
+    "AERODACTYL": "fossil", "LILEEP": "fossil", "ANORITH": "fossil", "CRANIDOS": "fossil", "SHIELDON": "fossil",
+    "WEEDLE": "Bug-Catching Contest",
+}
+LEGENDARY = set("""ARTICUNO ZAPDOS MOLTRES MEWTWO MEW RAIKOU ENTEI SUICUNE LUGIA HO_OH CELEBI REGIROCK REGICE
+REGISTEEL LATIAS LATIOS KYOGRE GROUDON RAYQUAZA JIRACHI DEOXYS UXIE MESPRIT AZELF DIALGA PALKIA HEATRAN
+REGIGIGAS GIRATINA CRESSELIA PHIONE MANAPHY DARKRAI SHAYMIN ARCEUS UNOWN""".split())
+LATER_EVOLUTIONS = ["KLEAVOR", "URSALUNA", "ANNIHILAPE", "WYRDEER", "FARIGIRAF", "DUDUNSPARCE", "SYLVEON"]
+KANTO = ["ROUTE_%d" % i for i in list(range(1, 26)) + [28]] + [
+    "PALLET", "VIRIDIAN", "PEWTER", "CERULEAN", "LAVENDER", "VERMILION", "CELADON", "FUCHSIA", "CINNABAR",
+    "SAFFRON", "DIGLETTS", "MT_MOON", "ROCK_TUNNEL", "SEAFOAM", "POWER_PLANT", "MT_SILVER",
+]
+
+
+def in_kanto(table):
+    return any(re.search(r"(^|_)%s($|_)" % name, table) for name in KANTO)
+
+
+def die(message):
+    sys.exit("encounters.py: " + message)
+
+
+def pick_slot(species_list, odds_wanted, odds_of):
+    """Index of a slot to overwrite: its species must fill another slot too."""
+    counts = {}
+    for s in species_list:
+        counts[s] = counts.get(s, 0) + 1
+    free = [i for i, s in enumerate(species_list) if s == "SPECIES_NONE" or counts[s] > 1]
+    if not free:
+        return None
+    # the slot closest to the wanted odds, preferring the less likely one on a tie
+    return min(free, key=lambda i: (abs(odds_of[i] - odds_wanted), odds_of[i], -i))
+
+
+def place_land(body, table, placements):
+    for species, cls, times in placements:
+        for t in (times or "mdn"):
+            field = TIMES[t]
+            m = re.search(r"(\.%s = \{\n)(.*?)(\n\s*\},)" % field, body, re.S)
+            slots = re.findall(r"SPECIES_\w+", m.group(2))
+            if len(slots) != 12:
+                die("%s %s does not have 12 slots" % (table, field))
+            if "SPECIES_" + species in slots:
+                continue
+            i = pick_slot(slots, CLASS_ODDS[cls], LAND_SLOT_ODDS)
+            if i is None:
+                die("no free slot for %s in %s (%s)" % (species, table, field))
+            slots[i] = "SPECIES_" + species
+            indent = re.match(r"\s*", m.group(2)).group(0)
+            body = body[:m.start(2)] + ",\n".join(indent + s for s in slots) + "," + body[m.end(2):]
+    return body
+
+
+def place_water(body, table, placements):
+    odds = {"surf": [60, 30, 5, 4, 1], "old": [40, 30, 15, 10, 5], "good": [40, 30, 15, 10, 5]}
+    for species, which in placements:
+        m = re.search(r"(\.%s = \{\n)(.*?)(\n        \},)" % WATER_LISTS[which], body, re.S)
+        rows = re.findall(r"\{ (\d+), (\d+), (SPECIES_\w+) \}", m.group(2))
+        if len(rows) != 5:
+            die("%s %s does not have 5 slots" % (table, which))
+        if all(r[2] == "SPECIES_NONE" for r in rows):
+            die("%s has no %s encounters to add %s to" % (table, which, species))
+        i = pick_slot([r[2] for r in rows], 5, odds[which])
+        if i is None:
+            die("no free %s slot for %s in %s" % (which, species, table))
+        lo, hi, old = rows[i]
+        if old == "SPECIES_NONE":  # an empty slot has no level; borrow a neighbour's
+            lo, hi = next((r[0], r[1]) for r in rows if r[2] != "SPECIES_NONE")
+        rows[i] = (lo, hi, "SPECIES_" + species)
+        indent = re.match(r"\s*", m.group(2)).group(0)
+        body = body[:m.start(2)] + "\n".join("%s{ %s, %s, %s }," % ((indent,) + r) for r in rows) + body[m.end(2):]
+    return body
+
+
+def families():
+    """root species -> members, for the hack's roster."""
+    numbers = {}
+    for m in re.finditer(r"#define SPECIES_(\w+)\s+\(?(\d+)\)?\s*$", open("include/constants/species.h").read(), re.M):
+        numbers.setdefault(m.group(1), int(m.group(2)))
+    roster = {n for n, v in numbers.items() if 1 <= v <= 493 and "EGG" not in n}
+    first = {}
+    for n in roster:
+        first.setdefault(numbers[n], n)
+    roster = set(first.values()) | set(LATER_EVOLUTIONS)
+    parent = {}
+    text = open("data/Evolutions.c").read()
+    for m in re.finditer(r"^    \[SPECIES_(\w+)\] = \{(.*?)^    \},", text, re.S | re.M):
+        if m.group(1) not in roster:
+            continue
+        for method, target in re.findall(r"\{ (EVO_\w+), [^,]+, SPECIES_(\w+) \}", m.group(2)):
+            if method != "EVO_NONE" and target in roster and target != m.group(1):
+                parent.setdefault(target, m.group(1))
+    fams = {}
+    for n in roster:
+        root = n
+        while root in parent:
+            root = parent[root]
+        fams.setdefault(root, set()).add(n)
+    return fams
+
+
+def johto_wild(text):
+    found = set()
+    for table, body in re.findall(r"^    \[ENCDATA_\w+?_([A-Z0-9_]+)\] = \{\n(.*?)^    \},\n", text, re.S | re.M):
+        if in_kanto(table):
+            continue
+        rate = lambda k: int(re.search(r"\.rate%s = (\d+)" % k, body).group(1))
+        if rate("Walk"):
+            for field in TIMES.values():
+                found.update(re.findall(r"SPECIES_(\w+)", re.search(r"\.%s = \{(.*?)\}" % field, body, re.S).group(1)))
+        for field, key in (("surfSlots", "Surf"), ("oldRodSlots", "OldRod"), ("goodRodSlots", "GoodRod"),
+                           ("rockSmashSlots", "RockSmash")):
+            if rate(key):
+                found.update(re.findall(r"SPECIES_(\w+)", re.search(r"\.%s = \{(.*?)\n        \}," % field, body, re.S).group(1)))
+    found.update(re.findall(r"SPECIES_(\w+)", open("data/Headbutt.c").read()))
+    return found
+
+
+def main():
+    text = open(ENCOUNTERS).read()
+    seen = set()
+
+    def rewrite(m):
+        table, body = m.group(1), m.group(0)
+        if table in LAND:
+            if not int(re.search(r"\.rateWalk = (\d+)", body).group(1)):
+                die("%s has no land encounters" % table)
+            body = place_land(body, table, LAND[table])
+        if table in WATER:
+            body = place_water(body, table, WATER[table])
+        seen.add(table)
+        return body
+
+    text = re.sub(r"^    \[ENCDATA_\w+?_([A-Z0-9_]+)\] = \{\n.*?^    \},\n", rewrite, text, flags=re.S | re.M)
+    missing = (set(LAND) | set(WATER)) - seen
+    if missing:
+        die("unknown tables: " + ", ".join(sorted(missing)))
+    open(ENCOUNTERS, "w").write(text)
+
+    wild = johto_wild(text)
+    unplaced = []
+    for root, members in sorted(families().items()):
+        if root in LEGENDARY or members & wild or members & set(OTHER_SOURCES):
+            continue
+        unplaced.append(root)
+    print("placed %d land and %d water entries" % (sum(len(v) for v in LAND.values()), sum(len(v) for v in WATER.values())))
+    print("families with no Johto source: " + (", ".join(unplaced) or "none"))
+
+
+if __name__ == "__main__":
+    main()
