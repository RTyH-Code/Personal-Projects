+#!/usr/bin/env python3
+"""Voltorb on Route 38 too.
+
+breeding_wild.py put Voltorb on Route 37 in the only slot free there, which is
+4-5% by morning and day but 1% at night, so a player out at night may never
+meet one (100 encounters in the emulator found none). This adds it to
+Route 38, the next route west, with Magnemite, as uncommon at every time of
+day, by encounters.py's rules (only a slot whose species fills another slot
+too, at that slot's level).
+
+Run once from the hg-engine root, after breeding_wild.py:
+    python3 tools/hack/voltorb_wild.py
+"""
+import encounters
+
+LAND = {
+    "ROUTE_38": [("VOLTORB", "U", "")],
+}
+
+
+def main():
+    encounters.LAND, encounters.WATER = LAND, {}
+    encounters.main()
+
+
+if __name__ == "__main__":
+    main()
