+#!/usr/bin/env python3
+"""Fishing, Rock Smash and Headbutt in Johto in line with the land and water.
+
+The walking and surfing levels were moved into a band under each boss
+(johto_wild.py, side_wild.py, surf_wild.py, cianwood_wild.py, league_wild.py),
+but the other ways to meet a wild Pokemon kept HeartGold's own levels: the
+Good Rod at Lv. 20 everywhere, Rock Smash at 3-15 by the Ruins of Alph, and
+Headbutt trees at 2-8 up to Azalea and 13-18 as far as Route 43. As there,
+each is tied to the boss a player faces next once they can use it, and moves
+into the band 75-85% of that boss's average, keeping its order:
+
+    Good Rod (Olivine, after Surf)  each water table's surfing band: the rod
+                                    comes after Surf, so wherever it can be
+                                    used the surfing levels already apply
+    Rock Smash (Route 36)           the Ruins of Alph and Dark Cave's Route
+                                    31 side follow Morty (28); Cianwood and
+                                    Cliff Cave follow Chuck (34)
+    Headbutt (Ilex Forest)          trees passed before Ilex Forest follow
+                                    Whitney (22); later ones follow the
+                                    walking band of their area's group, and
+                                    Routes 26 and 27 league_wild.py's
+
+A Headbutt area's special trees (a few rarer Pokemon) sit two levels over its
+band, as surf_wild.py's rare slot does. The Old Rod (Lv. 10) is had before
+Falkner and already fits there; the Super Rod (Lv. 40) is a post-game item
+from Kanto; Kanto's trees were set with its post-game levels. Those stay.
+
+Run once from the hg-engine root, after cianwood_wild.py:
+    python3 tools/hack/extra_wild.py
+"""
+import re
+
+import league_wild
+from johto_wild import LATER
+
+ENCOUNTERS = "data/Encounters.c"
+HEADBUTT = "data/Headbutt.c"
+SLOT = r"\{ (\d+), (\d+), SPECIES_(\w+) \}"
+HB_SLOT = r"\{ SPECIES_(\w+), (\d+), (\d+) \}"
+
+GOOD_ROD = ["T20_NEW_BARK_TOWN", "T21_CHERRYGROVE_CITY", "R30_ROUTE_30", "R31_ROUTE_31", "T22_VIOLET_CITY",
+            "R32_ROUTE_32", "D24R0101_RUINS_OF_ALPH_OUTSIDE", "D25R0101_UNION_CAVE_1F", "D25R0102_UNION_CAVE_B1F",
+            "D25R0103_UNION_CAVE_B2F", "D26R0102_SLOWPOKE_WELL_1F", "D26R0103_SLOWPOKE_WELL_B2F",
+            "D36R0101_ILEX_FOREST", "R34_ROUTE_34", "R35_ROUTE_35", "T27_ECRUTEAK_CITY", "T26_OLIVINE_CITY",
+            "W40_ROUTE_40", "W41_ROUTE_41", "T24_CIANWOOD_CITY", "D42R0102_DARK_CAVE_ROUTE_31_ENTRANCE",
+            "R42_ROUTE_42", "D38R0101_MT_MORTAR_WATERFALL_ROOM", "D38R0103_MT_MORTAR_ROOM_ABOVE_WATERFALL",
+            "D38R0104_MT_MORTAR_B1F", "R43_ROUTE_43", "T29_LAKE_OF_RAGE", "R44_ROUTE_44", "T30_BLACKTHORN_CITY",
+            "D44R0102_DRAGONS_DEN", "D40R0101_WHIRL_ISLANDS_1F", "D40R0104_WHIRL_ISLANDS_B2F", "R45_ROUTE_45",
+            "D42R0101_DARK_CAVE_ROUTE_45_ENTRANCE", "R26_ROUTE_26", "R27_ROUTE_27", "D45R0101_TOHJO_FALLS",
+            "R47_ROUTE_47"]
+ROCK_SMASH = [(28, ["D24R0101_RUINS_OF_ALPH_OUTSIDE", "D42R0102_DARK_CAVE_ROUTE_31_ENTRANCE"]),
+              (34, ["T24_CIANWOOD_CITY", "D50R0101_CLIFF_CAVE"])]
+# (the boss's average, or "league" for league_wild.py's band, and the Headbutt areas that follow it)
+HEADBUTT_GROUPS = [
+    (22, ["newBarkTown", "route29", "cherrygroveCity", "route30", "route31", "violetCity", "route32", "route33",
+          "azaleaTown", "ilexForest", "route34", "route46"]),
+    (28, ["route35", "nationalPark", "route36", "route37", "ecruteakCity"]),
+    (34, ["route38", "route39", "route47", "route48", "safariZoneGateOutside"]),
+    (40, ["route42", "route43", "lakeOfRage"]),
+    (45, ["route44"]),
+    (49, ["route45"]),
+    ("league", ["route26", "route27"]),
+]
+
+
+def band(average):
+    if average == "league":
+        return league_wild.LOW, league_wild.HIGH
+    return round(average * LATER[0]), round(average * LATER[1])
+
+
+def scaler(lo, hi, low, high):
+    """lo..hi onto low..high, keeping order, rounded to the nearest."""
+    def scale(level):
+        level = min(max(level, lo), hi)
+        return high if hi == lo else low + ((level - lo) * (high - low) * 2 + (hi - lo)) // ((hi - lo) * 2)
+    return scale
+
+
+def table(text, name):
+    m = re.search(r"^    \[ENCDATA_%s\] = \{\n.*?^    \},\n" % name, text, re.S | re.M)
+    assert m, name
+    return m
+
+
+def field(block, key):
+    f = re.search(r"\.%s = \{.*?\n        \}," % key, block, re.S)
+    assert f, key
+    return f
+
+
+def span(slots):
+    real = [(a, b) for a, b, s in slots if s != "NONE"]
+    return "%d-%d" % (min(a for a, b in real), max(b for a, b in real)) if real else "-"
+
+
+def encounters(done):
+    text = open(ENCOUNTERS).read()
+    edits = []                  # (start, end, new text)
+    for name in GOOD_ROD:
+        m = table(text, name)
+        surf = [(int(a), int(b), s) for a, b, s in re.findall(SLOT, field(m.group(0), "surfSlots").group(0))]
+        real = [(a, b) for a, b, s in surf[:4] if s != "NONE"]
+        low, high = min(a for a, b in real), max(b for a, b in real)
+        rod = field(m.group(0), "goodRodSlots")
+        old = [(int(a), int(b), s) for a, b, s in re.findall(SLOT, rod.group(0))]
+        new = [(a, b, s) if s == "NONE" else (low, high, s) for a, b, s in old]
+        it = iter(new)
+        edits.append((m.start() + rod.start(), m.start() + rod.end(),
+                      re.sub(SLOT, lambda x: "{ %d, %d, SPECIES_%s }" % next(it), rod.group(0))))
+        done.append(("Good Rod", name, span(old), span(new)))
+    for average, names in ROCK_SMASH:
+        low, high = band(average)
+        for name in names:
+            m = table(text, name)
+            rs = field(m.group(0), "rockSmashSlots")
+            old = [(int(a), int(b), s) for a, b, s in re.findall(SLOT, rs.group(0))]
+            real = [x for a, b, s in old if s != "NONE" for x in (a, b)]
+            scale = scaler(min(real), max(real), low, high)
+            new = [(a, b, s) if s == "NONE" else (scale(a), scale(b), s) for a, b, s in old]
+            it = iter(new)
+            edits.append((m.start() + rs.start(), m.start() + rs.end(),
+                          re.sub(SLOT, lambda x: "{ %d, %d, SPECIES_%s }" % next(it), rs.group(0))))
+            done.append(("Rock Smash", name, span(old), span(new)))
+    for start, end, new in sorted(edits, reverse=True):     # from the end, so earlier offsets still hold
+        text = text[:start] + new + text[end:]
+    open(ENCOUNTERS, "w").write(text)
+
+
+def headbutt(done):
+    text = open(HEADBUTT).read()
+    edits = []
+    for average, areas in HEADBUTT_GROUPS:
+        low, high = band(average)
+        found = {}
+        for area in areas:
+            m = re.search(r"^    \.%s = \{\n.*?^    \},\n" % area, text, re.S | re.M)
+            assert m, area
+            normal = re.search(r"\.normalSlots =\s*\{.*?\n        \},", m.group(0), re.S)
+            special = re.search(r"\.specialSlots =\s*\{.*?\n        \},", m.group(0), re.S)
+            found[area] = (m, normal, special)
+        # the scale runs over the normal trees of the whole group, as surf_wild.py's over its tables
+        every = [int(x) for _, normal, _ in found.values() for s, a, b in re.findall(HB_SLOT, normal.group(0))
+                 if s != "NONE" for x in (a, b)]
+        scale = scaler(min(every), max(every), low, high)
+        for area, (m, normal, special) in found.items():
+            for part, rare in ((normal, False), (special, True)):
+                old = [(s, int(a), int(b)) for s, a, b in re.findall(HB_SLOT, part.group(0))]
+                if not any(s != "NONE" for s, a, b in old):
+                    continue
+                new = [(s, a, b) if s == "NONE" else (s, high + 2, high + 2) if rare else (s, scale(a), scale(b))
+                       for s, a, b in old]
+                it = iter(new)
+                edits.append((m.start() + part.start(), m.start() + part.end(),
+                              re.sub(HB_SLOT, lambda x: "{ SPECIES_%s, %d, %d }" % next(it), part.group(0))))
+                flip = lambda xs: [(a, b, s) for s, a, b in xs]
+                done.append(("Headbutt" + (" (special)" if rare else ""), area, span(flip(old)), span(flip(new))))
+    for start, end, new in sorted(edits, reverse=True):
+        text = text[:start] + new + text[end:]
+    open(HEADBUTT, "w").write(text)
+
+
+def main():
+    done = []
+    encounters(done)
+    headbutt(done)
+    for kind, name, old, new in done:
+        print("%-20s %-42s Lv. %-6s -> %s" % (kind, name, old, new))
+
+
+if __name__ == "__main__":
+    main()
