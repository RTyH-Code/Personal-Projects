+#!/usr/bin/env python3
+"""Wild Pokemon in Johto's side areas in line with the main path beside them.
+
+johto_wild.py put the main path a little under each boss, which left some
+optional areas a player visits on the way well below the route next to
+them: the Ruins of Alph's chambers at Lv. 5 beside Route 32 at 13, the Bell
+Tower at 23-28 and the Whirl Islands at 25-29 when the main path is at
+34-38, Route 45 and Dark Cave's Route 45 side at 23-31 after Clair. Each is
+tied to the boss a player would face next when going there, and its
+walking levels move into the same band as johto_wild.py's, 75-85% of that
+boss's average, keeping their order:
+    Ruins of Alph chambers             Proton and Bugsy (17)
+    Bell Tower, Whirl Islands           Clair (45): the Clear Bell, the Silver
+                                        Wing and Whirlpool come after the
+                                        Radio Tower
+    Route 45, Dark Cave (Route 45 side) the rival on Victory Road (49)
+Areas already above their neighbours (Union Cave B2F, Slowpoke Well B2F,
+the top of Mt. Mortar, the Ruins of Alph outside) are unchanged, and so are
+surfing, fishing, Rock Smash and the post-game Routes 47 and 48. Wild
+Pokemon are not evolved, as in johto_wild.py.
+
+Run once from the hg-engine root, after johto_wild.py:
+    python3 tools/hack/side_wild.py
+"""
+import re
+
+from johto_wild import LATER
+
+ENCOUNTERS = "data/Encounters.c"
+GROUPS = [
+    (17, ["D24R0205_RUINS_OF_ALPH_INSIDE_MAIN_ROOM", "D24R0216_RUINS_OF_ALPH_INSIDE_MAIN_ROOM_UNUSED",
+          "D24R0217_RUINS_OF_ALPH_INSIDE_LADDER_ROOM", "D24R0218_RUINS_OF_ALPH_INSIDE_MAIN_ROOM_UNUSED"]),
+    (45, ["D17R01%02d_BELL_TOWER_%dF" % (n, n) for n in range(2, 10)] + ["D17R0112_BELL_TOWER_10F",
+          "D40R0101_WHIRL_ISLANDS_1F", "D40R0102_WHIRL_ISLANDS_B1F", "D40R0104_WHIRL_ISLANDS_B2F",
+          "D40R0106_WHIRL_ISLANDS_B3F_LEDGE_OVERLOOKING_LUGIA_ROOM"]),
+    (49, ["R45_ROUTE_45", "D42R0101_DARK_CAVE_ROUTE_45_ENTRANCE"]),
+]
+
+
+def main():
+    text = open(ENCOUNTERS).read()
+    done = []
+    for average, tables in GROUPS:
+        low, high = round(average * LATER[0]), round(average * LATER[1])
+        found = {}
+        for name in tables:
+            m = re.search(r"^    \[ENCDATA_%s\] = \{\n.*?^    \},\n" % name, text, re.S | re.M)
+            assert m, name
+            levels = re.search(r"\.levels = \{\s*([\d,\s]+?)\s*\}", m.group(0))
+            found[name] = (m, levels, [int(x) for x in re.findall(r"\d+", levels.group(1))])
+        every = [x for _, _, levels in found.values() for x in levels if x]
+        lo, hi = min(every), max(every)
+
+        def scale(level):
+            if not level:
+                return 0
+            return high if hi == lo else low + ((level - lo) * (high - low) * 2 + (hi - lo)) // ((hi - lo) * 2)
+        for name, (m, levels, old) in found.items():
+            done.append((name, "%d-%d" % (min(old), max(old)), "%d-%d" % (scale(min(old)), scale(max(old)))))
+        # from the end of the file, so that earlier offsets still hold
+        for name, (m, levels, old) in sorted(found.items(), key=lambda kv: -kv[1][0].start()):
+            start, end = m.start() + levels.start(1), m.start() + levels.end(1)
+            text = text[:start] + ", ".join(str(scale(x)) for x in old) + text[end:]
+    open(ENCOUNTERS, "w").write(text)
+    for name, old, new in done:
+        print("%-56s Lv. %-6s -> %s" % (name, old, new))
+
+
+if __name__ == "__main__":
+    main()
