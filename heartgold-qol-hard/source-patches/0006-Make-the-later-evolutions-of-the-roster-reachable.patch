+#!/usr/bin/env python3
+"""Make the later-generation evolutions of the hack's roster reachable.
+
+hg-engine lists Annihilape and Wyrdeer with an evolution method it does not
+implement (using a move 20 times), and Primeape cannot learn Rage Fist at
+all because the move is unimplemented. Instead:
+  - Primeape evolves into Annihilape at level 40.
+  - Stantler learns Psyshield Bash at level 31 and evolves into Wyrdeer
+    when it levels up knowing it, the way Girafarig and Dunsparce evolve.
+
+Kleavor, Ursaluna, Farigiraf, Dudunsparce and Sylveon already work.
+
+Run once from the hg-engine root against unmodified data:
+    python3 tools/hack/later_evos.py
+"""
+import re
+
+EVOLUTIONS = "data/Evolutions.c"
+LEARNSETS = "data/learnsets/learnsets.json"
+
+ANNIHILAPE_LEVEL = 40
+WYRDEER_MOVE = "MOVE_PSYSHIELD_BASH"
+WYRDEER_MOVE_LEVEL = 31
+
+
+def replace_once(text, old, new, what):
+    if text.count(old) != 1:
+        raise SystemExit("expected exactly one " + what)
+    return text.replace(old, new)
+
+
+def main():
+    text = open(EVOLUTIONS).read()
+    text = replace_once(text, "{ EVO_FORM_ARGUMENT, 20, SPECIES_ANNIHILAPE }",
+                        "{ EVO_LEVEL, %d, SPECIES_ANNIHILAPE }" % ANNIHILAPE_LEVEL, "Annihilape evolution")
+    text = replace_once(text, "{ EVO_FORM_ARGUMENT, 20, SPECIES_WYRDEER }",
+                        "{ EVO_HAS_MOVE, %s, SPECIES_WYRDEER }" % WYRDEER_MOVE, "Wyrdeer evolution")
+    open(EVOLUTIONS, "w").write(text)
+
+    text = open(LEARNSETS).read()
+    m = re.search(r'  "SPECIES_STANTLER": \{\n    "LevelMoves": \[\n(.*?)\n    \],', text, re.S)
+    if not m or WYRDEER_MOVE in m.group(1):
+        raise SystemExit("unexpected Stantler learnset")
+    entries = re.findall(r'      \{\n        "Level": (\d+),\n        "Move": "\w+"\n      \}', m.group(1))
+    pieces = m.group(1).split(",\n      {")
+    if len(pieces) != len(entries):
+        raise SystemExit("could not split Stantler learnset")
+    at = sum(1 for level in entries if int(level) <= WYRDEER_MOVE_LEVEL)
+    new = '\n        "Level": %d,\n        "Move": "%s"\n      }' % (WYRDEER_MOVE_LEVEL, WYRDEER_MOVE)
+    pieces.insert(at, new)
+    text = text[:m.start(1)] + ",\n      {".join(pieces) + text[m.end(1):]
+    open(LEARNSETS, "w").write(text)
+    print("Primeape -> Annihilape at level %d" % ANNIHILAPE_LEVEL)
+    print("Stantler learns %s at level %d and evolves knowing it" % (WYRDEER_MOVE, WYRDEER_MOVE_LEVEL))
+
+
+if __name__ == "__main__":
+    main()
