-                && !PlayerProfile_TestBadgeFlag(Sav2_PlayerData_GetProfileAddr(ctx->fsys->savedata), sSpecificBadgeLockedMartItems[j].required_badges)) {
-                locked = TRUE;
-            }
-        }
         if (!locked) {
             items[index] = stock[i];
