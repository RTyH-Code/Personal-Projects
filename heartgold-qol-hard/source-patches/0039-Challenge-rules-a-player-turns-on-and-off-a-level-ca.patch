diff --git a/tools/hack/challenge_rules.py b/tools/hack/challenge_rules.py
new file mode 100644
index 000000000..487028993
--- /dev/null
+++ b/tools/hack/challenge_rules.py
@@ -0,0 +1,207 @@
+#!/usr/bin/env python3
+"""Challenge rules a player can turn on and off: a level cap and no items in trainer battles.
+
+hg-engine has both only as rules fixed when the ROM is built (IMPLEMENT_LEVEL_CAP, read from a script
+variable, and DISABLE_ITEMS_IN_TRAINER_BATTLE). This makes them choices instead, kept in one script
+variable, CHALLENGE_RULES_VARIABLE (0x416F, which the game itself never uses): 1 turns on the level cap,
+2 turns off items in trainer battles, for the player and the opponents alike. A woman in the player's house
+in New Bark Town, downstairs to the right, sets them, and can be asked again at any time to change them.
+
+The level cap, when on, is the strongest level on the next boss's team: the lowest top level of the Johto
+Gym Leaders not yet beaten (Falkner's 14 up to Clair's 47); with all eight Johto badges, Lance's 58 until
+the Champion is beaten; then the lowest top level of the Kanto Gym Leaders not yet beaten (Lt. Surge's 64
+up to Blue's 76); and with all sixteen badges, Red's 95 (the second round's Lance needed more than his own
+88 in the playtests). A Pokemon at the cap gains no experience, and Rare Candies stop there too. Set mode
+needs nothing: it is the game's own Battle Style option.
+
+It needs the vanilla dump of the player's house (make dump_scripts, as for fossil_reviver.py):
+    python3 tools/hack/challenge_rules.py /path/to/dumped/hg-engine
+"""
+import json
+import os
+import re
+import sys
+
+HOUSE_SCRIPT = "data/scr_seq/scr_seq_0845_T20R0201.s"
+HOUSE_INCLUDE = "data/scr_seq/include/event_T20R0201.inc"
+HOUSE_EVENTS = "data/eventdata/zone_event/060_T20R0201.json"
+HOUSE_TEXT = "data/text/custom/545.txt"
+NEW_SCRIPT = 7                   # the house has scripts 0-6
+NEW_OBJECT = 1                   # and Mom, object 0
+POSITION = (11, 7)               # the right-hand side of the room, clear of the stairs, the door and Mom's walk
+
+# in the text archive's own escapes: \n a new line, \r the next box
+MESSAGES = [
+    r"Hello, dear. I keep the challenge\nrules for trainers who want them.\rWhich rule would you like to change?",
+    r"Level cap",
+    r"No items in battle",
+    r"That’s all",
+    r"The level cap is on.\rYour Pokémon won’t grow past the\nstrongest of the next boss’s team.",
+    r"The level cap is off.",
+    r"Items are off in trainer battles,\nfor you and for your opponents.",
+    r"Items are back on in trainer battles.",
+    r"Come back if you change your mind.\nGood luck out there!",
+]
+
+SCRIPT = """
+// challenge rules (tools/hack/challenge_rules.py): VAR_UNK_416F holds them, 1 the level cap and 2 no items
+scr_seq_T20R0201_{n:03d}:
+	play_se SEQ_SE_DP_SELECT
+	lockall
+	faceplayer
+	npc_msg {m0}
+_rules_menu:
+	touchscreen_menu_hide
+	menu_init 1, 1, 0, 1, VAR_SPECIAL_RESULT
+	menu_item_add {m1}, 255, 0
+	menu_item_add {m2}, 255, 1
+	menu_item_add {m3}, 255, 2
+	menu_exec
+	touchscreen_menu_show
+	compare VAR_SPECIAL_RESULT, 0
+	goto_if_eq _rules_cap
+	compare VAR_SPECIAL_RESULT, 1
+	goto_if_eq _rules_items
+	npc_msg {m8}
+	wait_button_or_walk_away
+	closemsg
+	releaseall
+	end
+
+_rules_cap:
+	compare VAR_UNK_416F, 1
+	goto_if_eq _rules_cap_off
+	compare VAR_UNK_416F, 3
+	goto_if_eq _rules_cap_off
+	addvar VAR_UNK_416F, 1
+	npc_msg {m4}
+	goto _rules_menu
+
+_rules_cap_off:
+	subvar VAR_UNK_416F, 1
+	npc_msg {m5}
+	goto _rules_menu
+
+_rules_items:
+	compare VAR_UNK_416F, 2
+	goto_if_ge _rules_items_off
+	addvar VAR_UNK_416F, 2
+	npc_msg {m6}
+	goto _rules_menu
+
+_rules_items_off:
+	subvar VAR_UNK_416F, 2
+	npc_msg {m7}
+	goto _rules_menu
+"""
+
+CONFIG = "include/config.h"
+POKEMON = "src/pokemon.c"
+CONTROLLER = "src/battle/battle_controller_player.c"
+
+LEVEL_CAP = '''#ifdef IMPLEMENT_LEVEL_CAP
+    u32 levelCap = GetScriptVar(LEVEL_CAP_VARIABLE);
+    if (levelCap > 100 || levelCap == 0) {
+        levelCap = 100;
+    }
+    return levelCap;
+#else'''
+CHALLENGE_CAP = '''#ifdef IMPLEMENT_LEVEL_CAP
+    // the hack's challenge rules (tools/hack/challenge_rules.py): with the level cap on, the strongest level on
+    // the next boss's team.  the lowest top level of the Gym Leaders not yet beaten, Johto's first; Lance's
+    // until the Champion is beaten; Red's once all sixteen badges are had
+    static const u8 johtoCaps[8] = { 14, 19, 24, 29, 34, 38, 42, 47 };  // Falkner, Bugsy, Whitney, Morty, Chuck, Jasmine, Pryce, Clair
+    static const u8 kantoCaps[8] = { 70, 68, 64, 66, 68, 66, 72, 76 };  // Brock, Misty, Lt. Surge, Erika, Janine, Sabrina, Blaine, Blue
+    struct PlayerProfile *profile;
+    u32 levelCap = 0, i;
+
+    if (!(GetScriptVar(CHALLENGE_RULES_VARIABLE) & CHALLENGE_RULE_LEVEL_CAP)) {
+        return 100;
+    }
+    profile = Sav2_PlayerData_GetProfileAddr(SaveBlock2_get());
+    for (i = 0; i < 8; i++) {
+        if (!PlayerProfile_TestBadgeFlag(profile, i) && (levelCap == 0 || johtoCaps[i] < levelCap)) {
+            levelCap = johtoCaps[i];
+        }
+    }
+    if (levelCap) {
+        return levelCap;
+    }
+    if (!CheckScriptFlag(2404)) {   // FLAG_GAME_CLEAR
+        return 58;
+    }
+    for (i = 0; i < 8; i++) {
+        if (!PlayerProfile_TestBadgeFlag(profile, 8 + i) && (levelCap == 0 || kantoCaps[i] < levelCap)) {
+            levelCap = kantoCaps[i];
+        }
+    }
+    return levelCap ? levelCap : 95;
+#else'''
+
+
+def edit(path, old, new):
+    text = open(path, encoding="utf-8").read()
+    if old not in text:
+        sys.exit("not found in %s: %s" % (path, old[:60]))
+    open(path, "w", encoding="utf-8").write(text.replace(old, new, 1))
+
+
+def main():
+    dump = sys.argv[1]
+    read = lambda path: open(os.path.join(dump, path), encoding="utf-8", newline="").read()
+
+    text = read(HOUSE_TEXT).split("\r\n")
+    if text[-1] == "":
+        text.pop()
+    first = len(text)
+    text += MESSAGES
+    numbers = {"m%d" % k: first + k for k in range(len(MESSAGES))}
+
+    script = read(HOUSE_SCRIPT)
+    script = script.replace("scrdef_end", "scrdef scr_seq_T20R0201_%03d\nscrdef_end" % NEW_SCRIPT, 1)
+    script = script.rstrip("\n") + "\n" + SCRIPT.format(n=NEW_SCRIPT, **numbers)
+
+    include = read(HOUSE_INCLUDE)
+    include = include.replace("\n.equ obj_T20R0201_gsmama",
+                              "\n.equ _EV_scr_seq_T20R0201_%03d, %d\n\n.equ obj_T20R0201_gsmama" % (NEW_SCRIPT, NEW_SCRIPT), 1)
+    include = include.replace("\n.endif", "\n.equ obj_T20R0201_rules, %d\n\n.endif" % NEW_OBJECT, 1)
+
+    events = json.loads(read(HOUSE_EVENTS))
+    if len(events["object_events"]) != NEW_OBJECT:
+        sys.exit("unexpected number of objects in the player's house")
+    events["object_events"].append({
+        "id": "obj_T20R0201_rules",
+        "graphics_id": "SPRITE_GSOLDWOMAN1",
+        "movement_type": 15,
+        "trainer_type": 0,
+        "hidden_flag": "FLAG_NOTHING",
+        "script": "_EV_scr_seq_T20R0201_%03d + 1" % NEW_SCRIPT,
+        "initial_dir": 2,      # facing left, into the room
+        "param0": 0, "param1": 0, "param2": 0,
+        "movement_range_x": 0, "movement_range_z": 0,
+        "x": POSITION[0], "z": POSITION[1], "y": 0,
+    })
+
+    for path, content in ((HOUSE_SCRIPT, script), (HOUSE_INCLUDE, include),
+                          (HOUSE_EVENTS, json.dumps(events, indent=2) + "\n"),
+                          (HOUSE_TEXT, "\r\n".join(text) + "\r\n")):
+        os.makedirs(os.path.dirname(path), exist_ok=True)
+        open(path, "w", encoding="utf-8", newline="").write(content)
+        print("wrote", path)
+
+    edit(CONFIG, "// #define IMPLEMENT_LEVEL_CAP\n// #define LEVEL_CAP_VARIABLE 0x416F",
+         "#define IMPLEMENT_LEVEL_CAP\n#define LEVEL_CAP_VARIABLE 0x416F\n"
+         "// the hack's challenge rules, which a player turns on and off (tools/hack/challenge_rules.py)\n"
+         "#define CHALLENGE_RULES_VARIABLE 0x416F\n#define CHALLENGE_RULE_LEVEL_CAP 1\n#define CHALLENGE_RULE_NO_ITEMS 2")
+    edit(POKEMON, LEVEL_CAP, CHALLENGE_CAP)
+    edit(CONTROLLER, "#if defined(DISABLE_ITEMS_IN_TRAINER_BATTLE)\nvoid overrideItemUsage",
+         "#if defined(DISABLE_ITEMS_IN_TRAINER_BATTLE) || defined(CHALLENGE_RULES_VARIABLE)\nvoid overrideItemUsage")
+    edit(CONTROLLER, "#if defined(DISABLE_ITEMS_IN_TRAINER_BATTLE)\n    overrideItemUsage(bsys, ctx);\n#endif",
+         "#if defined(DISABLE_ITEMS_IN_TRAINER_BATTLE)\n    overrideItemUsage(bsys, ctx);\n"
+         "#elif defined(CHALLENGE_RULES_VARIABLE)\n    if (GetScriptVar(CHALLENGE_RULES_VARIABLE) & CHALLENGE_RULE_NO_ITEMS) {  // the no-items challenge rule\n"
+         "        overrideItemUsage(bsys, ctx);\n    }\n#endif")
+    print("edited", CONFIG, POKEMON, CONTROLLER)
+
+
+if __name__ == "__main__":
+    main()
-- 
