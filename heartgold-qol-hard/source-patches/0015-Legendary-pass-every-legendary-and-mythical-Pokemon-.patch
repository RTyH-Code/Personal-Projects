+#!/usr/bin/env python3
+"""Legendary pass: every legendary and mythical Pokemon can be caught.
+
+HeartGold only has some of them, and several of those need a trade or an
+event. This adds the missing ones as Pokemon standing in the overworld, each
+in a fitting place and each behind a point in the story, and raises the
+levels of the ones the game already has to fit the hack's level curve.
+
+A new legendary works like the game's own ones (Articuno and so on): talk to
+it to fight it. If it is caught it is gone for good; if it faints or the
+player runs, it is back the next time the map is entered.
+
+It needs the vanilla dump of the maps, which hg-engine makes with
+    make dump_scripts DUMP_ROM=rom.nds
+(run that in a scratch copy of hg-engine; it rewrites base/). Pass the
+dumped tree as the argument:
+    python3 tools/hack/legendaries.py /path/to/dumped/hg-engine
+
+--demo NAME,NAME,... also puts those new legendaries, with no conditions, in
+New Bark Town and makes the stairs in the player's bedroom lead there.
+That is for testing only and must never be part of a release.
+"""
+import json
+import os
+import re
+import sys
+
+# story points
+CHAMPION = ["goto_if_unset FLAG_GAME_CLEAR, {skip}"]
+# Professor Oak sets this flag when he sees all sixteen badges
+SIXTEEN_BADGES = ["goto_if_unset FLAG_UNLOCKED_MT_SILVER, {skip}"]
+# this variable leaves 0 when Red is beaten and never returns to it
+RED = ["compare VAR_UNK_4131, 0", "goto_if_eq {skip}"]
+
+
+def has(species):
+    return ["player_has_species VAR_SPECIAL_RESULT, SPECIES_%s" % species,
+            "compare VAR_SPECIAL_RESULT, 0", "goto_if_eq {skip}"]
+
+
+# name, level, map, script file, header file, event file, (x, z), conditions, sprite
+NEW = [
+    ("REGIROCK", 60, "D24R0212", "0049", "0310", "295", (6, 10), CHAMPION, None),
+    ("REGICE", 60, "D24R0213", "0050", "0311", "296", (6, 10), CHAMPION, None),
+    ("REGISTEEL", 60, "D24R0214", "0051", "0312", "297", (6, 10), CHAMPION, None),
+    ("REGIGIGAS", 75, "D24R0215", "0052", "0313", "298", (6, 10),
+     CHAMPION + has("REGIROCK") + has("REGICE") + has("REGISTEEL"), None),
+    ("UXIE", 60, "D25R0103", "0058", "0319", "149", (12, 87), CHAMPION, None),
+    ("MESPRIT", 60, "T29", "0938", "0711", "085", (525, 66), CHAMPION, None),
+    ("AZELF", 60, "D44R0102", "0111", "0372", "239", (32, 25), CHAMPION, None),
+    ("HEATRAN", 65, "T09", "0815", "0588", "054", (1047, 497), CHAMPION, None),
+    ("CRESSELIA", 65, "D02R0103", "0009", "0270", "404", (9, 11), CHAMPION, None),
+    ("CELEBI", 65, "D36R0101", "0092", "0353", "114", (15, 43), CHAMPION, "SPRITE_FOLLOWER_MON_STATIC_CELEBI"),
+    ("SHAYMIN", 65, "D22R0101", "0025", "0286", "093", (51, 48), CHAMPION, None),
+    ("MANAPHY", 65, "D40R0104", "0103", "0364", "229", (30, 48), CHAMPION, None),
+    ("GROUDON", 70, "D52R0102", "0134", "0395", "477", (16, 11),
+     SIXTEEN_BADGES + ["goto_if_unset FLAG_CAUGHT_KYOGRE, {skip}"], "SPRITE_FOLLOWER_MON_STATIC_GROUDON"),
+    ("DIALGA", 75, "D24R0205", "0042", "0303", "286", (15, 13), SIXTEEN_BADGES, None),
+    ("PALKIA", 75, "D24R0205", "0042", "0303", "286", (15, 31), SIXTEEN_BADGES, None),
+    ("GIRATINA", 75, "D24R0205", "0042", "0303", "286", (15, 41), SIXTEEN_BADGES, None),
+    ("ARCEUS", 80, "D24R0205", "0042", "0303", "286", (15, 4), RED, None),
+    ("MEW", 80, "D41R0108", "0107", "0368", "419", (30, 10), RED, None),
+    ("JIRACHI", 80, "R25", "0216", "0461", "026", (1421, 39), RED, None),
+    ("DEOXYS", 80, "R03", "0175", "0420", "008", (1141, 115), RED, None),
+    ("DARKRAI", 80, "D42R0101", "0108", "0369", "120", (42, 42), RED, None),
+]
+# Set while one of the new legendaries is being fought. The game has a flag like it for its own static
+# Pokemon, but a map's own script hides that map's own Pokemon when it sees it, so the new ones need theirs.
+ENGAGING = "FLAG_UNK_54F"
+FIRST_FLAG = 0x520
+# National Pokedex numbers. hg-engine numbers every Pokemon's overworld sprite as MON_OVERWORLD_TAG_START (2500)
+# plus its species; the SPRITE_FOLLOWER_MON_... names in sprites.inc are the original game's numbers and no
+# longer exist, apart from the ..._STATIC_... ones.
+DEX = {"MEW": 151, "REGIROCK": 377, "REGICE": 378, "REGISTEEL": 379, "JIRACHI": 385, "DEOXYS": 386, "UXIE": 480,
+       "MESPRIT": 481, "AZELF": 482, "DIALGA": 483, "PALKIA": 484, "HEATRAN": 485, "REGIGIGAS": 486,
+       "GIRATINA": 487, "CRESSELIA": 488, "MANAPHY": 490, "DARKRAI": 491, "SHAYMIN": 492, "ARCEUS": 493}
+MON_OVERWORLD_TAG_START = 2500   # FLAG_UNK_520 to FLAG_UNK_54F are not used by any script or by the game's code
+DEMO_MAP = ("T20", "0842", "0615", "057")
+
+# the game's own static Pokemon: file, old command, new level
+LEVELS = [
+    ("scr_seq_0938_T29.s", "wild_battle SPECIES_GYARADOS, 30, 1", 34),
+    ("scr_seq_0243_R36.s", "wild_battle SPECIES_SUDOWOODO, 20, 0", 22),
+    ("scr_seq_0058_D25R0103.s", "wild_battle SPECIES_LAPRAS, 20, 0", 22),
+    ("scr_seq_0024_D18R0102.s", "wild_battle SPECIES_SUICUNE, 40, 0", 60),
+    ("scr_seq_0216_R25.s", "wild_battle SPECIES_SUICUNE, 40, 0", 60),
+    ("scr_seq_0197_R11.s", "wild_battle SPECIES_SNORLAX, 50, 0", 65),
+    ("scr_seq_0199_R12.s", "wild_battle SPECIES_SNORLAX, 50, 0", 65),
+    ("scr_seq_0014_D11R0105.s", "wild_battle SPECIES_ARTICUNO, 50, 0", 65),
+    ("scr_seq_0191_R10.s", "wild_battle SPECIES_ZAPDOS, 50, 0", 65),
+    ("scr_seq_0106_D41R0105.s", "wild_battle SPECIES_MOLTRES, 50, 0", 65),
+    ("scr_seq_0134_D52R0102.s", "wild_battle SPECIES_KYOGRE, 50, 0", 70),
+    ("scr_seq_0135_D52R0103.s", "wild_battle SPECIES_RAYQUAZA, 50, 0", 75),
+    ("scr_seq_0011_D03R0103.s", "wild_battle SPECIES_MEWTWO, 70, 0", 80),
+    # Ho-Oh in HeartGold: 45 before the League (Lugia, met later, stays at 70)
+    ("scr_seq_0021_D17R0110.s", "setvar VAR_SPECIAL_x8004, 45", 52),
+]
+
+
+class Tree:
+    """The dumped files, edited in memory and written to the hack's tree at the end."""
+
+    def __init__(self, dump):
+        self.dump = dump
+        self.files = {}
+
+    def get(self, path):
+        if path not in self.files:
+            # newline="" keeps each file's own line endings
+            self.files[path] = open(os.path.join(self.dump, path), encoding="utf-8", newline="").read()
+            # a script file is built with its map's include file, so that has to come along
+            for include in re.findall(r'^\.include "(data/scr_seq/include/[^"]+)"', self.files[path], re.M):
+                self.get(include)
+        return self.files[path]
+
+    def put(self, path, content):
+        self.files[path] = content
+
+    def write(self):
+        for path, content in sorted(self.files.items()):
+            os.makedirs(os.path.dirname(path), exist_ok=True)
+            open(path, "w", encoding="utf-8", newline="").write(content)
+            print("wrote", path)
+
+
+def find(tree, number, code, suffix=""):
+    name = "data/scr_seq/scr_seq_%s_%s%s.s" % (number, code, suffix)
+    tree.get(name)
+    return name
+
+
+def add_script(tree, path, code, body):
+    """Append a script to a map's script file and return its number."""
+    text = tree.get(path)
+    number = len(re.findall(r"^scrdef scr_seq_%s_\d+$" % code, text, re.M))
+    text = text.replace("scrdef_end", "scrdef scr_seq_%s_%03d\nscrdef_end" % (code, number), 1)
+    text = text.rstrip("\n") + "\n\nscr_seq_%s_%03d:\n%s" % (code, number, body)
+    tree.put(path, text)
+    include = "data/scr_seq/include/event_%s.inc" % code
+    inc = tree.get(include)
+    last = "_EV_scr_seq_%s_%03d, %d\n" % (code, number - 1, number - 1)
+    if last not in inc:
+        sys.exit("unexpected include for " + code)
+    tree.put(include, inc.replace(last, last + ".equ _EV_scr_seq_%s_%03d, %d\n" % (code, number, number), 1))
+    return number
+
+
+def hook(tree, script_path, header_path, code, kind, label):
+    """Make the map's init script of this kind (2 = entering the map, 4 = map loaded) call label first."""
+    header = tree.get(header_path)
+    entry = re.search(r"\.byte %d\n\t\.hword (\d+), 0\n" % kind, header)
+    if entry:
+        start = "scr_seq_%s_%03d:\n" % (code, int(entry.group(1)) - 1)
+        text = tree.get(script_path)
+        if start not in text:
+            sys.exit("no %s in %s" % (start.strip(), script_path))
+        tree.put(script_path, text.replace(start, start + "\tcall %s\n" % label, 1))
+    else:
+        number = add_script(tree, script_path, code, "\tcall %s\n\tend\n\t.balign 4\n" % label)
+        if "\n\t.byte 0\n" not in header:
+            sys.exit("unexpected header " + header_path)
+        # new entries go in front of the list's end marker, which is the last ".byte 0" line of the entries;
+        # entries of kinds 2-4 are a byte and a word, so putting one first leaves the others as they were
+        marker = header.index(".data\n") + len(".data\n")
+        while header[marker] == "\n":
+            marker += 1
+        tree.put(header_path, header[:marker] + "\t.byte %d\n\t.hword %d, 0\n" % (kind, number + 1) + header[marker:])
+
+
+def lines(*parts):
+    return "".join("\n" if p == "" else p + "\n" if p.endswith(":") else "\t%s\n" % p for p in parts)
+
+
+def add_legendary(tree, index, name, level, code, script_no, header_no, event_no, position, conditions, sprite,
+                  mode):
+    script_path = find(tree, script_no, code)
+    header_path = find(tree, header_no, code, "_hdr")
+    events_path = "data/eventdata/zone_event/%s_%s.json" % (event_no, code)
+    hide = "FLAG_UNK_%03X" % (FIRST_FLAG + 2 * index)
+    caught = "FLAG_UNK_%03X" % (FIRST_FLAG + 2 * index + 1)
+    tag = "_legend_%s_%s" % (code, name.lower())
+    obj = "obj_%s_legend_%s" % (code, name.lower())
+
+    talk = lines(
+        # the demo hands out Master Balls so that catching can be tested
+        *(["giveitem ITEM_MASTER_BALL, 5, VAR_SPECIAL_RESULT"] if mode == "demo" else []),
+        "play_se SEQ_SE_DP_SELECT", "lockall", "faceplayer",
+        "play_cry SPECIES_%s, 0" % name, "wait_cry",
+        # hidden from here on: gone if it is caught, and back on the next visit if it is not
+        "setflag " + hide,
+        "setflag " + ENGAGING,
+        "wild_battle SPECIES_%s, %d, 0" % (name, level),
+        "clearflag " + ENGAGING,
+        "check_battle_won VAR_SPECIAL_RESULT", "compare VAR_SPECIAL_RESULT, 0", "goto_if_eq %s_lost" % tag,
+        "get_static_encounter_outcome VAR_TEMP_x4002", "compare VAR_TEMP_x4002, 4", "call_if_eq %s_caught" % tag,
+        "releaseall", "end", "",
+        tag + "_lost:", "white_out", "releaseall", "end", "",
+        tag + "_caught:", "setflag " + caught, "return", "",
+        # entering the map: show it only when its conditions are met and it has not been caught
+        tag + "_enter:",
+        "goto_if_set %s, %s_done" % (ENGAGING, tag),
+        "setflag " + hide,
+        "goto_if_set %s, %s_done" % (caught, tag),
+        *[c.format(skip=tag + "_done") for c in conditions],
+        "clearflag " + hide,
+        tag + "_done:", "return", "",
+        # back from the battle: remove it before the screen fades in
+        tag + "_load:",
+        "goto_if_unset %s, %s_done" % (ENGAGING, tag),
+        "goto_if_unset %s, %s_done" % (hide, tag),
+        "hide_person " + obj,
+        "return",
+        ".balign 4")
+    number = add_script(tree, script_path, code, talk)
+    hook(tree, script_path, header_path, code, 2, tag + "_enter")
+    hook(tree, script_path, header_path, code, 4, tag + "_load")
+
+    events = json.loads(tree.get(events_path))
+    objects = events["object_events"]
+    include = "data/scr_seq/include/event_%s.inc" % code
+    inc = tree.get(include)
+    tree.put(include, inc.replace("\n.endif", ".equ %s, %d\n\n.endif" % (obj, len(objects)), 1))
+    objects.append({
+        "id": obj,
+        "graphics_id": sprite or str(MON_OVERWORLD_TAG_START + DEX[name]),
+        "movement_type": 15,   # stands still facing down, like the game's own static Pokemon
+        "trainer_type": 0,
+        "hidden_flag": hide,
+        "script": "_EV_scr_seq_%s_%03d + 1" % (code, number),
+        "initial_dir": 1,
+        "param0": 0, "param1": 0, "param2": 0,
+        "movement_range_x": 0, "movement_range_z": 0,
+        "x": position[0], "z": position[1], "y": 0,
+    })
+    tree.put(events_path, json.dumps(events, indent=2) + "\n")
+
+
+def main():
+    args = [a for a in sys.argv[1:] if not a.startswith("--")]
+    demo = "--demo" in sys.argv
+    demo_names = args[1].split(",") if demo else []
+    tree = Tree(args[0])
+
+    for name, old, level in LEVELS:
+        path = "data/scr_seq/" + name
+        text = tree.get(path)
+        if old not in text:
+            sys.exit("%s: no '%s'" % (name, old))
+        new = re.sub(r"\d+(, [01])?$", lambda m: str(level) + (m.group(1) or ""), old)
+        tree.put(path, text.replace(old, new))
+
+    # Latios roams Kanto with Latias: Steven releases both
+    path = "data/scr_seq/scr_seq_0776_T06.s"
+    text = tree.get(path)
+    if text.count("\tcreate_roamer 2\n") != 1:
+        sys.exit("unexpected Vermilion City script")
+    tree.put(path, text.replace("\tcreate_roamer 2\n", "\tcreate_roamer 2\n\tcreate_roamer 3\n"))
+
+    for index, entry in enumerate(NEW):
+        add_legendary(tree, index, *entry, None)
+
+    if demo:
+        code, script_no, header_no, event_no = DEMO_MAP
+        chosen = [e for e in NEW if e[0] in demo_names]
+        for entry in chosen:
+            index, name, level, sprite = NEW.index(entry), entry[0], entry[1], entry[8]
+            slot = chosen.index(entry)
+            add_legendary(tree, index, name, level, code, script_no, header_no, event_no,
+                          (688 + 2 * slot, 398), [], sprite, "demo")
+        # and the stairs in the player's bedroom lead straight outside
+        path = "data/eventdata/zone_event/061_T20R0202.json"
+        events = json.loads(tree.get(path))
+        events["warp_events"][0].update(dest_header_id="MAP_T20", dest_warp_id=1)
+        tree.put(path, json.dumps(events, indent=2) + "\n")
+    tree.write()
+
+
+if __name__ == "__main__":
+    main()
