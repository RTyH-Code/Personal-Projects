+++ b/tools/hack/corner_items.py
@@ -0,0 +1,57 @@
+#!/usr/bin/env python3
+"""For money, what only the Game Corners' coins bought.
+
+The Goldenrod Game Corner (T25R1101, T25SP0101) and Celadon's prize room (T07R0501) trade coins for TMs, held items
+and Pokemon. The Pokemon (Abra, Ekans, Dratini; Mr. Mime, Eevee, Porygon) are wild or given elsewhere, and Rest,
+Hidden Power and Psychic are gifts, but six TMs and four held items were coin-only, and Thunderbolt, Flamethrower and
+Ice Beam lie on the ground only after the Champion (Cerulean Cave, Route 28, Seafoam Islands). All these are now sold:
+
+- Goldenrod Department Store 5F (TMs): Swords Dance, Double Team and Endure (P10,000) and Substitute (P20,000) from
+  four badges; Gyro Ball (P20,000) and Thunderbolt, Flamethrower and Ice Beam (P30,000) from six; Giga Impact
+  (P30,000) from eight;
+- Goldenrod Department Store 4F: Silk Scarf, Wide Lens, Zoom Lens and Metronome from four badges, P10,000.
+
+    python3 tools/hack/corner_items.py
+"""
+import re
+import sys
+
+MART = "src/field/mart.c"
+ITEMS = "data/itemdata/itemdata.c"
+STOCK = {  # counter: [(item, price, badges needed)]
+    "sGoldenrodDepartment5F": [("TM075", 10000, 4), ("TM032", 10000, 4), ("TM058", 10000, 4), ("TM090", 20000, 4),
+                               ("TM074", 20000, 6), ("TM024", 30000, 6), ("TM035", 30000, 6), ("TM013", 30000, 6),
+                               ("TM068", 30000, 8)],
+    "sGoldenrodDepartment4F": [(i, 10000, 4) for i in ("SILK_SCARF", "WIDE_LENS", "ZOOM_LENS", "METRONOME")],
+}
+
+
+def main():
+    mart, items = open(MART).read(), open(ITEMS).read()
+    for array, stock in STOCK.items():
+        m = re.search(r"(u16 %s\[\] = \{\n)([^}]*?)(,\s*0xFFFF\n\};)" % array, mart)
+        if not m:
+            sys.exit("no " + array)
+        if "ITEM_" + stock[0][0] + "," in m.group(2) or "ITEM_" + stock[0][0] + "\n" in m.group(2):
+            sys.exit("already stocked: " + array)
+        names = [n for n, _, _ in stock]
+        added = ",\n    ".join(", ".join("ITEM_" + n for n in names[i:i + 6]) for i in range(0, len(names), 6))
+        mart = mart.replace(m.group(0), "%s%s,\n    // only the Game Corners' coins bought these (tools/hack/corner_items.py)\n"
+                            "    %s, 0xFFFF\n};" % (m.group(1), m.group(2), added))
+        for name, price, _ in stock:
+            m = re.search(r"\n\[ITEM_%s\] =\n\{\n    ITEM_PRICE\(\d+\)" % name, items)
+            if not m:
+                sys.exit("no item data for " + name)
+            items = items[:m.start()] + re.sub(r"ITEM_PRICE\(\d+\)", "ITEM_PRICE(%d)" % price, m.group(0)) + items[m.end():]
+    head = "const struct BadgeMartItems sBadgeLockedMartItems[] = {\n"
+    if head not in mart:
+        sys.exit("no sBadgeLockedMartItems")
+    mart = mart.replace(head, head + "    // only the Game Corners' coins bought these (tools/hack/corner_items.py)\n"
+                        + "".join("    { ITEM_%s, %d },\n" % (n, b) for stock in STOCK.values() for n, _, b in stock if b))
+    open(MART, "w").write(mart)
+    open(ITEMS, "w").write(items)
+    print("stocked", ", ".join(STOCK))
+
+
+if __name__ == "__main__":
+    main()
