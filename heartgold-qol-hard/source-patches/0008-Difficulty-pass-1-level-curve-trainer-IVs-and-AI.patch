index 000000000..0d2022a04
--- /dev/null
+++ b/tools/hack/difficulty.py
@@ -0,0 +1,93 @@
+#!/usr/bin/env python3
+"""Difficulty pass, part 1: trainer levels, IVs and AI.
+
+1. Levels follow the hack's curve (see levels.py):
+   - Johto trainers and the first Elite Four round: johto_level(), which
+     turns the boss aces 13/17/19/25/31/35/34/41/50 into
+     14/19/22/29/36/40/39/47/58. The Gym Leaders get hand-built teams in a
+     later pass, which is where the intended Chuck, Jasmine, Pryce order
+     comes from.
+   - Kanto trainers and the post-game rematch teams: 1.3x.
+   - The second Elite Four round: 1.2x.
+   - Red: +7 levels (ace Lv. 95).
+2. IVs: every trainer Pokemon gets at least MIN_IV; bosses get BOSS_IV.
+3. Every trainer gets the smart AI flags, on top of any it already had.
+
+Which region a trainer belongs to comes from trainer_regions.json, built
+from the map event files and scripts of pret/pokeheartgold (every map a
+trainer stands on or is battled from). Trainers that aren't placed on a map
+are phone rematch teams and unused entries; they count as post-game when
+their highest level is POSTGAME_REMATCH_LEVEL or more.
+
+Run once from the hg-engine root against unmodified trainer data:
+    python3 tools/hack/difficulty.py
+"""
+import json
+import os
+import re
+
+from levels import johto_level, scaled
+
+TRAINERS = "data/Trainers.c"
+REGIONS = os.path.join(os.path.dirname(__file__), "trainer_regions.json")
+
+KANTO_SCALE = 130               # percent
+ELITE_FOUR_ROUND_2_SCALE = 120  # percent
+ELITE_FOUR_ROUND_2_LEVEL = 58   # League teams with a Pokemon this high are round 2
+POSTGAME_REMATCH_LEVEL = 45
+RED_BONUS = 7
+MIN_IV = 150    # 0-255 scale, about 18 IVs per stat
+BOSS_IV = 255   # 31 IVs
+SMART_AI = ["F_PRIORITIZE_SUPER_EFFECTIVE", "F_EVALUATE_ATTACKS", "F_EXPERT_ATTACKS"]
+BOSS_CLASS = re.compile(r"TRAINERCLASS_(LEADER_|ELITE_FOUR_|CHAMPION|RIVAL|PKMN_TRAINER_RED|PKMN_TRAINER_LANCE|EXECUTIVE|ROCKET_BOSS)")
+
+ENTRY = re.compile(r"^    \[(\d+)\] = \{\n.*?^    \},\n", re.S | re.M)
+
+
+def level_rule(trainer_id, trainer_class, top_level, regions):
+    if trainer_class == "TRAINERCLASS_PKMN_TRAINER_RED":
+        return lambda level: min(100, level + RED_BONUS)
+    region = regions.get(str(trainer_id))
+    if region == "league":
+        if top_level >= ELITE_FOUR_ROUND_2_LEVEL:
+            return lambda level: scaled(level, ELITE_FOUR_ROUND_2_SCALE)
+        return johto_level
+    if region == "kanto" or (region is None and top_level >= POSTGAME_REMATCH_LEVEL):
+        return lambda level: scaled(level, KANTO_SCALE)
+    return johto_level
+
+
+def main():
+    regions = json.load(open(REGIONS))
+    text = open(TRAINERS).read()
+    counts = {"trainers": 0, "pokemon": 0, "bosses": 0}
+
+    def rewrite(match):
+        entry = match.group(0)
+        trainer_id = int(match.group(1))
+        levels = [int(x) for x in re.findall(r"\.level = (\d+),", entry)]
+        if not levels:
+            return entry
+        trainer_class = re.search(r"\.trainerClass = (\w+),", entry).group(1)
+        rule = level_rule(trainer_id, trainer_class, max(levels), regions)
+        boss = bool(BOSS_CLASS.match(trainer_class))
+        entry = re.sub(r"\.level = (\d+),", lambda m: ".level = %d," % rule(int(m.group(1))), entry)
+        entry = re.sub(r"\.ivs = (\d+),",
+                       lambda m: ".ivs = %d," % (BOSS_IV if boss else max(int(m.group(1)), MIN_IV)), entry)
+
+        def ai(m):
+            flags = [f.strip() for f in m.group(1).split("|") if f.strip() not in ("0", "")]
+            return ".aiFlags = %s," % " | ".join(SMART_AI + [f for f in flags if f not in SMART_AI])
+        entry = re.sub(r"\.aiFlags = ([^,]+),", ai, entry)
+        counts["trainers"] += 1
+        counts["pokemon"] += len(levels)
+        counts["bosses"] += boss
+        return entry
+
+    text = ENTRY.sub(rewrite, text)
+    open(TRAINERS, "w").write(text)
+    print("%(trainers)d trainers, %(pokemon)d Pokemon, %(bosses)d boss teams" % counts)
+
+
+if __name__ == "__main__":
+    main()
