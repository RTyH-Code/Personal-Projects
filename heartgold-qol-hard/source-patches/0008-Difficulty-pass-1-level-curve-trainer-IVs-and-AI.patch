@@ -0,0 +1,16 @@
+"""The level curve shared by difficulty.py and wild_levels.py."""
+
+
+def johto_level(level):
+    """Johto and the first Elite Four round: unchanged up to Lv. 8, then a
+    scale that ramps up to 1.15x at Lv. 18 and stays there."""
+    if level <= 8:
+        return level
+    # integer maths so that halves round up (Lv. 50 x 1.15 is 58, not 57)
+    thousandths = 1000 + 15 * min(10, level - 8)
+    return min(100, (level * thousandths + 500) // 1000)
+
+
+def scaled(level, percent):
+    """level x percent/100, halves rounded up, capped at 100."""
+    return min(100, (level * percent + 50) // 100)
