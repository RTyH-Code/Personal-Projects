 tools/hack/levels.py            |   16 +
 tools/hack/trainer_regions.json |  499 ++
 tools/hack/wild_levels.py       |   57 +
 6 files changed, 4859 insertions(+), 4194 deletions(-)
 create mode 100644 tools/hack/difficulty.py
 create mode 100644 tools/hack/levels.py
 create mode 100644 tools/hack/trainer_regions.json
 create mode 100644 tools/hack/wild_levels.py

