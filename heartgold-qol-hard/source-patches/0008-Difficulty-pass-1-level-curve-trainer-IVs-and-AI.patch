@@ -0,0 +1,57 @@
+#!/usr/bin/env python3
+"""Difficulty pass, part 2: Johto wild Pokemon levels follow the trainers.
+
+Grass, cave, surfing and Rock Smash levels in Johto (everything reachable
+before the Elite Four, including Routes 26-27, Tohjo Falls and Victory Road)
+go through johto_level() from levels.py, the same curve the Johto trainers
+use. Fishing, Headbutt trees and the Safari Zone are unchanged, and so is
+all of Kanto, which is left for the post-game pass.
+
+Run once from the hg-engine root against unmodified encounter data:
+    python3 tools/hack/wild_levels.py
+"""
+import re
+
+from levels import johto_level
+
+ENCOUNTERS = "data/Encounters.c"
+
+# encounter tables in Kanto and on Mt. Silver, by the words in their names
+KANTO = ["ROUTE_%d" % i for i in list(range(1, 26)) + [28]] + [
+    "PALLET", "VIRIDIAN", "PEWTER", "CERULEAN", "LAVENDER", "VERMILION", "CELADON", "FUCHSIA", "CINNABAR",
+    "SAFFRON", "DIGLETTS", "MT_MOON", "ROCK_TUNNEL", "SEAFOAM", "POWER_PLANT", "MT_SILVER",
+]
+
+
+def in_kanto(table):
+    return any(re.search(r"(^|_)%s($|_)" % name, table) for name in KANTO)
+
+
+def main():
+    text = open(ENCOUNTERS).read()
+    done = 0
+
+    def rewrite(match):
+        nonlocal done
+        table, body = match.group(1), match.group(0)
+        if in_kanto(table):
+            return body
+        done += 1
+        body = re.sub(r"(\.levels = \{\s*)([\d,\s]+?)(\s*\})",
+                      lambda m: m.group(1) + ", ".join(str(johto_level(int(x))) for x in re.findall(r"\d+", m.group(2))) + m.group(3),
+                      body)
+        for slots in ("surfSlots", "rockSmashSlots"):
+            def block(m):
+                return re.sub(r"\{ (\d+), (\d+), (SPECIES_\w+) \}",
+                              lambda s: "{ %d, %d, %s }" % (johto_level(int(s.group(1))), johto_level(int(s.group(2))), s.group(3)),
+                              m.group(0))
+            body = re.sub(r"\.%s = \{.*?\n        \}," % slots, block, body, flags=re.S)
+        return body
+
+    text = re.sub(r"^    \[ENCDATA_\w+?_([A-Z0-9_]+)\] = \{\n.*?^    \},\n", rewrite, text, flags=re.S | re.M)
+    open(ENCOUNTERS, "w").write(text)
+    print("scaled %d Johto encounter tables" % done)
+
+
+if __name__ == "__main__":
+    main()
-- 
