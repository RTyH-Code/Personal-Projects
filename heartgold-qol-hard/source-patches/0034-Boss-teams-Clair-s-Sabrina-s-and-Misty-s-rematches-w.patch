index 0d6f8daa5..0bcc0a851 100644
--- a/tools/hack/boss_teams.py
+++ b/tools/hack/boss_teams.py
@@ -516,14 +516,26 @@ POSTGAME = {
     717: quick("Jasmine, rematch", 80, ["SKARMORY", "BRONZONG", "MAGNEZONE", "SCIZOR", "METAGROSS", "STEELIX"],
                options={"SKARMORY": {"spread": "wall"}, "BRONZONG": {"spread": "wall"}, "STEELIX": {"spread": "bulky"}}),
     716: quick("Pryce, rematch", 81, ["ABOMASNOW", "WEAVILE", "WALREIN", "LAPRAS", "GLACEON", "MAMOSWINE"]),
+    # the three rematches that beat the second-round set even at their top level (playtest/BALANCE.md), each
+    # without the piece that carried it: Clair's Garchomp without Swords Dance (as Lance's, patch 0031) and
+    # her Flygon and Dragonite without Dragon Dance,
+    # Sabrina's Gardevoir and Gallade without Hypnosis (her lead Mr. Mime keeps it), Misty's Milotic without
+    # Hypnosis and her Gyarados without Dragon Dance (as Blue's and Lance's)
     719: quick("Clair, rematch", 82, ["ALTARIA", "FLYGON", "GARCHOMP", "SALAMENCE", "DRAGONITE", "KINGDRA"],
-               moves={"KINGDRA": ["RAIN_DANCE", "WATERFALL", "OUTRAGE", "ICE_BEAM"]},
+               moves={"KINGDRA": ["RAIN_DANCE", "WATERFALL", "OUTRAGE", "ICE_BEAM"],
+                      "GARCHOMP": ["OUTRAGE", "EARTHQUAKE", "AQUA_TAIL", "CRUNCH"],
+                      "FLYGON": ["EARTHQUAKE", "OUTRAGE", "CRUNCH", "STONE_EDGE"],
+                      "DRAGONITE": ["OUTRAGE", "AERIAL_ACE", "EARTHQUAKE", "FIRE_PUNCH"]},
                options={"KINGDRA": {"ability": "SWIFT_SWIM", "nature": "ADAMANT"}}),
     722: quick("Lt. Surge, rematch", 82, ["ELECTRODE", "MANECTRIC", "JOLTEON", "MAGNEZONE", "ELECTIVIRE", "RAICHU"]),
-    725: quick("Sabrina, rematch", 82, ["MR_MIME", "GARDEVOIR", "GALLADE", "SLOWKING", "ESPEON", "ALAKAZAM"]),
+    725: quick("Sabrina, rematch", 82, ["MR_MIME", "GARDEVOIR", "GALLADE", "SLOWKING", "ESPEON", "ALAKAZAM"],
+               moves={"GARDEVOIR": ["PSYCHIC", "MOONBLAST", "ENERGY_BALL", "CALM_MIND"],
+                      "GALLADE": ["ZEN_HEADBUTT", "SACRED_SWORD", "EARTHQUAKE", "NIGHT_SLASH"]}),
     723: quick("Erika, rematch", 82, ["JUMPLUFF", "ROSERADE", "LEAFEON", "VICTREEBEL", "TANGROWTH", "BELLOSSOM"]),
     724: quick("Janine, rematch", 82, ["CROBAT", "WEEZING", "TOXICROAK", "DRAPION", "NIDOQUEEN", "VENOMOTH"]),
-    721: quick("Misty, rematch", 83, ["POLITOED", "LANTURN", "MILOTIC", "GYARADOS", "LAPRAS", "STARMIE"]),
+    721: quick("Misty, rematch", 83, ["POLITOED", "LANTURN", "MILOTIC", "GYARADOS", "LAPRAS", "STARMIE"],
+               moves={"MILOTIC": ["SURF", "ICE_BEAM", "RECOVER", "DRAGON_PULSE"],
+                      "GYARADOS": ["AQUA_TAIL", "EARTHQUAKE", "ICE_FANG", "CRUNCH"]}),
     720: quick("Brock, rematch", 83, ["STEELIX", "GOLEM", "OMASTAR", "KABUTOPS", "RAMPARDOS", "RHYPERIOR"]),
     726: quick("Blaine, rematch", 83, ["TORKOAL", "CAMERUPT", "NINETALES", "HOUNDOOM", "RAPIDASH", "MAGMORTAR"]),
     727: quick("Blue, rematch", 86, ["EXEGGUTOR", "MACHAMP", "RHYPERIOR", "ARCANINE", "TYRANITAR", "PIDGEOT"],
