From d18d9a8a65b2be08f24343229dbb5b21096a23f3 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 27 Nov 2026 10:24:18 +0000
Subject: [PATCH] Boss teams: Clair's, Sabrina's and Misty's rematches without
 the piece that carried them

---
 data/Trainers.c          | 14 +++++++-------
 tools/hack/boss_teams.py | 18 +++++++++++++++---
 2 files changed, 22 insertions(+), 10 deletions(-)

diff --git a/data/Trainers.c b/data/Trainers.c
index f75bfe88f..249effddd 100644
--- a/data/Trainers.c
+++ b/data/Trainers.c
@@ -31571,7 +31571,7 @@ const TrainerData sTrainerData[] = {
                 .level = 79,
                 .species = SPECIES_FLYGON,
                 .item = ITEM_SOFT_SAND,
-                .moves = { MOVE_EARTHQUAKE, MOVE_OUTRAGE, MOVE_CRUNCH, MOVE_DRAGON_DANCE },
+                .moves = { MOVE_EARTHQUAKE, MOVE_OUTRAGE, MOVE_CRUNCH, MOVE_STONE_EDGE },
                 .ability = ABILITY_LEVITATE,
                 .setIvs = { 31, 31, 31, 31, 31, 31 },
                 .setEvs = { 4, 252, 0, 252, 0, 0 },
@@ -31584,7 +31584,7 @@ const TrainerData sTrainerData[] = {
                 .level = 80,
