From e8355ec7726f30e647c285abba12198e34d3efe0 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 22 Nov 2026 05:52:07 +0000
Subject: [PATCH] Boss teams: Lance's Gyarados and Dragonite without Dragon
 Dance

---
 data/Trainers.c          | 6 +++---
 tools/hack/boss_teams.py | 6 ++++--
 2 files changed, 7 insertions(+), 5 deletions(-)

diff --git a/data/Trainers.c b/data/Trainers.c
index 8e991f699..2ac440db8 100644
--- a/data/Trainers.c
+++ b/data/Trainers.c
@@ -10184,7 +10184,7 @@ const TrainerData sTrainerData[] = {
                 .level = 55,
                 .species = SPECIES_GYARADOS,
                 .item = ITEM_SITRUS_BERRY,
-                .moves = { MOVE_AQUA_TAIL, MOVE_EARTHQUAKE, MOVE_DRAGON_DANCE, MOVE_CRUNCH },
+                .moves = { MOVE_AQUA_TAIL, MOVE_EARTHQUAKE, MOVE_ICE_FANG, MOVE_CRUNCH },
                 .ability = ABILITY_INTIMIDATE,
                 .setIvs = { 31, 31, 31, 31, 31, 31 },
                 .setEvs = { 4, 252, 0, 252, 0, 0 },
@@ -10209,8 +10209,8 @@ const TrainerData sTrainerData[] = {
                 .abilitySlot = TRAINER_POKEMON_ABILITY_1,
                 .level = 58,
                 .species = SPECIES_DRAGONITE,
-                .item = ITEM_LEFTOVERS,
-                .moves = { MOVE_DRAGON_DANCE, MOVE_OUTRAGE, MOVE_EARTHQUAKE, MOVE_FIRE_PUNCH },
+                .item = ITEM_SITRUS_BERRY,
+                .moves = { MOVE_OUTRAGE, MOVE_EARTHQUAKE, MOVE_FIRE_PUNCH, MOVE_THUNDER_PUNCH },
                 .ability = ABILITY_INNER_FOCUS,
                 .setIvs = { 31, 31, 31, 31, 31, 31 },
                 .setEvs = { 4, 252, 0, 252, 0, 0 },
diff --git a/tools/hack/boss_teams.py b/tools/hack/boss_teams.py
index 2b09b68a9..79375123d 100644
--- a/tools/hack/boss_teams.py
+++ b/tools/hack/boss_teams.py
@@ -372,9 +372,11 @@ TEAMS = {
         ("AERODACTYL", 56, "FOCUS_SASH", ["STONE_EDGE", "AERIAL_ACE", "EARTHQUAKE", "CRUNCH"], {}),
         ("CHARIZARD", 56, "CHARCOAL", ["FLAMETHROWER", "AIR_SLASH", "DRAGON_PULSE", "ROOST"], {}),
         ("KINGDRA", 56, "HABAN_BERRY", ["RAIN_DANCE", "WATERFALL", "OUTRAGE", "ICE_BEAM"], {"ability": "SWIFT_SWIM", "nature": "ADAMANT"}),
-        ("GYARADOS", 55, "SITRUS_BERRY", None, {"ability": "INTIMIDATE"}),
+        # Gyarados and the last Dragonite without Dragon Dance (as Blue's Gyarados): over ten losses to sets built
+        # the player's way, the two took 41 of the 59 KOs. His second round keeps the full sets
+        ("GYARADOS", 55, "SITRUS_BERRY", ["AQUA_TAIL", "EARTHQUAKE", "ICE_FANG", "CRUNCH"], {"ability": "INTIMIDATE"}),
         ("DRAGONITE", 57, "YACHE_BERRY", ["THUNDERBOLT", "ICE_BEAM", "FLAMETHROWER", "ROOST"], {"spread": "bulky"}),
-        ("DRAGONITE", 58, "LEFTOVERS", ["DRAGON_DANCE", "OUTRAGE", "EARTHQUAKE", "FIRE_PUNCH"], {}),
+        ("DRAGONITE", 58, "SITRUS_BERRY", ["OUTRAGE", "EARTHQUAKE", "FIRE_PUNCH", "THUNDER_PUNCH"], {}),
     ]),
     # ---- Team Rocket
     486: ("Proton, Slowpoke Well", [], [
