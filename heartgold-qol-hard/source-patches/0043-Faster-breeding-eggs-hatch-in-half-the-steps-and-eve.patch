Subject: [PATCH 43/45] Faster breeding: eggs hatch in half the steps, and
 every Day Care check makes one

GetEggCyclesToSubtract takes 2 egg cycles at a time (4 with Flame Body or Magma
Armor), and HandleDaycareStep's egg chance no longer rolls, so any pair that can
breed has an egg at every 256-step check. An armips patch under FASTER_BREEDING,
made by tools/hack/faster_breeding.py.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JQmLEYSk2h6k1E1jWo3cHd
---
 armips/asm/user_config.s      | 20 +++++++++++
 armips/include/config.s       |  4 +++
 tools/hack/faster_breeding.py | 65 +++++++++++++++++++++++++++++++++++
 3 files changed, 89 insertions(+)
 create mode 100644 tools/hack/faster_breeding.py

diff --git a/armips/asm/user_config.s b/armips/asm/user_config.s
index b682bc359..1f70374b7 100644
--- a/armips/asm/user_config.s
+++ b/armips/asm/user_config.s
@@ -165,3 +165,23 @@ HasBecomeChampion: // BOOL HasBecomeChampion(void), the argument the callers pas
 
 .close
 
+
+.if FASTER_BREEDING
+
+.open "base/arm9.bin", 0x02000000
+
+// GetEggCyclesToSubtract (tools/hack/faster_breeding.py): 2 egg cycles at a time, 4 with Flame Body or Magma Armor
+.org 0x0206CB76 // movs r0, #2: Flame Body or Magma Armor in the party
+    mov r0, #4
+
+.org 0x0206CB84 // movs r0, #1: otherwise
+    mov r0, #2
+
+// HandleDaycareStep: compatibility > LCRandom() * 100 / 0xFFFF decides whether there is an egg; times 0 instead,
+// so every compatible pair has one at each check
+.org 0x0206CD86 // movs r1, #100
+    mov r1, #0
+
+.close
+
+.endif
diff --git a/armips/include/config.s b/armips/include/config.s
index 0840049f1..d4110ca1a 100644
--- a/armips/include/config.s
+++ b/armips/include/config.s
@@ -42,6 +42,10 @@ ALWAYS_HAVE_NATIONAL_DEX equ 0
 // leave ALWAYS_HAVE_NATIONAL_DEX at 0 when this is 1, as both rewrite the same function.
 NATIONAL_DEX_FROM_START equ 1
 
+// FASTER_BREEDING halves the steps every egg takes to hatch (a quarter with Flame Body or Magma Armor in the party),
