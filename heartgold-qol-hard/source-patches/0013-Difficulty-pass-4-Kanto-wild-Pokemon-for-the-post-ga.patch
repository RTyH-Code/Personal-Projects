+#!/usr/bin/env python3
+"""Difficulty pass, part 4: Kanto wild Pokemon for the post-game.
+
+HeartGold's Kanto has wild Pokemon from Lv. 2 up, although the player gets
+there at about Lv. 58. Every Kanto encounter level (grass, caves, surfing,
+Rock Smash and all three rods) is moved into a post-game band that keeps the
+original order of the areas:
+    Kanto:                 45 + 0.42 x level   (Route 1 is 46-48, Cerulean Cave 61-66)
+    Mt. Silver, Route 28:  58 + 0.24 x level   (62-70)
+A wild Pokemon that is then past a plain level-up evolution appears evolved
+(Pidgeot instead of a Lv. 46 Pidgey). Stone, held-item and friendship
+evolutions are left alone, and so are the four former trade evolutions and
+Annihilape, which this hack moved to a level. The strongest lines stop at
+their middle stage (Pupitar, not Tyranitar).
+
+Headbutt trees and the Safari Zone are unchanged.
+
+Run once from the hg-engine root, after wild_levels.py and encounters.py:
+    python3 tools/hack/kanto_wild.py
+"""
+import re
+
+from wild_levels import in_kanto
+
+ENCOUNTERS = "data/Encounters.c"
+EVOLUTIONS = "data/Evolutions.c"
+
+# level evolutions that are not ordinary ones in the original games
+NOT_BY_LEVEL = {"ALAKAZAM", "MACHAMP", "GOLEM", "GENGAR", "ANNIHILAPE"}
+# the strongest lines stop at their middle stage: no wild Tyranitar on Mt. Silver
+NEVER_WILD = {"TYRANITAR", "DRAGONITE", "SALAMENCE", "METAGROSS", "GARCHOMP"}
+
+
+def kanto_level(level, table):
+    if level == 0:
+        return 0
+    if "MT_SILVER" in table or table == "ROUTE_28":
+        return 58 + (level * 24 + 50) // 100
+    return 45 + (level * 42 + 50) // 100
+
+
+def load_evolutions():
+    evolutions = {}
+    text = open(EVOLUTIONS).read()
+    for m in re.finditer(r"^    \[SPECIES_(\w+)\] = \{(.*?)^    \},", text, re.S | re.M):
+        for method, param, target in re.findall(r"\{ (EVO_\w+), (\d+), SPECIES_(\w+) \}", m.group(2)):
+            if method == "EVO_LEVEL" and target not in NOT_BY_LEVEL | NEVER_WILD:
+                evolutions.setdefault(m.group(1), (int(param), target))
+    return evolutions
+
+
+def evolve(species, level, evolutions):
+    while species in evolutions and evolutions[species][0] <= level:
+        species = evolutions[species][1]
+    return species
+
+
+def main():
+    evolutions = load_evolutions()
+    text = open(ENCOUNTERS).read()
+    tables = evolved = 0
+
+    def rewrite(match):
+        nonlocal tables, evolved
+        table, body = match.group(1), match.group(0)
+        if not in_kanto(table):
+            return body
+        tables += 1
+        levels_match = re.search(r"(\.levels = \{\s*)([\d,\s]+?)(\s*\})", body)
+        levels = [kanto_level(int(x), table) for x in re.findall(r"\d+", levels_match.group(2))]
+        body = body[:levels_match.start(2)] + ", ".join(map(str, levels)) + body[levels_match.end(2):]
+
+        def land(m):
+            nonlocal evolved
+            names = re.findall(r"SPECIES_(\w+)", m.group(2))
+            if len(names) != len(levels):
+                return m.group(0)
+            new = [evolve(n, lv, evolutions) for n, lv in zip(names, levels)]
+            evolved += sum(a != b for a, b in zip(names, new))
+            indent = re.match(r"\s*", m.group(2)).group(0)
+            return m.group(1) + ",\n".join(indent + "SPECIES_" + n for n in new) + "," + m.group(3)
+        body = re.sub(r"(\.species(?:Morning|Day|Night) = \{\n)(.*?)(\n\s*\},)", land, body, flags=re.S)
+
+        def water(m):
+            nonlocal evolved
+
+            def slot(s):
+                nonlocal evolved
+                lo, hi, name = kanto_level(int(s.group(1)), table), kanto_level(int(s.group(2)), table), s.group(3)
+                new = evolve(name, lo, evolutions) if name != "NONE" else name
+                evolved += new != name
+                return "{ %d, %d, SPECIES_%s }" % (lo, hi, new)
+            return re.sub(r"\{ (\d+), (\d+), SPECIES_(\w+) \}", slot, m.group(0))
+        for field in ("surfSlots", "rockSmashSlots", "oldRodSlots", "goodRodSlots", "superRodSlots"):
+            body = re.sub(r"\.%s = \{.*?\n        \}," % field, water, body, flags=re.S)
+        return body
+
+    text = re.sub(r"^    \[ENCDATA_\w+?_([A-Z0-9_]+)\] = \{\n.*?^    \},\n", rewrite, text, flags=re.S | re.M)
+    open(ENCOUNTERS, "w").write(text)
+    print("%d Kanto tables, %d slots now hold an evolved Pokemon" % (tables, evolved))
+
+
+if __name__ == "__main__":
+    main()
