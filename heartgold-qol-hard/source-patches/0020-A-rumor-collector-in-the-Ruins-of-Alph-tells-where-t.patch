diff --git a/tools/hack/legend_hints.py b/tools/hack/legend_hints.py
new file mode 100644
index 000000000..59ac3901e
--- /dev/null
+++ b/tools/hack/legend_hints.py
@@ -0,0 +1,125 @@
+#!/usr/bin/env python3
+"""An old man in the Ruins of Alph Research Center who tells where the added legendaries are.
+
+legendaries.py puts the missing legendary Pokemon in the overworld without a
+word about it in the game. This adds a man to the Research Center who tells
+the rumours he has collected: nothing before the Champion, then each tier as
+the player reaches it (Champion, sixteen badges, Red).
+
+Run after fossil_reviver.py and legendaries.py, from the hg-engine root; it
+edits the Research Center files that fossil_reviver.py put in the tree:
+    python3 tools/hack/legend_hints.py
+"""
+import json
+import re
+import sys
+import textwrap
+
+SCRIPT = "data/scr_seq/scr_seq_0038_D24R0102.s"
+INCLUDE = "data/scr_seq/include/event_D24R0102.inc"
+EVENTS = "data/eventdata/zone_event/292_D24R0102.json"
+TEXT = "data/text/custom/073.txt"
+POSITION = (2, 10)      # the open corner left of the door; nothing has to pass through it
+WIDTH = 34              # characters that fit on a line of the message box
+
+OPENING = "I collect rumors of legendary Pokémon."
+NOT_YET = "They say such Pokémon only show themselves to a Champion. Come back when you are one."
+CHAMPION = [
+    "Behind three of these ruins' puzzle chambers wait golems of rock, ice and steel.",
+    "Their master wakes behind the fourth chamber for a Trainer who brings all three.",
+    "Three spirits hover over the water: deep in Union Cave, at the Lake of Rage and in the Dragon's Den.",
+    "Latias no longer roams Kanto alone.",
+    "Something burns on Cinnabar Island, and something shines by the pond at Mt. Moon Square.",
+    "The guardian of Ilex Forest is back at its shrine. A flower Pokémon hides in the National Park. A prince of the sea swims in the Whirl Islands.",
+]
+CHAMPION_END = "There are greater legends, but they wait for a Trainer Professor Oak has seen all sixteen Badges on."
+BADGES = [
+    "Where you caught Kyogre, its rival will stand.",
+    "And three beings of time, space and shadow have come to the hall beneath these ruins.",
+]
+BADGES_END = "The oldest legends wait for whoever defeats the Trainer on Mt. Silver."
+RED = [
+    "You beat him! Then listen. The creator itself is in the hall below us.",
+    "A playful ancestor floats at Mt. Silver's summit.",
+    "A wish-maker waits at the cape on Route 25, a visitor from space on Route 3, and a nightmare deep in Dark Cave.",
+]
+
+
+def message(sentences):
+    """Lay sentences out for the message box: two lines a page."""
+    lines = []
+    for sentence in sentences:
+        wrapped = textwrap.wrap(sentence, WIDTH)
+        if len(wrapped) % 2:
+            wrapped.append("")
+        lines += wrapped
+    pages = ["\\n".join(l for l in lines[i:i + 2] if l) for i in range(0, len(lines), 2)]
+    return "\\r".join(pages).replace("'", "\u2019")      # the game's text uses the curly apostrophe
+
+
+def main():
+    read = lambda path: open(path, encoding="utf-8", newline="").read()
+    script, include, text = read(SCRIPT), read(INCLUDE), read(TEXT)
+    if "legend_hints" in script:
+        sys.exit("the rumor collector is already there")
+    events = json.loads(read(EVENTS))
+
+    lines = text.split("\r\n")
+    if lines[-1] == "":
+        lines.pop()
+    first = len(lines)
+    lines += [message([OPENING, NOT_YET]),
+              message([OPENING] + CHAMPION + [CHAMPION_END]),
+              message([OPENING] + CHAMPION + BADGES + [BADGES_END]),
+              message([OPENING] + CHAMPION + BADGES + RED)]
+
+    number = len(re.findall(r"^scrdef scr_seq_D24R0102_\d+$", script, re.M))
+    body = """
+// the rumor collector (tools/hack/legend_hints.py)
+scr_seq_D24R0102_%03d:
+	play_se SEQ_SE_DP_SELECT
+	lockall
+	faceplayer
+	goto_if_unset FLAG_GAME_CLEAR, _legend_hints_none
+	goto_if_unset FLAG_UNLOCKED_MT_SILVER, _legend_hints_champion
+	compare VAR_UNK_4131, 0
+	goto_if_eq _legend_hints_badges
+	npc_msg %d
+	goto _legend_hints_end
+
+_legend_hints_none:
+	npc_msg %d
+	goto _legend_hints_end
+
+_legend_hints_champion:
+	npc_msg %d
+	goto _legend_hints_end
+
+_legend_hints_badges:
+	npc_msg %d
+_legend_hints_end:
+	wait_button
+	closemsg
+	releaseall
+	end
+	.balign 4
+""" % (number, first + 3, first, first + 1, first + 2)
+    script = script.replace("scrdef_end", "scrdef scr_seq_D24R0102_%03d\nscrdef_end" % number, 1).rstrip("\n") + "\n" + body
+    last = ".equ _EV_scr_seq_D24R0102_%03d, %d\n" % (number - 1, number - 1)
+    if last not in include:
+        sys.exit("unexpected include file")
+    include = include.replace(last, last + ".equ _EV_scr_seq_D24R0102_%03d, %d\n" % (number, number), 1)
+    include = include.replace("\n.endif", ".equ obj_D24R0102_rumors, %d\n\n.endif" % len(events["object_events"]), 1)
+    events["object_events"].append({
+        "id": "obj_D24R0102_rumors", "graphics_id": "SPRITE_GSOLDMAN1", "movement_type": 15, "trainer_type": 0,
+        "hidden_flag": "FLAG_NOTHING", "script": "_EV_scr_seq_D24R0102_%03d + 1" % number, "initial_dir": 1,
+        "param0": 0, "param1": 0, "param2": 0, "movement_range_x": 0, "movement_range_z": 0,
+        "x": POSITION[0], "z": POSITION[1], "y": 0})
+    for path, content in ((SCRIPT, script), (INCLUDE, include), (EVENTS, json.dumps(events, indent=2) + "\n"),
+                          (TEXT, "\r\n".join(lines) + "\r\n")):
+        open(path, "w", encoding="utf-8", newline="").write(content)
+    print("added the rumor collector: script %d, messages %d to %d" % (number, first, first + 3))
+
+
+if __name__ == "__main__":
+    main()
