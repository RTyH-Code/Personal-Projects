+#!/usr/bin/env python3
+"""PP Up and PP Max for money, so the Pokeathlon isn't needed for anything.
+
+The Pokeathlon Dome's prize exchange is the original game's only repeatable source of PP Ups. Everything else
+it trades for Athlete Points the hack already sells or the game gives elsewhere (evolution items and King's Rock
+on Goldenrod 4F, Rare Candy on Celadon 4F, Full Restores in the Poke Marts, Moomoo Milk at the farm, Apricorns
+on the trees), and Heart Scales are no longer needed now the Move Reminders are free. This adds PP Up (from
+four badges, P9,800) and PP Max (from eight, P24,800) to the Goldenrod Department Store 4F, next to the
+vitamins.
+
+    python3 tools/hack/pp_shop.py
+"""
+import re
+import sys
+
+MART = "src/field/mart.c"
+ITEMS = "data/itemdata/itemdata.c"
+STOCK = [("PP_UP", 9800, 4), ("PP_MAX", 24800, 8)]
+
+
+def main():
+    mart, items = open(MART).read(), open(ITEMS).read()
+    m = re.search(r"(u16 sGoldenrodDepartment4F\[\] = \{\n)([^}]*?)(,\s*0xFFFF\n\};)", mart)
+    if not m:
+        sys.exit("no sGoldenrodDepartment4F")
+    if "ITEM_PP_UP" in m.group(2):         # (the Pokeathlon's own prize lists, further down, have it too)
+        sys.exit("already stocked")
+    added = ", ".join("ITEM_" + n for n, _, _ in STOCK)
+    mart = mart.replace(m.group(0), "%s%s,\n    // PP Up and PP Max (tools/hack/pp_shop.py)\n    %s, 0xFFFF\n};" % (
+        m.group(1), m.group(2), added))
+    head = "const struct BadgeMartItems sBadgeLockedMartItems[] = {\n"
+    if head not in mart:
+        sys.exit("no sBadgeLockedMartItems")
+    mart = mart.replace(head, head + "    // PP Up and PP Max (tools/hack/pp_shop.py)\n"
+                        + "".join("    { ITEM_%s, %d },\n" % (n, b) for n, _, b in STOCK))
+    for name, price, _ in STOCK:
+        m = re.search(r"\n\[ITEM_%s\] =\n\{\n    ITEM_PRICE\(\d+\)" % name, items)
+        if not m:
+            sys.exit("no item data for " + name)
+        items = items[:m.start()] + re.sub(r"ITEM_PRICE\(\d+\)", "ITEM_PRICE(%d)" % price, m.group(0)) + items[m.end():]
+    open(MART, "w").write(mart)
+    open(ITEMS, "w").write(items)
+    print("stocked", ", ".join(n for n, _, _ in STOCK), "on Goldenrod 4F")
+
+
+if __name__ == "__main__":
+    main()
