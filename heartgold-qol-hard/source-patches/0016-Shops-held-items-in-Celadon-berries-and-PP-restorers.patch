index 000000000..283c7cfd4
--- /dev/null
+++ b/tools/hack/shops.py
@@ -0,0 +1,78 @@
+#!/usr/bin/env python3
+"""Shops: a held-item counter, a berry and consumables counter, and Poke Marts that stock up a badge sooner.
+
+- Celadon Department Store 4F (mail, in the original) also sells held items. Celadon is past the Champion.
+- Goldenrod Department Store 3F (X items) also sells berries and PP restorers, more of them as badges come in.
+- Every Poke Mart's ordinary counter gets its better goods one badge earlier, as the hack's trainers are stronger.
+
+The game has one price per item, used for buying and (halved) for selling, so the prices below are set on the
+items themselves.
+
+    python3 tools/hack/shops.py
+"""
+import re
+import sys
+
+MART = "src/field/mart.c"
+ITEMS = "data/itemdata/itemdata.c"
+
+HELD = {  # item: price
+    "LEFTOVERS": 25000, "CHOICE_BAND": 25000, "CHOICE_SPECS": 25000, "CHOICE_SCARF": 25000, "LIFE_ORB": 25000,
+    "FOCUS_SASH": 25000,
+    "EXPERT_BELT": 10000, "MUSCLE_BAND": 10000, "WISE_GLASSES": 10000, "SCOPE_LENS": 10000, "SHELL_BELL": 10000,
+    "LIGHT_CLAY": 10000, "BLACK_SLUDGE": 10000, "TOXIC_ORB": 10000, "FLAME_ORB": 10000, "WHITE_HERB": 10000,
+    "POWER_HERB": 10000,
+}
+RESIST = """OCCA PASSHO WACAN RINDO YACHE CHOPLE KEBIA SHUCA COBA PAYAPA TANGA CHARTI KASIB HABAN COLBUR BABIRI
+CHILAN ROSELI""".split()
+STAND = (  # item, price, badges needed
+    [("ORAN_BERRY", 200, 0)] + [(b + "_BERRY", 200, 0) for b in ("CHERI", "CHESTO", "PECHA", "RAWST", "ASPEAR")]
+    + [("SITRUS_BERRY", 500, 4), ("LUM_BERRY", 1000, 4), ("ETHER", 1500, 4)]
+    + [(b + "_BERRY", 1000, 6) for b in RESIST] + [("ELIXIR", 3000, 6)]
+    + [("MAX_ETHER", 3000, 8), ("MAX_ELIXIR", 6000, 8), ("MAX_REVIVE", 8000, 8)])
+EARLIER = {"GREAT_BALL": 2, "REVIVE": 2, "SUPER_REPEL": 2, "HYPER_POTION": 4, "ULTRA_BALL": 4, "FULL_HEAL": 4,
+           "MAX_REPEL": 4, "MAX_POTION": 6}
+
+
+def main():
+    mart = open(MART).read()
+    items = open(ITEMS).read()
+    if "ITEM_LEFTOVERS" in re.search(r"sCeladonDepartment4F\[\] = \{(.*?)\};", mart, re.S).group(1):
+        sys.exit("the shops are already changed")
+
+    def extend(text, array, names, note):
+        m = re.search(r"(u16 %s\[\] = \{\n)(.*?)(, 0xFFFF\n\};)" % array, text, re.S)
+        if not m:
+            sys.exit("no " + array)
+        added = ",\n    ".join(", ".join("ITEM_" + n for n in names[i:i + 6]) for i in range(0, len(names), 6))
