+#!/usr/bin/env python3
+"""Routes 47 and 48 and Cliff Cave in line with the land around Cianwood.
+
+side_wild.py and surf_wild.py left these out as post-game areas, but they are
+not: Cliff Edge Gate opens off Cianwood, which a player reaches by surfing
+before Chuck, and Route 47's trainers are Lv. 22-29. So, by the same rule as
+those two, they follow Chuck (34) and move into his band, 75-85% of his
+average:
+    Route 48 and Cliff Cave, walking   (were Lv. 23-29 and 21-26)
+    Route 47, surfing                  (was 10-29)
+Route 47's walking levels (36-46) and the Cliff Edge Gate's water (23-46)
+are already above the band and stay, as other areas above their neighbours
+do. The Safari Zone has its own tables and is unchanged.
+
+Run once from the hg-engine root, after surf_wild.py:
+    python3 tools/hack/cianwood_wild.py
+"""
+import side_wild
+import surf_wild
+
+
+def main():
+    side_wild.GROUPS = [(34, ["R48_ROUTE_48", "D50R0101_CLIFF_CAVE"])]
+    side_wild.main()
+    surf_wild.GROUPS = [(34, ["R47_ROUTE_47"])]
+    surf_wild.main()
+
+
+if __name__ == "__main__":
+    main()
