+++ b/tools/hack/party_exp_share.py
@@ -0,0 +1,174 @@
+#!/usr/bin/env python3
+"""A party-wide Exp. Share, as a challenge rule the player turns on (off in a new game).
+
+The rules woman in the player's house (challenge_rules.py) gets a third choice, "Share experience", kept in its
+own script variable, PARTY_EXP_SHARE_VARIABLE (0x416E, which the game never uses). With it on, as in the
+games since X and Y, every Pokemon in the party that didn't battle gets half the experience it would have had
+for beating the foe alone; those that battled get theirs as before. A held Exp. Share still works as it does.
+
+How: before experience is handed out for a fainted foe (in Task_DistributeExp_Extend, and where the capture
+experience picks who gets it), every Pokemon still standing is marked as having
+fought it (obtained_exp_right_flag), with bit 31 set to say so and sPartyExpShareFought keeping who really
+did. The count that splits the experience among those who fought uses the real list, and a Pokemon that only
+got the mark gets half of the whole.
+
+Run after challenge_rules.py:
+    python3 tools/hack/party_exp_share.py
+"""
+import sys
+
+CONFIG = "include/config.h"
+BATTLE = "src/battle/battle_script_commands.c"
+SCRIPT = "data/scr_seq/scr_seq_0845_T20R0201.s"
+TEXT = "data/text/custom/545.txt"
+
+MESSAGES = [
+    r"Share experience",
+    r"Experience is shared now.\rPokémon that didn’t battle get half\nof what they would have earned.",
+    r"Experience isn’t shared any more.",
+]
+
+MARK = '''
+#ifdef PARTY_EXP_SHARE_VARIABLE
+// party-wide exp share (tools/hack/party_exp_share.py): who really fought the foe whose experience is being handed
+// out, once every Pokemon still standing has been marked as having fought it (bit 31 of the flags says so)
+u32 ALIGN4 sPartyExpShareFought = 0;
+#define PARTY_EXP_SHARE_MARKED 0x80000000
+#define FOUGHT_FLAGS(sp, side) (((sp)->obtained_exp_right_flag[side] & PARTY_EXP_SHARE_MARKED) ? sPartyExpShareFought : (sp)->obtained_exp_right_flag[side])
+
+/**
+ *  @brief with the rule on, mark every Pokemon in the party still standing as having fought the fainted foe, once
+ *         per foe (the game resets the flags when the next one comes in)
+ */
+static void PartyExpShare_MarkAll(struct EXP_CALCULATOR *expcalc)
+{
+    u32 *flags = &expcalc->sp->obtained_exp_right_flag[(expcalc->sp->fainting_client >> 1) & 1];
+
+    if (!GetScriptVar(PARTY_EXP_SHARE_VARIABLE) || (*flags & PARTY_EXP_SHARE_MARKED)) {
+        return;
+    }
+    sPartyExpShareFought = *flags;
+    for (int i = 0; i < BattleWorkPokeCountGet(expcalc->bw, 0); i++) {
+        struct PartyPokemon *mon = BattleWorkPokemonParamGet(expcalc->bw, 0, i);
+        if (mon != NULL && GetMonData(mon, MON_DATA_SPECIES, NULL) && !GetMonData(mon, MON_DATA_IS_EGG, NULL)
+            && GetMonData(mon, MON_DATA_HP, NULL)) {
+            *flags |= No2Bit(i);
+        }
+    }
+    *flags |= PARTY_EXP_SHARE_MARKED;
+}
+#else
+#define FOUGHT_FLAGS(sp, side) ((sp)->obtained_exp_right_flag[side])
+#endif
+
+/**
+ *  @brief task to distribute experience'''
+
+# the capture-experience path picks who gets experience itself, before the task runs
+MARK_ALL = '''        int sel_mons_no, item, eqp;
+        struct PartyPokemon *pp;
+
+#ifdef PARTY_EXP_SHARE_VARIABLE
+        PartyExpShare_MarkAll(expcalc);
+#endif
+'''
+
+# and the task picks each Pokemon in turn by the same flags
+MARK_TASK = '''    client_no = (sp->fainting_client >> 1) & 1;
+
+#ifdef PARTY_EXP_SHARE_VARIABLE
+    PartyExpShare_MarkAll(expcalc);
+#endif
+'''
+
+HALF = '''            } else {
+                sp->obtained_exp = totalexp / monCount;
+                if (sp->obtained_exp == 0) {
+                    sp->obtained_exp = 1;
+                }
+                sp->exp_share_obtained_exp = 0;
+            }
+#ifdef PARTY_EXP_SHARE_VARIABLE
+            // a Pokemon that only shares (it didn't battle) gets half of what beating the foe alone would give
+            if ((sp->obtained_exp_right_flag[client_no] & PARTY_EXP_SHARE_MARKED) && !(sPartyExpShareFought & No2Bit(sel_mons_no))) {
+                sp->obtained_exp = totalexp / 2;
+                if (sp->obtained_exp == 0) {
+                    sp->obtained_exp = 1;
+                }
+            }
+#endif
+        }
+    }
+
+#ifdef DEBUG_PRINT_EXPERIENCE_VALUES
+    u8 buf[128];
+    sprintf(buf, "[Task_DistributeExp_Extend] Scaled Rate'''
+
+
+def edit(path, old, new, count=1):
+    text = open(path, encoding="utf-8", newline="").read()
+    if text.count(old) != count:
+        sys.exit("expected %d of this in %s: %r" % (count, path, old[:70]))
+    open(path, "w", encoding="utf-8", newline="").write(text.replace(old, new))
+
+
+def main():
+    edit(CONFIG, "#define CHALLENGE_RULE_NO_ITEMS 2",
+         "#define CHALLENGE_RULE_NO_ITEMS 2\n"
+         "// the party-wide exp share, the third challenge rule, in a variable of its own (tools/hack/party_exp_share.py)\n"
+         "#define PARTY_EXP_SHARE_VARIABLE 0x416E")
+
+    edit(BATTLE, "\n/**\n *  @brief task to distribute experience", MARK)
+    edit(BATTLE, "        int sel_mons_no, item, eqp;\n        struct PartyPokemon *pp;\n", MARK_ALL)
+    edit(BATTLE, "    client_no = (sp->fainting_client >> 1) & 1;\n", MARK_TASK)
+    # the counts of who fought: the real list, not the marks (both experience formulas count the same way)
+    edit(BATTLE, "if (sp->obtained_exp_right_flag[client_no /*(sp->fainting_client >> 1) & 1*/] & No2Bit(i)) {",
+         "if (FOUGHT_FLAGS(sp, client_no) & No2Bit(i)) {", count=2)
+    edit(BATTLE, '''            } else {
+                sp->obtained_exp = totalexp / monCount;
+                if (sp->obtained_exp == 0) {
+                    sp->obtained_exp = 1;
+                }
+                sp->exp_share_obtained_exp = 0;
+            }
+        }
+    }
+
+#ifdef DEBUG_PRINT_EXPERIENCE_VALUES
+    u8 buf[128];
+    sprintf(buf, "[Task_DistributeExp_Extend] Scaled Rate''', HALF)
+
+    raw = open(TEXT, encoding="utf-8", newline="").read()
+    lines = raw.split("\r\n")
+    if lines[-1] == "":
+        lines.pop()
+    first = len(lines)
+    lines += MESSAGES
+    open(TEXT, "w", encoding="utf-8", newline="").write("\r\n".join(lines) + "\r\n")
+
+    edit(SCRIPT, "\tmenu_item_add 42, 255, 2\n",
+         "\tmenu_item_add %d, 255, 3\n\tmenu_item_add 42, 255, 2\n" % first)
+    edit(SCRIPT, "\tcompare VAR_SPECIAL_RESULT, 1\n\tgoto_if_eq _rules_items\n",
+         "\tcompare VAR_SPECIAL_RESULT, 1\n\tgoto_if_eq _rules_items\n"
+         "\tcompare VAR_SPECIAL_RESULT, 3\n\tgoto_if_eq _rules_share\n")
+    script = open(SCRIPT, encoding="utf-8", newline="").read()
+    script = script.rstrip("\n") + "\n" + '''
+// the party-wide exp share (tools/hack/party_exp_share.py), in VAR_UNK_416E
+_rules_share:
+	compare VAR_UNK_416E, 0
+	goto_if_ne _rules_share_off
+	setvar VAR_UNK_416E, 1
+	npc_msg %d
+	goto _rules_menu
+
+_rules_share_off:
+	setvar VAR_UNK_416E, 0
+	npc_msg %d
+	goto _rules_menu
+''' % (first + 1, first + 2)
+    open(SCRIPT, "w", encoding="utf-8", newline="").write(script)
+    print("edited", CONFIG, BATTLE, SCRIPT, TEXT, "; messages from", first)
+
+
+if __name__ == "__main__":
+    main()
