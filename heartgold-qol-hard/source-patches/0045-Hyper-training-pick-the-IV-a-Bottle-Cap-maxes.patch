index 128d10aa6..e201e1fa5 100644
--- a/src/field/script_commands.c
+++ b/src/field/script_commands.c
@@ -413,3 +413,31 @@ void SetupAndStartTotemBattle(TaskManager *taskManager, u16 species, u8 level, u
 
     CallTask_StartEncounter(taskManager, setup, BattleSetup_GetWildTransitionEffect(setup), BattleSetup_GetWildBattleMusic(setup), winFlag);
 }
+
