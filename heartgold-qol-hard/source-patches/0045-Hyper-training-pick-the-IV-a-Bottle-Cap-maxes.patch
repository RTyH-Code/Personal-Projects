+/**
+ *  @brief hyper_train SLOT, STAT, RESULT (tools/hack/hyper_training.py), in place of the unused script command 384:
+ *         make the IV STAT (0-5, in the order HP, Attack, Defense, Speed, Sp. Atk, Sp. Def; 6 for all six) of the
+ *         party Pokemon in SLOT 31.  RESULT is 1 if any IV went up, 0 if they were all at 31 already
+ */
+BOOL ScrCmd_HyperTrain(SCRIPTCONTEXT *ctx)
+{
+    u16 slot = ScriptGetVar(ctx);
+    u16 stat = ScriptGetVar(ctx);
+    u16 *result = ScriptGetVarPointer(ctx);
+    struct Party *party = SaveData_GetPlayerPartyPtr(ctx->fsys->savedata);
+    struct PartyPokemon *mon = Party_GetMonByIndex(party, slot);
+    u32 i, max = 31;
+
+    *result = 0;
+    for (i = 0; i < 6; i++) {
+        if ((stat == 6 || stat == i) && GetMonData(mon, MON_DATA_HP_IV + i, NULL) < 31) {
+            SetMonData(mon, MON_DATA_HP_IV + i, &max);
+            *result = 1;
+        }
+    }
+    if (*result) {
+        RecalcPartyPokemonStats(mon);
+    }
+    return FALSE;
+}
