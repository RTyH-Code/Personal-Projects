@@ -0,0 +1,277 @@
+#!/usr/bin/env python3
+"""Hyper training: a trainer in the Goldenrod Department Store 5F maxes the IV the player picks, for a Bottle Cap.
+
+training_items.py sells the Bottle Caps on 5F, and had them used from the bag on the lowest IV. Here a man by
+the counter does it instead, as in the games since Sun and Moon: choose a Pokemon, then HP, Attack, Defense,
+Sp. Atk, Sp. Def or Speed for a Bottle Cap, or every stat for a Gold Bottle Cap. A stat at 31 already, or a
+Pokemon with all six at 31 for a Gold Bottle Cap, costs nothing. There is no level requirement. The Bottle Caps
+can no longer be used from the bag.
+
+The new script command, hyper_train SLOT, STAT, RESULT (STAT 0-5 in the game's order HP, Attack, Defense,
+Speed, Sp. Atk, Sp. Def, or 6 for all; RESULT 1 if any IV went up), takes the place of command 384,
+mon_subtract_friendship, which no script in the game uses: its handler at 0x0204D7D8 is hooked to
+ScrCmd_HyperTrain.
+
+It needs the vanilla dump of 5F (make dump_scripts, as for fossil_reviver.py); run after training_items.py:
+    python3 tools/hack/hyper_training.py /path/to/dumped/hg-engine
+"""
+import json
+import os
+import re
+import sys
+
+FLOOR_SCRIPT = "data/scr_seq/scr_seq_0903_T25R1005.s"
+FLOOR_INCLUDE = "data/scr_seq/include/event_T25R1005.inc"
+FLOOR_EVENTS = "data/eventdata/zone_event/188_T25R1005.json"
+FLOOR_TEXT = "data/text/custom/596.txt"
+NEW_SCRIPT = 7               # 5F has scripts 0-6
+NEW_OBJECT = 5               # and objects 0-4
+POSITION = (21, 4)           # by the right-hand wall, north of the counter; faces down, to be talked to from (21, 5)
+
+HOOKS = "hooks"
+COMMANDS = "src/field/script_commands.c"
+ITEMS = "data/itemdata/itemdata.c"
+HANDLER = "src/individual/PartyMenu_HandleUseItemOnMon.c"
+
+MESSAGES = [
+    r"I’m a hyper trainer! Bring me a\nBottle Cap and I’ll max out one\fof a Pokémon’s IVs.\rA Gold Bottle Cap maxes out all six!\r",
+    r"You don’t have a Bottle Cap.\nCome back when you get one!",
+    r"Which Pokémon should I train?\r",
+    r"Which stat should I bring out?",
+    r"HP",
+    r"Attack",
+    r"Defense",
+    r"Sp. Atk",
+    r"Sp. Def",
+    r"Speed",
+    r"Every stat",
+    r"Never mind",
+    r"Every stat takes a Gold Bottle Cap.\nCome back when you have one!",
+    r"One stat takes a Bottle Cap.\nCome back when you have one!",
+    r"That’s already as good as it gets!\nNo charge.",
+    r"There! Its potential has been\nbrought out!",
+    r"An Egg can’t be trained.\nIt hasn’t even hatched!",
+    r"Come back any time you have a\nBottle Cap.",
+]
+
+SCRIPT = """
+// hyper training (tools/hack/hyper_training.py): a Bottle Cap for the IV picked, a Gold Bottle Cap for all six
+.macro hyper_train,slot,stat,result
+.hword 384
+.hword \\slot
+.hword \\stat
+.hword \\result
+.endm
+
+scr_seq_T25R1005_{n:03d}:
+	play_se SEQ_SE_DP_SELECT
+	lockall
+	faceplayer
+	npc_msg {m0}
+	hasitem ITEM_BOTTLE_CAP, 1, VAR_SPECIAL_x8006
+	hasitem ITEM_GOLD_BOTTLE_CAP, 1, VAR_SPECIAL_x8007
+	compare VAR_SPECIAL_x8006, 0
+	goto_if_ne _ht_choose
+	compare VAR_SPECIAL_x8007, 0
+	goto_if_ne _ht_choose
+	npc_msg {m1}
+	goto _ht_end
+
+_ht_choose:
+	npc_msg {m2}
+	closemsg
+	fade_screen 6, 1, 0, RGB_BLACK
+	wait_fade
+	party_select_ui
+	get_party_selection VAR_SPECIAL_x8005
+	restore_overworld
+	fade_screen 6, 1, 1, RGB_BLACK
+	wait_fade
+	compare VAR_SPECIAL_x8005, 255
+	goto_if_eq _ht_bye
+	get_partymon_species VAR_SPECIAL_x8005, VAR_SPECIAL_RESULT
+	compare VAR_SPECIAL_RESULT, 0
+	goto_if_eq _ht_egg
+	npc_msg {m3}
+	touchscreen_menu_hide
+	menu_init 1, 1, 0, 1, VAR_SPECIAL_x8004
+	menu_item_add {m4}, 255, 0
+	menu_item_add {m5}, 255, 1
+	menu_item_add {m6}, 255, 2
+	menu_item_add {m7}, 255, 4
+	menu_item_add {m8}, 255, 5
+	menu_item_add {m9}, 255, 3
+	menu_item_add {m10}, 255, 6
+	menu_item_add {m11}, 255, 7
+	menu_exec
+	touchscreen_menu_show
+	compare VAR_SPECIAL_x8004, 6
+	goto_if_eq _ht_gold
+	compare VAR_SPECIAL_x8004, 6
+	goto_if_gt _ht_bye
+	compare VAR_SPECIAL_x8006, 0
+	goto_if_eq _ht_need_cap
+	hyper_train VAR_SPECIAL_x8005, VAR_SPECIAL_x8004, VAR_SPECIAL_x8003
+	compare VAR_SPECIAL_x8003, 0
+	goto_if_eq _ht_maxed
+	takeitem ITEM_BOTTLE_CAP, 1, VAR_SPECIAL_RESULT
+	goto _ht_done
+
+_ht_gold:
+	compare VAR_SPECIAL_x8007, 0
+	goto_if_eq _ht_need_gold
+	hyper_train VAR_SPECIAL_x8005, VAR_SPECIAL_x8004, VAR_SPECIAL_x8003
+	compare VAR_SPECIAL_x8003, 0
+	goto_if_eq _ht_maxed
+	takeitem ITEM_GOLD_BOTTLE_CAP, 1, VAR_SPECIAL_RESULT
+	goto _ht_done
+
+_ht_done:
+	play_fanfare SEQ_ME_ITEM
+	npc_msg {m15}
+	wait_fanfare
+	goto _ht_end
+
+_ht_maxed:
+	npc_msg {m14}
+	goto _ht_end
+
+_ht_need_gold:
+	npc_msg {m12}
+	goto _ht_end
+
+_ht_need_cap:
+	npc_msg {m13}
+	goto _ht_end
+
+_ht_egg:
+	npc_msg {m16}
+	goto _ht_end
+
+_ht_bye:
+	npc_msg {m17}
+_ht_end:
+	wait_button_or_walk_away
+	closemsg
+	releaseall
+	end
+"""
+
+COMMAND = '''
+
+/**
+ *  @brief hyper_train SLOT, STAT, RESULT (tools/hack/hyper_training.py), in place of the unused script command 384:
+ *         make the IV STAT (0-5, in the order HP, Attack, Defense, Speed, Sp. Atk, Sp. Def; 6 for all six) of the
+ *         party Pokemon in SLOT 31.  RESULT is 1 if any IV went up, 0 if they were all at 31 already
+ */
+BOOL ScrCmd_HyperTrain(SCRIPTCONTEXT *ctx)
+{
+    u16 slot = ScriptGetVar(ctx);
+    u16 stat = ScriptGetVar(ctx);
+    u16 *result = ScriptGetVarPointer(ctx);
+    struct Party *party = SaveData_GetPlayerPartyPtr(ctx->fsys->savedata);
+    struct PartyPokemon *mon = Party_GetMonByIndex(party, slot);
+    u32 i, max = 31;
+
+    *result = 0;
+    for (i = 0; i < 6; i++) {
+        if ((stat == 6 || stat == i) && GetMonData(mon, MON_DATA_HP_IV + i, NULL) < 31) {
+            SetMonData(mon, MON_DATA_HP_IV + i, &max);
+            *result = 1;
+        }
+    }
+    if (*result) {
+        RecalcPartyPokemonStats(mon);
+    }
+    return FALSE;
+}
+'''
+
+
+def read_lines(text):
+    lines = text.split("\r\n")
+    if lines[-1] == "":
+        lines.pop()
+    return lines
+
+
+def edit(path, old, new):
+    text = open(path, encoding="utf-8", newline="").read()
+    if text.count(old) != 1:
+        sys.exit("expected one of this in %s: %r" % (path, old[:70]))
+    open(path, "w", encoding="utf-8", newline="").write(text.replace(old, new))
+
+
+def main():
+    dump = sys.argv[1]
+    read = lambda path: open(os.path.join(dump, path), encoding="utf-8", newline="").read()
+    out = {}
+
+    text = read_lines(read(FLOOR_TEXT))
+    first = len(text)
+    text += MESSAGES
+    out[FLOOR_TEXT] = "\r\n".join(text) + "\r\n"
+    numbers = {"m%d" % k: first + k for k in range(len(MESSAGES))}
+
+    script = read(FLOOR_SCRIPT)
+    if script.count("scrdef_end") != 1:
+        sys.exit("unexpected 5F script")
+    script = script.replace("scrdef_end", "scrdef scr_seq_T25R1005_%03d\nscrdef_end" % NEW_SCRIPT)
+    out[FLOOR_SCRIPT] = script.rstrip("\n") + "\n" + SCRIPT.format(n=NEW_SCRIPT, **numbers)
+
+    include = read(FLOOR_INCLUDE)
+    include = include.replace("\n\n.equ obj_T25R1005_shopm1_2,",
+                              "\n.equ _EV_scr_seq_T25R1005_%03d, %d\n\n.equ obj_T25R1005_shopm1_2," % (NEW_SCRIPT, NEW_SCRIPT), 1)
+    include = include.replace("\n\n.endif", "\n.equ obj_T25R1005_hyper_trainer, %d\n\n.endif" % NEW_OBJECT, 1)
+    if "hyper_trainer" not in include or "_EV_scr_seq_T25R1005_%03d" % NEW_SCRIPT not in include:
+        sys.exit("unexpected 5F include")
+    out[FLOOR_INCLUDE] = include
+
+    events = json.loads(read(FLOOR_EVENTS))
+    if len(events["object_events"]) != NEW_OBJECT:
+        sys.exit("unexpected number of objects on 5F")
+    events["object_events"].append({
+        "id": "obj_T25R1005_hyper_trainer",
+        "graphics_id": "SPRITE_GSMAN2",
+        "movement_type": 15,
+        "trainer_type": 0,
+        "hidden_flag": "FLAG_NOTHING",
+        "script": "_EV_scr_seq_T25R1005_%03d + 1" % NEW_SCRIPT,
+        "initial_dir": 1,      # facing down
+        "param0": 0, "param1": 0, "param2": 0,
+        "movement_range_x": 0, "movement_range_z": 0,
+        "x": POSITION[0], "z": POSITION[1], "y": 0,
+    })
+    out[FLOOR_EVENTS] = json.dumps(events, indent=2) + "\n"
+
+    for path, content in out.items():
+        os.makedirs(os.path.dirname(path), exist_ok=True)
+        open(path, "w", encoding="utf-8", newline="").write(content)
+        print("wrote", path)
+
+    # the script command
+    commands = open(COMMANDS, encoding="utf-8").read()
+    open(COMMANDS, "w", encoding="utf-8").write(commands.rstrip("\n") + "\n" + COMMAND)
+    edit(HOOKS, "arm9 ScrCmd_MartBuy 02048060 1\n",
+         "arm9 ScrCmd_MartBuy 02048060 1\narm9 ScrCmd_HyperTrain 0204D7D8 1\n")
+
+    # the Bottle Caps no longer work from the bag
+    items = open(ITEMS, encoding="utf-8").read()
+    for cap in ("BOTTLE_CAP", "GOLD_BOTTLE_CAP"):
+        m = re.search(r"\n\[ITEM_%s\] =\n\{\n(.*?)\n\},?\n" % cap, items, re.S)
+        block = m.group(1)
+        if ".fieldUseFunc = 33," not in block:
+            sys.exit("the %s isn't usable from the bag: run training_items.py first" % cap)
+        items = items[:m.start(1)] + block.replace(".fieldUseFunc = 33,", ".fieldUseFunc = 0,") + items[m.end(1):]
+    open(ITEMS, "w", encoding="utf-8").write(items)
+    handler = open(HANDLER, encoding="utf-8").read()
+    start = handler.find("    // handle bottle caps (tools/hack/training_items.py)")
+    end = handler.find("    return FALSE;\n}", start)
+    if start < 0 or end < 0:
+        sys.exit("no Bottle Cap handling in " + HANDLER)
+    open(HANDLER, "w", encoding="utf-8").write(handler[:start] + handler[end:])
+    print("edited", COMMANDS, HOOKS, ITEMS, HANDLER)
+
+
+if __name__ == "__main__":
+    main()
