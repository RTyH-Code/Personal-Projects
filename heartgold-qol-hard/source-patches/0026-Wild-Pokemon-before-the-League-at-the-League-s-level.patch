+++ b/tools/hack/league_wild.py
@@ -0,0 +1,90 @@
+#!/usr/bin/env python3
+"""Wild Pokemon before the League at the League's levels.
+
+The trainers on the way to the Elite Four bring a team to about Lv. 50, but
+the wild Pokemon on Routes 26 and 27, at Tohjo Falls and in Victory Road
+were Lv. 23 to 41, which under the scaled experience formula give a team
+that high very little. A player short of the League's levels could barely
+grind there (playtest/BALANCE.md). Their grass, cave, surfing and Rock Smash
+levels move into Lv. 45-50, keeping the order of the slots and the areas:
+    new level = 45 + 5 x (level - lowest) / (highest - lowest)
+over every slot of these tables. Fishing is unchanged, as it is in the rest
+of Johto. A wild Pokemon past a plain level-up evolution appears evolved, by
+the same rules as kanto_wild.py.
+
+Run once from the hg-engine root, after kanto_wild.py:
+    python3 tools/hack/league_wild.py
+"""
+import re
+
+from kanto_wild import evolve, load_evolutions
+
+ENCOUNTERS = "data/Encounters.c"
+TABLES = ["R26_ROUTE_26", "R27_ROUTE_27", "D45R0101_TOHJO_FALLS",
+          "D43R0101_VICTORY_ROAD_1F", "D43R0102_VICTORY_ROAD_2F", "D43R0103_VICTORY_ROAD_3F"]
+FIELDS = ("surfSlots", "rockSmashSlots")
+LOW, HIGH = 45, 50
+SLOT = r"\{ (\d+), (\d+), SPECIES_(\w+) \}"
+
+
+def blocks(text):
+    for name in TABLES:
+        m = re.search(r"^    \[ENCDATA_%s\] = \{\n.*?^    \},\n" % name, text, re.S | re.M)
+        assert m, name
+        yield m
+
+
+def field(body, name):
+    return re.search(r"\.%s = \{.*?\n        \}," % name, body, re.S)
+
+
+def old_levels(body):
+    levels = [int(x) for x in re.findall(r"\d+", re.search(r"\.levels = \{\s*([\d,\s]+?)\s*\}", body).group(1))]
+    for f in FIELDS:
+        levels += [int(x) for s in re.findall(SLOT, field(body, f).group(0)) for x in s[:2]]
+    return [x for x in levels if x]
+
+
+def main():
+    evolutions = load_evolutions()
+    text = open(ENCOUNTERS).read()
+    every = [x for m in blocks(text) for x in old_levels(m.group(0))]
+    lo, hi = min(every), max(every)
+
+    def scale(level):
+        return 0 if level == 0 else LOW + ((level - lo) * (HIGH - LOW) * 2 + (hi - lo)) // ((hi - lo) * 2)
+
+    evolved = 0
+    for m in sorted(blocks(text), key=lambda m: -m.start()):     # from the end, so earlier offsets hold
+        body = m.group(0)
+        lv = re.search(r"(\.levels = \{\s*)([\d,\s]+?)(\s*\})", body)
+        levels = [scale(int(x)) for x in re.findall(r"\d+", lv.group(2))]
+        body = body[:lv.start(2)] + ", ".join(map(str, levels)) + body[lv.end(2):]
+
+        def land(s):
+            nonlocal evolved
+            names = re.findall(r"SPECIES_(\w+)", s.group(2))
+            if len(names) != len(levels):
+                return s.group(0)
+            new = [evolve(n, level, evolutions) for n, level in zip(names, levels)]
+            evolved += sum(a != b for a, b in zip(names, new))
+            indent = re.match(r"\s*", s.group(2)).group(0)
+            return s.group(1) + ",\n".join(indent + "SPECIES_" + n for n in new) + "," + s.group(3)
+        body = re.sub(r"(\.species(?:Morning|Day|Night) = \{\n)(.*?)(\n\s*\},)", land, body, flags=re.S)
+
+        def slot(s):
+            nonlocal evolved
+            a, b, name = scale(int(s.group(1))), scale(int(s.group(2))), s.group(3)
+            new = evolve(name, a, evolutions) if name != "NONE" else name
+            evolved += new != name
+            return "{ %d, %d, SPECIES_%s }" % (a, b, new)
+        for f in FIELDS:
+            span = field(body, f)
+            body = body[:span.start()] + re.sub(SLOT, slot, span.group(0)) + body[span.end():]
+        text = text[:m.start()] + body + text[m.end():]
+    open(ENCOUNTERS, "w").write(text)
+    print("Lv. %d-%d now %d-%d in %d tables; %d slots now hold an evolved Pokemon" % (lo, hi, LOW, HIGH, len(TABLES), evolved))
+
+
+if __name__ == "__main__":
+    main()
