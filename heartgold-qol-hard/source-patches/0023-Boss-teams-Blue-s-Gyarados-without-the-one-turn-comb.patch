From 242e7e6368aa3fab071a5041f9a1e3af3c2bd00c Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 21 Nov 2026 20:40:09 +0000
Subject: [PATCH] Boss teams: Blue's Gyarados without the one-turn combo

---
 data/Trainers.c          | 4 ++--
 tools/hack/boss_teams.py | 4 ++++
 2 files changed, 6 insertions(+), 2 deletions(-)

diff --git a/data/Trainers.c b/data/Trainers.c
index 91a0a9c11..8e991f699 100644
--- a/data/Trainers.c
+++ b/data/Trainers.c
@@ -11605,8 +11605,8 @@ const TrainerData sTrainerData[] = {
                 .abilitySlot = TRAINER_POKEMON_ABILITY_1,
                 .level = 74,
                 .species = SPECIES_GYARADOS,
-                .item = ITEM_MYSTIC_WATER,
-                .moves = { MOVE_AQUA_TAIL, MOVE_EARTHQUAKE, MOVE_DRAGON_DANCE, MOVE_CRUNCH },
+                .item = ITEM_SITRUS_BERRY,
+                .moves = { MOVE_AQUA_TAIL, MOVE_EARTHQUAKE, MOVE_ICE_FANG, MOVE_CRUNCH },
                 .ability = ABILITY_INTIMIDATE,
                 .setIvs = { 31, 31, 31, 31, 31, 31 },
                 .setEvs = { 4, 252, 0, 252, 0, 0 },
diff --git a/tools/hack/boss_teams.py b/tools/hack/boss_teams.py
index 2cf5bf363..2b09b68a9 100644
--- a/tools/hack/boss_teams.py
+++ b/tools/hack/boss_teams.py
@@ -470,7 +470,11 @@ POSTGAME = {
     254: quick("Misty", 68, ["QUAGSIRE", "POLITOED", "LANTURN", "GOLDUCK", "LAPRAS", "STARMIE"]),
     253: quick("Brock", 70, ["SUDOWOODO", "GOLEM", "OMASTAR", "ONIX", "RHYDON", "KABUTOPS"]),
     259: quick("Blaine", 72, ["MAGCARGO", "FLAREON", "NINETALES", "HOUNDOOM", "MAGMAR", "RAPIDASH"]),
+    # Blue is the eighth Kanto badge, so his Gyarados keeps its threats without the one-turn combo (as Lance's):
+    # a Sitrus Berry for the Mystic Water, Ice Fang for Dragon Dance. His rematch keeps the full set
     261: quick("Blue", 76, ["EXEGGUTOR", "ARCANINE", "RHYDON", "GYARADOS", "MACHAMP", "PIDGEOT"],
+               items={"GYARADOS": "SITRUS_BERRY"},
+               moves={"GYARADOS": ["AQUA_TAIL", "EARTHQUAKE", "ICE_FANG", "CRUNCH"]},
                options={"GYARADOS": {"ability": "INTIMIDATE"}, "MACHAMP": {"ability": "NO_GUARD"}}),
     260: quick("Red", 95, ["LAPRAS", "SNORLAX", "VENUSAUR", "CHARIZARD", "BLASTOISE", "PIKACHU"],
                items={"PIKACHU": "LIGHT_BALL", "LAPRAS": "SITRUS_BERRY", "SNORLAX": "LEFTOVERS"},
-- 
2.43.0

