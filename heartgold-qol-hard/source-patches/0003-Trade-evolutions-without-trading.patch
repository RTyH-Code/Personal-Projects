new file mode 100644
index 000000000..9e0dcb9cd
--- /dev/null
+++ b/tools/hack/trade_evos.py
@@ -0,0 +1,74 @@
+#!/usr/bin/env python3
+"""Trade evolutions without trading.
+
+Kadabra, Machoke, Graveler and Haunter evolve at level 37. Pokemon that
+evolve when traded holding an item evolve when that item is used on them
+instead, the way an evolution stone works; the items keep their held
+effects. Only the species in the hack's roster are changed.
+
+Run once from the hg-engine root against unmodified data:
+    python3 tools/hack/trade_evos.py
+"""
+import re
+
+EVOLUTIONS = "data/Evolutions.c"
+ITEMS = "data/itemdata/itemdata.c"
+
+TRADE_LEVEL = 37
+LEVEL_SPECIES = ["KADABRA", "MACHOKE", "GRAVELER", "HAUNTER"]
+ITEM_SPECIES = [
+    "POLIWHIRL", "SLOWPOKE", "ONIX", "RHYDON", "SEADRA", "SCYTHER",
+    "ELECTABUZZ", "MAGMAR", "PORYGON", "PORYGON2", "FEEBAS", "DUSCLOPS",
+    "CLAMPERL",
+]
+FIELD_USE_EVOLUTION = 20  # the evolution stones' fieldUseFunc
+
+
+def species_block(text, species):
+    m = re.search(r"^    \[SPECIES_%s\] = \{.*?^    \},$" % species, text, re.S | re.M)
+    if not m:
+        raise SystemExit("no evolution entry for " + species)
+    return m
+
+
+def main():
+    text = open(EVOLUTIONS).read()
+    items = set()
+    for species in LEVEL_SPECIES:
+        m = species_block(text, species)
+        block, n = re.subn(r"\{ EVO_TRADE, 0, ", "{ EVO_LEVEL, %d, " % TRADE_LEVEL, m.group(0))
+        if n != 1:
+            raise SystemExit("expected one trade evolution for " + species)
+        text = text[:m.start()] + block + text[m.end():]
+    for species in ITEM_SPECIES:
+        m = species_block(text, species)
+        found = re.findall(r"\{ EVO_TRADE_ITEM, (ITEM_\w+), ", m.group(0))
+        if not found:
+            raise SystemExit("no trade-with-item evolution for " + species)
+        items.update(found)
+        block = m.group(0).replace("{ EVO_TRADE_ITEM, ", "{ EVO_STONE, ")
+        text = text[:m.start()] + block + text[m.end():]
+    open(EVOLUTIONS, "w").write(text)
+
+    text = open(ITEMS).read()
+    for item in sorted(items):
+        m = re.search(r"^\[%s\] =\n\{.*?^\}," % item, text, re.S | re.M)
+        if not m:
+            raise SystemExit("no item data for " + item)
+        block = m.group(0)
+        for old, new in (
+            (r"\.fieldUseFunc = 0,", ".fieldUseFunc = %d," % FIELD_USE_EVOLUTION),
+            (r"\.partyUse = 0,", ".partyUse = 1,"),
+            (r"\.evolve = FALSE,", ".evolve = TRUE,"),
+        ):
+            block, n = re.subn(old, new, block)
+            if n != 1:
+                raise SystemExit("unexpected item data for " + item)
+        text = text[:m.start()] + block + text[m.end():]
+    open(ITEMS, "w").write(text)
+    print("level %d: %s" % (TRADE_LEVEL, ", ".join(LEVEL_SPECIES)))
+    print("usable like a stone: " + ", ".join(sorted(items)))
+
+
+if __name__ == "__main__":
+    main()
-- 
