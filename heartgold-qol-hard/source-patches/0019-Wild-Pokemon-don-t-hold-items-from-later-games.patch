index 000000000..77d4b9eee
--- /dev/null
+++ b/tools/hack/wild_items.py
@@ -0,0 +1,44 @@
+#!/usr/bin/env python3
+"""Wild Pokemon don't hold items from later games.
+
+hg-engine gives wild Pokemon their newest games' held items, so a wild
+Drifblim can hold an Air Balloon and a wild Oddish an Absorb Bulb. For every
+Pokemon of the first four generations, a held item that is newer than
+HeartGold is removed (that slot holds nothing, as it did in HeartGold in
+nearly every case). Items that HeartGold had are left where hg-engine puts
+them.
+
+    python3 tools/hack/wild_items.py
+"""
+import re
+
+SPECIES = "data/Species.c"
+LAST_GEN_4_ITEM = 536   # Enigma Stone; everything after it is from a later game
+LAST_GEN_4_SPECIES = 493
+
+
+def main():
+    ids = lambda path, prefix: {n: int(v) for n, v in re.findall(
+        r"#define %s_(\w+)\s+\(?(\d+)\)?\s*$" % prefix, open(path).read(), re.M)}
+    items, species = ids("include/constants/item.h", "ITEM"), ids("include/constants/species.h", "SPECIES")
+    removed = []
+
+    def entry(match):
+        name = match.group(1)
+        if species.get(name, 9999) > LAST_GEN_4_SPECIES:
+            return match.group(0)
+
+        def slot(m):
+            if m.group(2) != "NONE" and items[m.group(2)] > LAST_GEN_4_ITEM:
+                removed.append((name, m.group(2)))
+                return m.group(1) + "ITEM_NONE"
+            return m.group(0)
+        return re.sub(r"(\.(?:common|rare) = )ITEM_(\w+)", slot, match.group(0))
+
+    text = re.sub(r"^    \[SPECIES_(\w+)\] = \{\n.*?^    \},\n", entry, open(SPECIES).read(), flags=re.S | re.M)
+    open(SPECIES, "w").write(text)
+    print("removed %d held items: %s" % (len(removed), ", ".join("%s (%s)" % r for r in removed)))
+
+
+if __name__ == "__main__":
+    main()
